#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_VERSION="@PKG_VERSION@"
PACKAGE_RELEASE="@PKG_RELEASE@"
ENGINE_SCHEMA_VERSION=2
CFIP_LIB_DIR="${CFIP_LIB_DIR:-/usr/libexec/cf-ip}"
CFIP_LEGACY_BIN="${CFIP_LEGACY_BIN:-/usr/bin/cf-ip-auto-legacy}"
CFIP_STATUS_DIR="${CFIP_STATUS_DIR:-/etc/cf_ip}"
CFIP_STATUS_FILE="$CFIP_STATUS_DIR/status.json"
CFIP_LOG_FILE="${CFIP_LOG_FILE:-/tmp/cf_ip/cf-ip-auto.log}"
CFIP_RUNTIME_DIR="${CFIP_RUNTIME_DIR:-/tmp/cf_ip}"
CFIP_LOCK_DIR="$CFIP_RUNTIME_DIR/cf-ip-auto-v2.lock"
CFIP_RUN_HISTORY="$CFIP_STATUS_DIR/run-history.ndjson"
CFIP_VERBOSE=false
CFIP_RUN_ID=""; CFIP_PHASE="idle"; CFIP_LAST_RESULT="unknown"; CFIP_ERROR=""; CFIP_STOPPED_MODE=""
CFIP_SKIP_STARTUP_DELAY=false

CFIP_ENABLED=false; CFIP_MODE=passwall; CFIP_IP_COUNT=4; CFIP_IP_TYPE=ipv4
CFIP_SPEEDTEST_PROTOCOL=tcp; CFIP_SPEEDTEST_CFCOLO=""; CFIP_SPEEDTEST_DN=8; CFIP_SPEEDTEST_DT=6; CFIP_SPEEDTEST_TLL=40; CFIP_SPEEDTEST_TL=""; CFIP_SPEEDTEST_THREADS=200; CFIP_SPEEDTEST_PING_COUNT=3
CFIP_STOP_SERVICE=true; CFIP_STARTUP_DELAY=""; CFIP_WORK_DIR="/usr/bin"; CFIP_CRON_INTERVAL="6h"; CFIP_CANDIDATE_BUDGET=128; CFIP_PROBE_TOP_COUNT=8; CFIP_PROBE_CONCURRENCY=4; CFIP_PROBE_TIMEOUT=5; CFIP_MEASUREMENT_TIMEOUT=60; CFIP_RECOVERY_TIMEOUT=30; CFIP_PROBE_BATCH_SIZE=4; CFIP_MAX_PROBE_COUNT=8; CFIP_EARLY_STOP_ENABLED=true
CFIP_BUILTIN_SOURCES="cloudflare-official-v4 cloudflare-official-v6"; CFIP_SOURCE_POLICY=balanced
CFIP_PUBLISH_ENABLED=false; CFIP_PUBLISH_BIND=""; CFIP_PUBLISH_PORT=12345
CFIP_PASSWALL_TARGET_DOMAIN=""; CFIP_PASSWALL_NAME_SUFFIX=" [CF-{n}]"
CFIP_OPENCLASH_CONFIG="/etc/openclash/config/config.yaml"; CFIP_OPENCLASH_TARGET_DOMAIN=""; CFIP_OPENCLASH_NAME_SUFFIX=" [CF-{n}]"; CFIP_OPENCLASH_TRANSPORT_FILTER=""; CFIP_OPENCLASH_BACKUP_COUNT=3
CFIP_GITHUB_MIRROR=""
CFIP_RILL_ENABLED=false; CFIP_RILL_MODE=shadow; CFIP_RILL_RUNTIME="/usr/bin/rill-runtime"; CFIP_RILL_STATE="$CFIP_STATUS_DIR/rill-state.json"; CFIP_RILL_TIMEOUT_S=2; CFIP_RILL_SAFE_TOP_K=3; CFIP_RILL_MIN_FEEDBACK_SAMPLES=30; CFIP_RILL_EVALUATION_MAX_AGE_SECONDS=86400; CFIP_RILL_DELAYED_FEEDBACK_SECONDS=600; CFIP_RILL_DELAYED_PROBE_TIMEOUT=5
CFIP_ADAPTIVE_MEASUREMENT_ENABLED=true; CFIP_ADAPTIVE_MEASUREMENT_MODE=shadow; CFIP_ADAPTIVE_TARGET_RATIO_PERCENT=25; CFIP_ADAPTIVE_MIN_PROBE_COUNT=8; CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT=10; CFIP_ADAPTIVE_MIN_EVIDENCE=50; CFIP_ADAPTIVE_EVIDENCE_WINDOW=100; CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS=604800; CFIP_ADAPTIVE_AUDIT_INTERVAL=20; CFIP_ADAPTIVE_MAX_PROBE_COUNT=60; CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE=8; CFIP_ADAPTIVE_NOW="$(date +%s)"; CFIP_ADAPTIVE_CONTEXT_FINGERPRINT=""
CFIP_REUSE_ENABLED=true; CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL=86400; CFIP_REUSE_VALIDATION_TIMEOUT=5; CFIP_REUSE_LOSS_LIMIT=0.25; CFIP_REUSE_TTFB_LIMIT=3000; CFIP_REUSE_TOTAL_LIMIT=5000; CFIP_REUSE_STATE_FILE="$CFIP_STATUS_DIR/reuse-policy.json"; CFIP_REUSE_DECISION_FILE=""
CFIP_MEASUREMENT_STARTED_MS=0; CFIP_MEASUREMENT_DURATION_MS=0; CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=0; CFIP_ADAPTIVE_PROBE_DURATION_MS=0

CFIP_CANDIDATES_FILE=""; CFIP_PROBED_FILE=""; CFIP_NATIVE_FILE=""; CFIP_SELECTED_FILE=""; CFIP_RILL_FILE=""; CFIP_DECISION_FILE=""; CFIP_OUTCOME_FILE=""; CFIP_TXN_RESULT_FILE=""; CFIP_REUSE_DECISION_FILE=""; CFIP_ADAPTIVE_PLAN_FILE=""; CFIP_ADAPTIVE_PROBE_INPUT_FILE=""; CFIP_ADAPTIVE_AUDIT_FILE=""
CFIP_INPUT_POOL_FILE=""; CFIP_CANDIDATE_INPUT_FILE=""; CFIP_PROBE_INPUT_FILE=""; CFIP_SOURCE_STATUS_FILE=""; CFIP_MEASUREMENT_DEADLINE=0; CFIP_MEASUREMENT_STARTED_AT=0; CFIP_RECOVERY_DEADLINE=0; CFIP_RECOVERY_STARTED_AT=0; CFIP_RECOVERY_ACTIVE=false; CFIP_RECOVERY_ERROR=""

for lib in common.sh config.sh status.sh source.sh scheduler.sh cfst.sh observe.sh adaptive-measurement.sh context-policy.sh transaction.sh openclash-transform.sh openclash-readback.sh publisher.sh rill-disabled.sh reuse.sh operational-health.sh; do
    if [[ -r "$CFIP_LIB_DIR/$lib" ]]; then source "$CFIP_LIB_DIR/$lib"; else printf '[cloudflare-ip] ERROR: missing library %s\n' "$CFIP_LIB_DIR/$lib" >&2; exit 1; fi
done
if [[ -r "$CFIP_LIB_DIR/rill.sh" ]]; then source "$CFIP_LIB_DIR/rill.sh"; fi

uci_get() {
    local key="$1" default="${2:-}" value
    if [[ -n "${CFIP_VALIDATE_CANDIDATE_JSON:-}" ]] && jq -e --arg key "$key" 'type == "object" and has($key)' <<<"$CFIP_VALIDATE_CANDIDATE_JSON" >/dev/null 2>&1; then
        value="$(jq -r --arg key "$key" 'if .[$key]|type == "array" then .[$key]|join(" ") else .[$key]|tostring end' <<<"$CFIP_VALIDATE_CANDIDATE_JSON")"
        printf '%s' "$value"
        return 0
    fi
    value="$(uci -q get "$key" 2>/dev/null || true)"
    [[ -n "$value" ]] && printf '%s' "$value" || printf '%s' "$default"
}

load_config() {
    command -v uci >/dev/null 2>&1 || { cfip_json_error "uci command not found"; return 1; }
    CFIP_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.enabled 0)")"; CFIP_MODE="$(uci_get cf_ip.main.mode passwall)"; CFIP_IP_COUNT="$(uci_get cf_ip.main.ip_count 4)"; CFIP_IP_TYPE="$(uci_get cf_ip.main.ip_type ipv4)"
    CFIP_SPEEDTEST_PROTOCOL="$(uci_get cf_ip.main.speedtest_protocol tcp)"; CFIP_SPEEDTEST_CFCOLO="$(uci_get cf_ip.main.speedtest_cfcolo '')"; CFIP_SPEEDTEST_DN="$(uci_get cf_ip.main.speedtest_dn 8)"; CFIP_SPEEDTEST_DT="$(uci_get cf_ip.main.speedtest_dt 6)"; CFIP_SPEEDTEST_TLL="$(uci_get cf_ip.main.speedtest_tll 40)"; CFIP_SPEEDTEST_TL="$(uci_get cf_ip.main.speedtest_tl '')"; CFIP_SPEEDTEST_THREADS="$(uci_get cf_ip.main.speedtest_threads 200)"; CFIP_SPEEDTEST_PING_COUNT="$(uci_get cf_ip.main.speedtest_ping_count 3)"
    CFIP_STOP_SERVICE="$(cfip_bool "$(uci_get cf_ip.main.stop_service 1)")"; CFIP_STARTUP_DELAY="$(uci_get cf_ip.main.startup_delay '')"; CFIP_WORK_DIR="$(uci_get cf_ip.main.work_dir /usr/bin)"; [[ -n "$CFIP_WORK_DIR" ]] || CFIP_WORK_DIR=/usr/bin
    CFIP_CRON_INTERVAL="$(uci_get cf_ip.main.cron_interval 6h)"; CFIP_CANDIDATE_BUDGET="$(uci_get cf_ip.main.candidate_budget 128)"; CFIP_PROBE_TOP_COUNT="$(uci_get cf_ip.main.probe_top_count "$(uci_get cf_ip.main.candidate_limit 8)")"; CFIP_PROBE_CONCURRENCY="$(uci_get cf_ip.main.probe_concurrency 4)"; CFIP_PROBE_TIMEOUT="$(uci_get cf_ip.main.probe_timeout 5)"; CFIP_MEASUREMENT_TIMEOUT="$(uci_get cf_ip.main.measurement_timeout 60)"; CFIP_RECOVERY_TIMEOUT="$(uci_get cf_ip.main.recovery_timeout 30)"; CFIP_PROBE_BATCH_SIZE="$(uci_get cf_ip.main.probe_batch_size 4)"; CFIP_MAX_PROBE_COUNT="$(uci_get cf_ip.main.max_probe_count "$CFIP_PROBE_TOP_COUNT")"; CFIP_EARLY_STOP_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.early_stop_enabled 1)")"; CFIP_ADAPTIVE_MEASUREMENT_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.adaptive_measurement_enabled 1)")"; CFIP_ADAPTIVE_MEASUREMENT_MODE="$(uci_get cf_ip.main.adaptive_measurement_mode shadow)"; CFIP_ADAPTIVE_TARGET_RATIO_PERCENT="$(uci_get cf_ip.main.adaptive_target_ratio_percent 25)"; CFIP_ADAPTIVE_MIN_PROBE_COUNT="$(uci_get cf_ip.main.adaptive_min_probe_count 8)"; CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT="$(uci_get cf_ip.main.adaptive_exploration_ratio_percent 10)"; CFIP_ADAPTIVE_MIN_EVIDENCE="$(uci_get cf_ip.main.adaptive_min_evidence 50)"; CFIP_ADAPTIVE_EVIDENCE_WINDOW="$(uci_get cf_ip.main.adaptive_evidence_window 100)"; CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS="$(uci_get cf_ip.main.adaptive_evaluation_max_age_seconds 604800)"; CFIP_ADAPTIVE_AUDIT_INTERVAL="$(uci_get cf_ip.main.adaptive_audit_interval 20)"; CFIP_ADAPTIVE_MAX_PROBE_COUNT="$(uci_get cf_ip.main.adaptive_max_probe_count 60)"; CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE="$(uci_get cf_ip.main.adaptive_expansion_batch_size 8)"; CFIP_BUILTIN_SOURCES="$(uci_get cf_ip.main.builtin_sources 'cloudflare-official-v4 cloudflare-official-v6')"; CFIP_SOURCE_POLICY="$(uci_get cf_ip.main.source_policy balanced)"; local builtin_list; builtin_list="$(uci -q show cf_ip.main.builtin_sources 2>/dev/null | sed -n "s/^cf_ip\.main\.builtin_sources='\(.*\)'$/\1/p" | tr '\n' ' ')"; [[ -n "$builtin_list" ]] && CFIP_BUILTIN_SOURCES="$builtin_list"; CFIP_GITHUB_MIRROR="$(uci_get cf_ip.main.github_mirror '')"; CFIP_VERBOSE="$(cfip_bool "$(uci_get cf_ip.main.verbose 0)")"
    CFIP_PASSWALL_TARGET_DOMAIN="$(uci_get cf_ip.passwall.target_domain '')"; CFIP_PASSWALL_NAME_SUFFIX="$(uci_get cf_ip.passwall.name_suffix ' [CF-{n}]')"
    CFIP_OPENCLASH_CONFIG="$(uci_get cf_ip.openclash.config /etc/openclash/config/config.yaml)"; CFIP_OPENCLASH_TARGET_DOMAIN="$(uci_get cf_ip.openclash.target_domain '')"; CFIP_OPENCLASH_NAME_SUFFIX="$(uci_get cf_ip.openclash.name_suffix ' [CF-{n}]')"; CFIP_OPENCLASH_TRANSPORT_FILTER="$(uci_get cf_ip.openclash.transport_filter '')"; CFIP_OPENCLASH_BACKUP_COUNT="$(uci_get cf_ip.openclash.backup_count 3)"
    CFIP_PUBLISH_ENABLED="$(cfip_bool "$(uci_get cf_ip.lan.enabled 0)")"; CFIP_PUBLISH_BIND="$(uci_get cf_ip.lan.bind_address '')"; CFIP_PUBLISH_PORT="$(uci_get cf_ip.lan.port 12345)"
    CFIP_RILL_ENABLED="$(cfip_bool "$(uci_get cf_ip.rill.enabled 0)")"; CFIP_RILL_MODE="$(uci_get cf_ip.rill.mode shadow)"; CFIP_RILL_RUNTIME="$(uci_get cf_ip.rill.runtime /usr/bin/rill-runtime)"; CFIP_RILL_STATE="$(uci_get cf_ip.rill.state_file "$CFIP_STATUS_DIR/rill-state.json")"; CFIP_RILL_SAFE_TOP_K="$(uci_get cf_ip.rill.safe_top_k 3)"; CFIP_RILL_MIN_FEEDBACK_SAMPLES="$(uci_get cf_ip.rill.min_feedback_samples 30)"; CFIP_RILL_EVALUATION_MAX_AGE_SECONDS="$(uci_get cf_ip.rill.evaluation_max_age_seconds 86400)"; local delayed_minutes; delayed_minutes="$(uci_get cf_ip.rill.delayed_feedback_minutes 10)"; [[ "$delayed_minutes" =~ ^[1-9][0-9]*$ ]] || delayed_minutes=10; CFIP_RILL_DELAYED_FEEDBACK_SECONDS="$((delayed_minutes*60))"
    CFIP_REUSE_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.reuse_enabled 1)")"; CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL="$(uci_get cf_ip.main.max_full_optimize_interval 86400)"; CFIP_REUSE_VALIDATION_TIMEOUT="$(uci_get cf_ip.main.reuse_validation_timeout 5)"; CFIP_REUSE_LOSS_LIMIT="$(uci_get cf_ip.main.reuse_loss_limit 0.25)"; CFIP_REUSE_TTFB_LIMIT="$(uci_get cf_ip.main.reuse_ttfb_limit 3000)"; CFIP_REUSE_TOTAL_LIMIT="$(uci_get cf_ip.main.reuse_total_limit 5000)"; CFIP_REUSE_STATE_FILE="$CFIP_STATUS_DIR/reuse-policy.json"
    cfip_operational_apply_guardrails || true
    local timeout_ms; timeout_ms="$(uci_get cf_ip.rill.timeout_ms 2000)"; [[ "$timeout_ms" =~ ^[0-9]+$ ]] && ((timeout_ms>0)) && CFIP_RILL_TIMEOUT_S=$(((timeout_ms+999)/1000)) || CFIP_RILL_TIMEOUT_S=2
    if [[ "$CFIP_IP_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_PROBE_TOP_COUNT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_TOP_COUNT < CFIP_IP_COUNT)); then CFIP_PROBE_TOP_COUNT="$CFIP_IP_COUNT"; fi
    validate_config || return $?
    if declare -F cfip_rill_context_guard >/dev/null 2>&1; then
        cfip_rill_context_guard || { cfip_json_error "failed to establish Rill learning context"; return 1; }
    fi
}

validate_config() {
    [[ "$CFIP_MODE" == passwall || "$CFIP_MODE" == openclash ]] || { cfip_json_error "invalid mode"; return 1; }
    [[ "$CFIP_IP_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_CANDIDATE_BUDGET" =~ ^[1-9][0-9]*$ && "$CFIP_PROBE_TOP_COUNT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid candidate count"; return 1; }
    ((CFIP_CANDIDATE_BUDGET >= 100 && CFIP_CANDIDATE_BUDGET <= 512)) || { cfip_json_error "candidate_budget must be 100..512"; return 1; }
    ((CFIP_PROBE_TOP_COUNT >= CFIP_IP_COUNT && CFIP_PROBE_TOP_COUNT <= 32 && CFIP_PROBE_TOP_COUNT <= CFIP_CANDIDATE_BUDGET)) || { cfip_json_error "probe_top_count must be between ip_count and min(32,candidate_budget)"; return 1; }
    [[ "$CFIP_PROBE_CONCURRENCY" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_CONCURRENCY<=16)) || { cfip_json_error "probe_concurrency must be 1..16"; return 1; }
    [[ "$CFIP_PROBE_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_BATCH_SIZE<=16)) || { cfip_json_error "probe_batch_size must be 1..16"; return 1; }
    [[ "$CFIP_MAX_PROBE_COUNT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_MAX_PROBE_COUNT>=CFIP_IP_COUNT && CFIP_MAX_PROBE_COUNT<=CFIP_PROBE_TOP_COUNT)) || { cfip_json_error "max_probe_count must be between ip_count and probe_top_count"; return 1; }
    [[ "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == off || "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == shadow || "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == guarded ]] || { cfip_json_error "invalid adaptive_measurement_mode"; return 1; }
    [[ "$CFIP_ADAPTIVE_TARGET_RATIO_PERCENT" =~ ^[0-9]+$ ]] && ((CFIP_ADAPTIVE_TARGET_RATIO_PERCENT>=1 && CFIP_ADAPTIVE_TARGET_RATIO_PERCENT<=100)) || { cfip_json_error "adaptive_target_ratio_percent must be 1..100"; return 1; }
    [[ "$CFIP_ADAPTIVE_MIN_PROBE_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_MAX_PROBE_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid adaptive probe bounds"; return 1; }
    ((CFIP_ADAPTIVE_MIN_PROBE_COUNT>=CFIP_IP_COUNT && CFIP_ADAPTIVE_MAX_PROBE_COUNT>=CFIP_ADAPTIVE_MIN_PROBE_COUNT && CFIP_ADAPTIVE_MAX_PROBE_COUNT<=CFIP_CANDIDATE_BUDGET && CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE<=32)) || { cfip_json_error "adaptive probe bounds are unsafe"; return 1; }
    [[ "$CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT" =~ ^[0-9]+$ && "$CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT" -le 50 ]] || { cfip_json_error "adaptive_exploration_ratio_percent must be 0..50"; return 1; }
    [[ "$CFIP_ADAPTIVE_MIN_EVIDENCE" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_EVIDENCE_WINDOW" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid adaptive evidence bounds"; return 1; }
    ((CFIP_ADAPTIVE_MIN_EVIDENCE<=CFIP_ADAPTIVE_EVIDENCE_WINDOW && CFIP_ADAPTIVE_EVIDENCE_WINDOW<=100 && CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS>=3600 && CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS<=2592000 && CFIP_ADAPTIVE_AUDIT_INTERVAL>=1 && CFIP_ADAPTIVE_AUDIT_INTERVAL<=1000)) || { cfip_json_error "adaptive evidence or audit bounds are unsafe"; return 1; }
    [[ "$CFIP_PROBE_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_TIMEOUT<=30)) || { cfip_json_error "probe_timeout must be 1..30"; return 1; }
    [[ "$CFIP_MEASUREMENT_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_MEASUREMENT_TIMEOUT>=20 && CFIP_MEASUREMENT_TIMEOUT<=300)) || { cfip_json_error "measurement_timeout must be 20..300"; return 1; }
    [[ "$CFIP_RECOVERY_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RECOVERY_TIMEOUT>=10 && CFIP_RECOVERY_TIMEOUT<=120)) || { cfip_json_error "recovery_timeout must be 10..120"; return 1; }
    [[ "$CFIP_SPEEDTEST_DN" =~ ^[0-9]+$ && "$CFIP_SPEEDTEST_DT" =~ ^[1-9][0-9]*$ && "$CFIP_SPEEDTEST_THREADS" =~ ^[1-9][0-9]*$ && "$CFIP_SPEEDTEST_PING_COUNT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid CFST limits"; return 1; }
    ((CFIP_SPEEDTEST_DN<=100 && CFIP_SPEEDTEST_DT<=60 && CFIP_SPEEDTEST_THREADS<=1000 && CFIP_SPEEDTEST_PING_COUNT<=20)) || { cfip_json_error "CFST limits out of range"; return 1; }
    [[ "$CFIP_IP_TYPE" == ipv4 || "$CFIP_IP_TYPE" == ipv6 || "$CFIP_IP_TYPE" == both ]] || { cfip_json_error "invalid ip_type"; return 1; }
    [[ "$CFIP_SPEEDTEST_PROTOCOL" == tcp || "$CFIP_SPEEDTEST_PROTOCOL" == http ]] || { cfip_json_error "invalid speedtest_protocol"; return 1; }
    [[ "$CFIP_RILL_MODE" == off || "$CFIP_RILL_MODE" == shadow || "$CFIP_RILL_MODE" == assisted ]] || { cfip_json_error "invalid rill mode"; return 1; }
    [[ "$CFIP_RILL_SAFE_TOP_K" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_SAFE_TOP_K<=8)) || { cfip_json_error "safe_top_k must be 1..8"; return 1; }
    [[ "$CFIP_RILL_MIN_FEEDBACK_SAMPLES" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_MIN_FEEDBACK_SAMPLES<=200)) || { cfip_json_error "min_feedback_samples must be 1..200"; return 1; }
    [[ "$CFIP_RILL_EVALUATION_MAX_AGE_SECONDS" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_EVALUATION_MAX_AGE_SECONDS<=604800)) || { cfip_json_error "evaluation_max_age_seconds must be 1..604800"; return 1; }
    cfip_source_policy_valid "$CFIP_SOURCE_POLICY" || { cfip_json_error "invalid source_policy"; return 1; }
    ((CFIP_RILL_DELAYED_FEEDBACK_SECONDS>=60 && CFIP_RILL_DELAYED_FEEDBACK_SECONDS<=86400)) || { cfip_json_error "delayed_feedback_minutes must be 1..1440"; return 1; }
    [[ "$CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL" =~ ^[1-9][0-9]*$ ]] && ((CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL>=300 && CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL<=604800)) || { cfip_json_error "max_full_optimize_interval must be 300..604800"; return 1; }
    [[ "$CFIP_REUSE_VALIDATION_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_REUSE_VALIDATION_TIMEOUT<=30)) || { cfip_json_error "reuse_validation_timeout must be 1..30"; return 1; }
    [[ "$CFIP_REUSE_LOSS_LIMIT" =~ ^0([.][0-9]+)?$|^1([.]0+)?$ ]] || { cfip_json_error "reuse_loss_limit must be 0..1"; return 1; }
    [[ "$CFIP_REUSE_TTFB_LIMIT" =~ ^[1-9][0-9]*$ && "$CFIP_REUSE_TOTAL_LIMIT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "reuse latency limits must be positive"; return 1; }
    [[ "$CFIP_PUBLISH_PORT" =~ ^[0-9]+$ ]] && ((CFIP_PUBLISH_PORT>=1024 && CFIP_PUBLISH_PORT<=65535)) || { cfip_json_error "LAN publisher port must be 1024..65535"; return 1; }
    [[ -z "$CFIP_PUBLISH_BIND" || "$CFIP_PUBLISH_BIND" != 0.0.0.0 ]] || { cfip_json_error "LAN publisher may not bind 0.0.0.0"; return 1; }
    local schedule="$CFIP_CRON_INTERVAL" custom_schedule=""
    if [[ "$schedule" == custom ]]; then
        custom_schedule="$(uci_get cf_ip.main.cron_custom '')"
        [[ -n "$custom_schedule" ]] || { cfip_json_error "custom cron schedule is empty"; return 1; }
        schedule="$custom_schedule"
    fi
    to_cron "$schedule" >/dev/null || { cfip_json_error "invalid cron schedule"; return 1; }
    if [[ -n "$CFIP_GITHUB_MIRROR" ]]; then cfip_https_url_or_empty "$CFIP_GITHUB_MIRROR" || { cfip_json_error "github_mirror must use https"; return 1; }; [[ "$CFIP_GITHUB_MIRROR" == */ ]] || { cfip_json_error "github_mirror must end with /"; return 1; }; fi
    case "$CFIP_MODE" in
      passwall) CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_PASSWALL_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty PassWall target_domain"; return 1; } ;;
      openclash) [[ -f "$CFIP_OPENCLASH_CONFIG" ]] || { cfip_json_error "OpenClash config not found"; return 1; }; CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty OpenClash target_domain"; return 1; } ;;
    esac
}

acquire_lock() {
    mkdir -p "$CFIP_RUNTIME_DIR"
    if mkdir "$CFIP_LOCK_DIR" 2>/dev/null; then printf '%s\n' "$$" >"$CFIP_LOCK_DIR/pid"; return 0; fi
    local pid=""; [[ -f "$CFIP_LOCK_DIR/pid" ]] && pid="$(cat "$CFIP_LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$CFIP_LOCK_DIR"; mkdir "$CFIP_LOCK_DIR" && printf '%s\n' "$$" >"$CFIP_LOCK_DIR/pid"; return 0; fi
    return 1
}
release_lock(){ rm -rf "$CFIP_LOCK_DIR" 2>/dev/null || true; }

init_run_paths(){ CFIP_RUN_ID="$(cfip_generate_run_id)"; local d="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID"; mkdir -p "$d"; CFIP_INPUT_POOL_FILE="$d/input-pool.json"; CFIP_CANDIDATE_INPUT_FILE="$d/cfst-input.txt"; CFIP_PROBE_INPUT_FILE="$d/probe-input.json"; CFIP_SOURCE_STATUS_FILE="$CFIP_RUNTIME_DIR/source-status.json"; CFIP_CANDIDATES_FILE="$d/candidates.json"; CFIP_PROBED_FILE="$d/probed.json"; CFIP_NATIVE_FILE="$d/native.json"; CFIP_SELECTED_FILE="$d/selected.json"; CFIP_RILL_FILE="$d/rill.json"; CFIP_DECISION_FILE="$d/decision.json"; CFIP_OUTCOME_FILE="$d/outcome.json"; CFIP_TXN_RESULT_FILE="$d/transaction.json"; CFIP_PROBE_METRICS_FILE="$d/probe-metrics.json"; CFIP_REUSE_DECISION_FILE="$d/reuse-decision.json"; CFIP_ADAPTIVE_PLAN_FILE="$d/adaptive-plan.json"; CFIP_ADAPTIVE_PROBE_INPUT_FILE="$d/adaptive-probe-input.json"; CFIP_ADAPTIVE_AUDIT_FILE="$d/adaptive-audit.json"; }
cleanup_run_files(){ find "$CFIP_RUNTIME_DIR" -maxdepth 1 -type d -name 'run-*' -mmin +120 -exec rm -rf {} + 2>/dev/null || true; }

write_status() {
    local active_run="$1" phase="$2" result="$3" error="${4:-}" candidates=0 input_count=0 eligible=0 selected=0 best='[]' rill='{}' adaptive='{}' transaction='{}' sources='[]' publisher='{}' decision='{}' probe_metrics='{}' source_policy='{}' reuse='{}' context='{}' evidence_aggregate='{}' operational='{}' why='' previous='{}' last_completed='' status_now completed_at=''
    [[ -f "$CFIP_CANDIDATES_FILE" ]] && candidates="$(jq 'length' "$CFIP_CANDIDATES_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_INPUT_POOL_FILE" ]] && input_count="$(jq 'length' "$CFIP_INPUT_POOL_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_NATIVE_FILE" ]] && eligible="$(jq 'length' "$CFIP_NATIVE_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_SELECTED_FILE" ]] && selected="$(jq 'length' "$CFIP_SELECTED_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_SELECTED_FILE" ]] && best="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE" 2>/dev/null || printf '[]')"
    [[ -f "$CFIP_SOURCE_STATUS_FILE" ]] && sources="$(cat "$CFIP_SOURCE_STATUS_FILE" 2>/dev/null || printf '[]')"
    rill="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    adaptive="$(cfip_adaptive_status_json 2>/dev/null || printf '{"available":false,"effectiveMode":"shadow","qualificationState":"insufficient"}')"
    publisher="$(cfip_publisher_status_json 2>/dev/null || printf '{"success":false,"state":"error"}')"
    [[ -f "$CFIP_TXN_RESULT_FILE" ]] && transaction="$(cat "$CFIP_TXN_RESULT_FILE")"
    [[ -f "$CFIP_DECISION_FILE" ]] && decision="$(jq -c . "$CFIP_DECISION_FILE" 2>/dev/null || printf '{}')"
    [[ -f "${CFIP_PROBE_METRICS_FILE:-}" ]] && probe_metrics="$(jq -c . "$CFIP_PROBE_METRICS_FILE" 2>/dev/null || printf '{}')"
    source_policy="$(cfip_source_policy_json 2>/dev/null || printf '{}')"
    [[ -f "${CFIP_REUSE_DECISION_FILE:-}" ]] && reuse="$(jq -c . "$CFIP_REUSE_DECISION_FILE" 2>/dev/null || printf '{}')"
    operational="$(cfip_operational_state_json 2>/dev/null || printf '{}')"
    why="$(cfip_operational_why_run 2>/dev/null || printf '')"
    if declare -F cfip_rill_context_json >/dev/null 2>&1; then context="$(cfip_rill_context_json 2>/dev/null || printf '{}')"; fi
    if declare -F cfip_rill_evidence_aggregate_json >/dev/null 2>&1; then evidence_aggregate="$(cfip_rill_evidence_aggregate_json 2>/dev/null || printf '{}')"; fi
    status_now="$(date +%s)"
    [[ -s "$CFIP_STATUS_FILE" ]] && previous="$(jq -c 'if type=="object" then . else {} end' "$CFIP_STATUS_FILE" 2>/dev/null || printf '{}')"
    last_completed="$(jq -r '.last_completed_run_at // .last_run // empty' <<<"$previous" 2>/dev/null || true)"
    completed_at="$last_completed"
    if [[ "$active_run" == false && ("$phase" == done || "$phase" == failed) ]]; then completed_at="$(date -u -r "$status_now" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%dT%H:%M:%SZ')"; fi
    mkdir -p "$CFIP_STATUS_DIR"
    local tar_ok=false jq_ok=false cfst_ok=false cfst_version="" passwall_installed=false passwall_running=false openclash_installed=false openclash_running=false
    command -v tar >/dev/null 2>&1 && tar_ok=true
    command -v jq >/dev/null 2>&1 && jq_ok=true
    [[ -x "$CFIP_WORK_DIR/cfst/cfst" ]] && cfst_ok=true
    cfst_version="$(cfip_cfst_version "$CFIP_WORK_DIR/cfst/cfst" 2>/dev/null || true)"
    [[ -x "$CFIP_INIT_DIR/passwall" ]] && passwall_installed=true
    [[ "$passwall_installed" == true ]] && cfip_service_running passwall status && passwall_running=true
    [[ -x "$CFIP_INIT_DIR/openclash" ]] && openclash_installed=true
    [[ "$openclash_installed" == true ]] && cfip_service_running openclash status && openclash_running=true
    local recovery_remaining recovery_active
    recovery_remaining="$(cfip_recovery_remaining)"
    [[ "${CFIP_RECOVERY_ACTIVE:-false}" == true ]] && recovery_active=true || recovery_active=false
    jq -n --argjson schemaVersion "$ENGINE_SCHEMA_VERSION" --argjson activeRun "$active_run" --argjson enabled "$CFIP_ENABLED" --arg runId "$CFIP_RUN_ID" --arg phase "$phase" --arg lastResult "$result" --arg error "$error" --arg mode "$CFIP_MODE" --arg ipType "$CFIP_IP_TYPE" --arg protocol "$CFIP_SPEEDTEST_PROTOCOL" --arg version "$SCRIPT_VERSION" --arg cfstVersion "$cfst_version" --argjson requested "$CFIP_IP_COUNT" --argjson candidates "$candidates" --argjson inputCount "$input_count" --argjson budget "$CFIP_CANDIDATE_BUDGET" --argjson eligible "$eligible" --argjson selected "$selected" --argjson best "$best" --argjson intelligence "$rill" --argjson adaptive "$adaptive" --argjson transaction "$transaction" --argjson sources "$sources" --argjson publisher "$publisher" --argjson decision "$decision" --argjson probeMetrics "$probe_metrics" --argjson sourcePolicy "$source_policy" --argjson context "$context" --argjson evidenceAggregate "$evidence_aggregate" --argjson operational "$operational" --arg why "$why" --argjson tar "$tar_ok" --argjson jq "$jq_ok" --argjson cfst "$cfst_ok" --argjson pi "$passwall_installed" --argjson pr "$passwall_running" --argjson oi "$openclash_installed" --argjson or "$openclash_running" --argjson recoveryRemaining "$recovery_remaining" --argjson recoveryActive "$recovery_active" --arg recoveryError "${CFIP_RECOVERY_ERROR:-}" --arg statusUpdatedAt "$(date -u -r "$status_now" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg lastCompleted "$completed_at" '
      {schemaVersion:$schemaVersion,running:$enabled,enabled:$enabled,active_run:$activeRun,runId:$runId,phase:$phase,last_result:$lastResult,error:$error,mode:$mode,ip_type:$ipType,ip_count:$selected,requested_ip_count:$requested,speedtest_protocol:$protocol,best_ips:$best,script_version:$version,cfst_version:(if $cfstVersion=="" then null else $cfstVersion end),candidate_budget:$budget,measurement_input_count:$inputCount,candidate_count:$candidates,eligible_count:$eligible,degraded_candidate_count:($selected<$requested),probeMetrics:$probeMetrics,efficiency:$probeMetrics,sourcePolicy:$sourcePolicy,learningContext:$context,evidenceAggregate:$evidenceAggregate,adaptiveMeasurement:$adaptive,operationalHealth:$operational,whyThisRun:(if $why=="" then null else $why end),tar:$tar,jq:$jq,cfst_installed:$cfst,passwall_installed:$pi,passwall_running:$pr,openclash_installed:$oi,openclash_running:$or,env:{tar:$tar,jq:$jq,cfst_installed:$cfst,passwall_installed:$pi,passwall_running:$pr,openclash_installed:$oi,openclash_running:$or},sources:$sources,publisher:$publisher,intelligence:$intelligence,decision:$decision,confidenceLevel:($decision.confidenceLevel // null),confidenceReasons:($decision.confidenceReasons // []),requestedMode:($decision.requestedMode // null),effectiveMode:($decision.effectiveMode // null),fallbackReason:($decision.fallbackReason // null),authorityActionId:($decision.authorityActionId // null),nativeRillTop1Agreement:($decision.nativeRillTop1Agreement // null),rillTop3Overlap:($decision.rillTop3Overlap // null),transaction:$transaction,recovery:{active:$recoveryActive,remaining:$recoveryRemaining,error:(if $recoveryError=="" then null else $recoveryError end)},status_updated_at:$statusUpdatedAt,last_completed_run_at:(if $lastCompleted=="" then null else $lastCompleted end),last_run:(if $lastCompleted=="" then null else $lastCompleted end)}' | cfip_atomic_write "$CFIP_STATUS_FILE"
    if [[ -s "${CFIP_REUSE_DECISION_FILE:-}" && -s "$CFIP_STATUS_FILE" ]]; then
        jq --slurpfile reuse "$CFIP_REUSE_DECISION_FILE" '. + {reusePolicy: ($reuse[0] // {})}' "$CFIP_STATUS_FILE" | cfip_atomic_write "$CFIP_STATUS_FILE"
    fi
}

remember_history(){
    [[ -n "$CFIP_RUN_ID" ]] || return 0
    mkdir -p "$CFIP_STATUS_DIR"
    local metrics='{}' adaptive='{}' decision='{}' qualification='{}' transaction='{}' audit='{}' best='[]' context='' planned='null' actual='null' full='null' expansion='null' fallback='null' audit_run=false transaction_applied='null' adaptive_effective='' candidate_effective=''
    [[ -s "${CFIP_PROBE_METRICS_FILE:-}" ]] && metrics="$(jq -c . "$CFIP_PROBE_METRICS_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_ADAPTIVE_STATE_FILE:-}" ]] && adaptive="$(jq -c . "$CFIP_ADAPTIVE_STATE_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_DECISION_FILE:-}" ]] && decision="$(jq -c . "$CFIP_DECISION_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_TXN_RESULT_FILE:-}" ]] && transaction="$(jq -c . "$CFIP_TXN_RESULT_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] && audit="$(jq -c . "$CFIP_ADAPTIVE_AUDIT_FILE" 2>/dev/null || printf '{}')"
    declare -F cfip_rill_qualification_json >/dev/null 2>&1 && qualification="$(cfip_rill_qualification_json 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_SELECTED_FILE:-}" ]] && best="$(jq -c '[.[].ip]' "$CFIP_SELECTED_FILE" 2>/dev/null || printf '[]')"
    adaptive_effective="$(jq -r '.effectiveAdaptiveMode // empty' <<<"$metrics")"; [[ -n "$adaptive_effective" ]] || adaptive_effective="${CFIP_ADAPTIVE_EFFECTIVE_MODE:-}"
    candidate_effective="$(jq -r '.effectiveMode // empty' <<<"$decision")"
    context="${CFIP_ADAPTIVE_CONTEXT_FINGERPRINT:-$(jq -r '.contextFingerprint // .lastContextFingerprint // empty' <<<"$adaptive" 2>/dev/null || true)}"
    planned="$(jq -r '.plannedK // .selectedK // "null"' <<<"$metrics")"
    actual="$(jq -r '.actualUniqueProbeCount // "null"' <<<"$metrics")"
    full="$(jq -r '.fullCandidateCount // "null"' <<<"$metrics")"
    expansion="$(jq -r '.expansionCount // "null"' <<<"$metrics")"
    fallback="$(jq -r '.fallbackUsed // "null"' <<<"$metrics")"
    audit_run="$(jq -r '.auditRun // false' <<<"$metrics")"
    transaction_applied="$(jq -r 'if has("success") then (.success == true) else "null" end' <<<"$transaction")"
    jq -cn --arg runId "$CFIP_RUN_ID" --arg result "$CFIP_LAST_RESULT" --arg mode "$CFIP_MODE" --arg policy "${CFIP_SOURCE_POLICY_EFFECTIVE:-${CFIP_SOURCE_POLICY:-balanced}}" --arg adaptiveRequestedMode "${CFIP_ADAPTIVE_MEASUREMENT_MODE:-}" --arg adaptiveEffectiveMode "$adaptive_effective" --arg adaptiveQualificationState "$(jq -r '.qualificationState // "null"' <<<"$adaptive")" --arg candidateRequestedMode "${CFIP_RILL_MODE:-}" --arg candidateEffectiveMode "$candidate_effective" --arg candidateQualificationState "$(jq -r '.state // .qualificationState // "null"' <<<"$qualification")" --arg contextFingerprint "$context" --argjson best "$best" --argjson plannedK "$planned" --argjson actualUniqueProbeCount "$actual" --argjson fullCandidateCount "$full" --argjson expansionCount "$expansion" --argjson fallbackUsed "$fallback" --argjson auditRun "$audit_run" --argjson transactionApplied "$transaction_applied" --argjson audit "$audit" --argjson measurementDurationMs "$(jq -r '.measurementDurationMs // "null"' <<<"$metrics")" --argjson probeDurationMs "$(jq -r '.probeDurationMs // "null"' <<<"$metrics")" '{schemaVersion:1,time:now,runId:$runId,result:$result,mode:$mode,sourcePolicy:$policy,bestIps:$best,proxyMode:$mode,adaptiveMode:(if $adaptiveEffectiveMode=="" then null else $adaptiveEffectiveMode end),candidateMode:(if $candidateEffectiveMode=="" then null else $candidateEffectiveMode end),adaptiveRequestedMode:(if $adaptiveRequestedMode=="" then null else $adaptiveRequestedMode end),candidateRequestedMode:(if $candidateRequestedMode=="" then null else $candidateRequestedMode end),adaptiveQualificationState:(if $adaptiveQualificationState=="null" then null else $adaptiveQualificationState end),candidateQualificationState:(if $candidateQualificationState=="null" then null else $candidateQualificationState end),contextFingerprint:(if $contextFingerprint=="" then null else $contextFingerprint end),fullCandidateCount:$fullCandidateCount,plannedK:$plannedK,actualUniqueProbeCount:$actualUniqueProbeCount,fallbackUsed:$fallbackUsed,expansionCount:$expansionCount,measurementDurationMs:$measurementDurationMs,transactionApplied:$transactionApplied,auditRun:$auditRun,winnerRecall:($audit.winnerRecall // null),topNRecall:($audit.topNRecall // null),severeMiss:($audit.severeMiss // null)}' >>"$CFIP_RUN_HISTORY"
    tail -n 100 "$CFIP_RUN_HISTORY" >"$CFIP_RUN_HISTORY.tmp" 2>/dev/null && mv "$CFIP_RUN_HISTORY.tmp" "$CFIP_RUN_HISTORY" || true
    declare -F cfip_operational_record_run >/dev/null 2>&1 && cfip_operational_record_run || true
}

apply_startup_delay(){ local d="$CFIP_STARTUP_DELAY"; [[ "${CFIP_SKIP_STARTUP_DELAY:-false}" == true ]] && return 0; [[ -z "$d" || "$d" == 0 ]] && return 0; [[ "$d" == random ]] && d=300; [[ "$d" =~ ^[0-9]+$ ]] || return 1; ((d>0)) && sleep $((RANDOM%(d+1))); }

ensure_cfst(){ [[ -x "$CFIP_WORK_DIR/cfst/cfst" ]] && return 0; [[ -x "$CFIP_LEGACY_BIN" ]] || return 1; WORK_DIR_OVERRIDE="$CFIP_WORK_DIR" "$CFIP_LEGACY_BIN" --download-cfst >/dev/null; }

run_cfst() {
    local cfst="$CFIP_WORK_DIR/cfst/cfst" out="$CFIP_RUNTIME_DIR/cfst-$CFIP_RUN_ID.csv" remaining rc=0
    local -a args
    [[ -x "$cfst" && -s "$CFIP_CANDIDATE_INPUT_FILE" ]] || return 1
    cfip_cfst_invocation_record
    args=(-f "$CFIP_CANDIDATE_INPUT_FILE" -n "$CFIP_SPEEDTEST_THREADS" -t "$CFIP_SPEEDTEST_PING_COUNT" -dn "$CFIP_SPEEDTEST_DN" -dt "$CFIP_SPEEDTEST_DT" -tll "$CFIP_SPEEDTEST_TLL")
    if [[ "$CFIP_SPEEDTEST_PROTOCOL" == http ]]; then
        args+=(-httping)
        [[ -n "$CFIP_SPEEDTEST_CFCOLO" ]] && args+=(-cfcolo "$CFIP_SPEEDTEST_CFCOLO")
    fi
    [[ -n "$CFIP_SPEEDTEST_TL" ]] && args+=(-tl "$CFIP_SPEEDTEST_TL")
    args+=(-o "$out")
    remaining="$(cfip_deadline_remaining)"; ((remaining>0)) || return 124
    cfip_run_with_timeout "$remaining" "$cfst" "${args[@]}" >/dev/null 2>&1 || rc=$?
    ((rc==124)) && return 124
    [[ -s "$out" ]] || return 2
    cfip_parse_cfst "$CFIP_CANDIDATES_FILE" "$CFIP_SPEEDTEST_PROTOCOL" "$CFIP_PROBE_TOP_COUNT" "$out:auto"
}

stop_service_for_measurement(){ [[ "$CFIP_STOP_SERVICE" == true ]] || return 0; if cfip_service_running "$CFIP_MODE" measurement; then CFIP_STOPPED_MODE="$CFIP_MODE"; cfip_stop_service "$CFIP_MODE" || return 1; fi; }
restore_stopped_service_if_needed(){
    [[ -n "$CFIP_STOPPED_MODE" ]] || return 0
    cfip_begin_recovery
    local service="$CFIP_STOPPED_MODE" rc=0
    cfip_restart_service "$service" recovery || rc=$?
    if ((rc==0)); then
        CFIP_STOPPED_MODE=""
    elif ((rc==124)); then
        CFIP_RECOVERY_ERROR="RecoveryTimeout"
    else
        CFIP_RECOVERY_ERROR="RecoveryRestartFailed"
    fi
    return "$rc"
}

build_decision() {
    local effective="$CFIP_RILL_MODE" reason="" rill_candidates='[]' generation=null decision_id='' selected_action_id='' rill_selected_action_id='' authority_id='' native_order selected_order rill_order safe_count=0 agreement=false top3_overlap=0 confidence_level=low confidence_reasons='[]'
    [[ "$CFIP_RILL_ENABLED" == true ]] || effective=off
    if [[ -s "$CFIP_RILL_FILE" ]] && jq -e '.success==true' "$CFIP_RILL_FILE" >/dev/null 2>&1; then
        rill_candidates="$(jq '.candidates' "$CFIP_RILL_FILE")"
        generation="$(jq '.generation//null' "$CFIP_RILL_FILE")"
        decision_id="$(jq -r '.decisionId // empty' "$CFIP_RILL_FILE")"
        rill_selected_action_id="$(jq -r '.selectedActionId // empty' "$CFIP_RILL_FILE")"
    else
        [[ "$effective" != off ]] && reason="${reason:-rill_unavailable_or_error}"
    fi
    if [[ "$effective" == assisted ]] && ! cfip_rill_qualified; then effective=shadow; reason="${reason:-assisted_not_qualified}"; fi
    if [[ "$effective" == assisted ]] && ! cfip_rill_assisted_ready; then
        local runtime_status
        runtime_status="$(cfip_rill_status_json 2>/dev/null || printf '{}')"
        effective=shadow
        if [[ "$(jq -r '.resourcePressure // false' <<<"$runtime_status")" == true ]]; then reason="${reason:-runtime_resource_pressure}"
        elif [[ "$(jq -r '.available // false' <<<"$runtime_status")" != true ]]; then reason="${reason:-runtime_unavailable}"
        elif [[ "$(jq -r '.healthHealthy // false' <<<"$runtime_status")" != true ]]; then reason="${reason:-runtime_unhealthy}"
        else reason="${reason:-runtime_health_or_generation_gate}"; fi
    fi
    native_order="$(jq '[.[].ip]' "$CFIP_NATIVE_FILE")"
    selected_order="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")"
    authority_id="$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")"
    rill_order="$(jq -c '[.[]|select(.rillRank != null)|.ip]' <<<"$rill_candidates" 2>/dev/null || printf '[]')"
    safe_count="$(jq -r --argjson k "$CFIP_RILL_SAFE_TOP_K" '.[0:$k]|length' "$CFIP_NATIVE_FILE")"
    [[ "$(jq -r '.[0] // empty' <<<"$native_order")" == "$(jq -r '.[0] // empty' <<<"$rill_order")" ]] && agreement=true
    top3_overlap="$(jq -cn --argjson native "$native_order" --argjson rill "$rill_order" '([ $native[0:3][] ] | unique) as $n | ([ $rill[0:3][] ] | unique) as $r | ([$n[] as $x | select($r|index($x))] | length)' 2>/dev/null || printf 0)"
    if [[ "$effective" == assisted ]]; then
        selected_action_id="$authority_id"
    else
        selected_action_id="$rill_selected_action_id"
    fi
    # Native selection remains the safety boundary. If a caller ever invokes
    # this function after a partial Candidate mutation, a failed health,
    # qualification, or resource gate still restores the transaction input to
    # the Native selection before the immutable decision is written.
    if [[ "$effective" != assisted ]]; then
        jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        selected_order="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")"
        authority_id="$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")"
    fi
    if [[ "$effective" == assisted ]]; then
        confidence_level=high; confidence_reasons='["qualification_valid","runtime_healthy","inside_native_safe_envelope","context_current"]'
    elif [[ "$effective" == shadow ]]; then
        confidence_level=medium; confidence_reasons='["native_authority","candidate_observation_only"]'
        [[ -n "$reason" ]] && confidence_reasons="$(jq -cn --arg reason "$reason" '["native_authority",$reason]')"
    else
        confidence_level=low; confidence_reasons='["native_authority"]'
    fi
    jq -n --arg runId "$CFIP_RUN_ID" --arg requestedMode "$CFIP_RILL_MODE" --arg effectiveMode "$effective" --arg reason "$reason" --arg decisionId "$decision_id" --arg selectedActionId "$selected_action_id" --arg rillSelectedActionId "$rill_selected_action_id" --arg authorityActionId "$authority_id" --arg confidenceLevel "$confidence_level" --argjson confidenceReasons "$confidence_reasons" --argjson nativeOrder "$native_order" --argjson selectedOrder "$selected_order" --argjson rillOrder "$rill_order" --argjson generation "$generation" --argjson safeCount "$safe_count" --argjson agreement "$agreement" --argjson top3Overlap "$top3_overlap" '{schemaVersion:2,runId:$runId,decisionId:(if $decisionId=="" then null else $decisionId end),selectedActionId:(if $selectedActionId=="" then null else $selectedActionId end),rillSelectedActionId:(if $rillSelectedActionId=="" then null else $rillSelectedActionId end),authorityActionId:(if $authorityActionId=="" then null else $authorityActionId end),requestedMode:$requestedMode,effectiveMode:$effectiveMode,fallbackReason:(if $reason=="" then null else $reason end),generation:$generation,rillOrder:$rillOrder,nativeOrder:$nativeOrder,selectedOrder:$selectedOrder,safeEnvelopeSize:$safeCount,nativeRillTop1Agreement:$agreement,rillTop3Overlap:$top3Overlap,confidenceLevel:$confidenceLevel,confidenceReasons:$confidenceReasons,shadowInvariant:($effectiveMode!="shadow" or $selectedOrder==($nativeOrder[0:($selectedOrder|length)]))}' | cfip_atomic_write "$CFIP_DECISION_FILE"
}

select_assisted_candidates() {
    [[ "$CFIP_RILL_MODE" == assisted ]] || return 0
    if ! cfip_rill_qualified; then
        [[ -s "$CFIP_NATIVE_FILE" ]] && jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        return 0
    fi
    # Do not mutate CFIP_SELECTED_FILE until Runtime health, schema/model,
    # reset, and resource-pressure checks have all passed.
    if ! cfip_rill_assisted_ready; then
        [[ -s "$CFIP_NATIVE_FILE" ]] && jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        return 0
    fi
    local safe selected ids history
    history="$(cfip_rill_history_json)"
    safe="$(jq --argjson k "$CFIP_RILL_SAFE_TOP_K" --argjson history "$(cfip_rill_history_json)" '.[0:$k] | map(select(.eligible==true and ((.probeSummary.lossRate // .lossRate // 0) <= 0.25) and ((.probeSummary.ttfbMs // 0) <= 3000) and ((.probeSummary.totalMs // 0) <= 5000) and (($history[.ip].consecutiveFailures // 0) < 3)))' "$CFIP_NATIVE_FILE")"
    ids="$(jq -c '[.[].ip]' <<<"$safe")"; [[ "$(jq 'length' <<<"$safe")" -gt 0 ]] || return 0
    selected="$(jq --argjson ids "$ids" --argjson history "$history" --argjson count "$CFIP_IP_COUNT" --argjson cap "${CFIP_RILL_UNSEEN_CANDIDATE_CAP:-1}" '
      def prefix:
        if (.family // "") == "ipv6" then ((.ip|tostring)|split(":")[0:4]|join(":"))
        else ((.ip|tostring)|split(".")[0:3]|join(".")) end;
      def source: (.sourceClass // .origin // "unknown");
      [.candidates[] | select(.ip as $ip | ($ids|index($ip)))] | sort_by(.rillRank // 99999) |
      .[0] as $primary |
      (if $primary then
        (reduce .[1:][] as $candidate ({chosen:[$primary],deferred:[],unseen:0};
          if (.chosen|length) >= $count then .
          else ($candidate.ip|tostring) as $id |
            (($history[$id].successCount//0)+($history[$id].failureCount//0) == 0) as $is_unseen |
            if ($is_unseen and .unseen >= $cap) then .deferred += [$candidate]
            else ($candidate|prefix) as $prefix | ($candidate|source) as $source |
              ([.chosen[]|prefix]|index($prefix)|not) as $newPrefix |
              ([.chosen[].family]|index($candidate.family)|not) as $newFamily |
              ([.chosen[]|source]|index($source)|not) as $newSource |
              if ($newPrefix or $newFamily or $newSource) then .chosen += [$candidate] | .unseen += (if $is_unseen then 1 else 0 end)
              else .deferred += [$candidate] end
            end
          end) | .chosen + (.deferred[:($count-(.chosen|length))]))
      else [] end)
    ' "$CFIP_RILL_FILE")"
    [[ "$(jq 'length' <<<"$selected")" -gt 0 ]] || return 0
    if [[ "$(jq 'length' <<<"$selected")" -lt "$CFIP_IP_COUNT" ]]; then
        selected="$(jq --argjson chosen "$selected" --argjson safe "$safe" --argjson count "$CFIP_IP_COUNT" '($chosen|map(.ip)) as $chosenIds | ($chosen + ($safe|map(select(.ip as $ip | ($chosenIds|index($ip)|not)))))[:$count]' <<<"$selected")"
    fi
    printf '%s\n' "$selected" | cfip_atomic_write "$CFIP_SELECTED_FILE"
}

rollback_active_transaction() {
    local recovery_rc=0
    if [[ -n "${CFIP_TXN_DIR:-}" && -d "${CFIP_TXN_DIR:-}" && "${CFIP_TXN_COMMITTED:-false}" != true ]]; then
        cfip_txn_rollback "${CFIP_TXN_MODE:-$CFIP_MODE}" || recovery_rc=$?
        ((recovery_rc == 0)) && CFIP_STOPPED_MODE=""
    fi
    if [[ -n "$CFIP_STOPPED_MODE" ]]; then
        restore_stopped_service_if_needed || recovery_rc=$?
    fi
    return "$recovery_rc"
}

fail_run(){ local message="$1" recovery_rc=0; CFIP_LAST_RESULT=error; CFIP_ERROR="$message"; rollback_active_transaction || recovery_rc=$?; [[ -n "$CFIP_RECOVERY_ERROR" ]] && message="$message; $CFIP_RECOVERY_ERROR"; cfip_operational_update run-failed "$message" || true; write_status false failed error "$message" || true; remember_history || true; cfip_log "run failed: $message"; ((recovery_rc==0)) || return 1; return 1; }
run_cleanup(){ local rc="${1:-$?}" recovery_rc=0; trap - EXIT INT TERM; cfip_cancel_active_operation; rollback_active_transaction || recovery_rc=$?; release_lock; ((recovery_rc!=0 && rc==0)) && rc=1; exit "$rc"; }
run_signal_cleanup(){ cfip_cancel_active_operation; run_cleanup 143; }

prepare_adaptive_final_selection() {
    [[ "${CFIP_ADAPTIVE_AUDIT_DUE:-false}" == true && -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] || return 0
    cfip_adaptive_patch_final_selection "$CFIP_ADAPTIVE_AUDIT_FILE" "$CFIP_SELECTED_FILE" "$CFIP_DECISION_FILE" false || cfip_log "adaptive final selection patch unavailable"
}

finalize_adaptive_audit() {
    local applied="${1:-false}"
    [[ "${CFIP_ADAPTIVE_AUDIT_DUE:-false}" == true && -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] || return 0
    cfip_adaptive_patch_final_selection "$CFIP_ADAPTIVE_AUDIT_FILE" "$CFIP_SELECTED_FILE" "$CFIP_DECISION_FILE" "$applied" || { cfip_log "adaptive final selection patch unavailable"; return 0; }
    cfip_adaptive_record_audit "$CFIP_ADAPTIVE_AUDIT_FILE" || cfip_log "adaptive audit qualification update deferred"
}

run_v2() {
    load_config || return 1
    acquire_lock || { cfip_json_error "another v2 instance is running"; return 1; }
    trap 'run_cleanup "$?"' EXIT
    trap run_signal_cleanup INT TERM
    init_run_paths
    cleanup_run_files
    cfip_rill_process_pending_feedback || cfip_log "pending Rill feedback processing deferred"
    CFIP_PHASE=preflight; CFIP_LAST_RESULT=running
    if cfip_reuse_try_current; then
        CFIP_LAST_RESULT=success; CFIP_PHASE=done; CFIP_ERROR=""
        cfip_operational_update reuse-success validated_current_ip || true
        write_status false done success ""
        remember_history
        release_lock
        trap - EXIT INT TERM
        jq -cn --arg runId "$CFIP_RUN_ID" --argjson best "$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")" --argjson requested "$CFIP_IP_COUNT" '{success:true,runId:$runId,best_ips:$best,eligible:($best|length),requested:$requested,reused:true,degraded:(($best|length)<$requested)}'
        return 0
    fi
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    apply_startup_delay || { fail_run "invalid startup delay"; return 1; }
    CFIP_PHASE=acquiring
    ensure_cfst || { fail_run "failed to prepare CloudflareSpeedTest"; return 1; }
    cfip_prepare_candidate_pool "$CFIP_INPUT_POOL_FILE" "$CFIP_CANDIDATE_INPUT_FILE" "$CFIP_SOURCE_STATUS_FILE" || { fail_run "no candidate IPs available from enabled sources/cache"; return 1; }
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    CFIP_PHASE=measuring
    CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"
    CFIP_MEASUREMENT_STARTED_MS="$(cfip_now_millis)"
    CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT))
    cfip_txn_prepare "$CFIP_MODE" || { fail_run "failed to snapshot proxy configuration"; return 1; }
    stop_service_for_measurement || { fail_run "failed to stop proxy service before measurement"; return 1; }
    local cfstrc=0
    run_cfst || cfstrc=$?
    if ((cfstrc!=0)); then
        if [[ "$cfstrc" == 124 ]]; then fail_run "measurement timeout during CloudflareSpeedTest"; else fail_run "no valid CloudflareSpeedTest candidates"; fi
        return 1
    fi
    CFIP_PHASE=probing
    cfip_rill_probe_priority "$CFIP_CANDIDATES_FILE" "$CFIP_PROBE_INPUT_FILE" || cp "$CFIP_CANDIDATES_FILE" "$CFIP_PROBE_INPUT_FILE"
    CFIP_ADAPTIVE_CONTEXT_FINGERPRINT="$(cfip_rill_context_fingerprint 2>/dev/null || printf '')"; CFIP_ADAPTIVE_NOW="$(date +%s)"
    CFIP_ADAPTIVE_EFFECTIVE_MODE="$(cfip_adaptive_effective_mode)"; CFIP_ADAPTIVE_AUDIT_DUE=false
    # Off is a hard no-side-effect mode: it does not advance audit cadence or
    # create qualification evidence. Shadow still records a plan, but keeps
    # the production input and probe behavior unchanged.
    if [[ "$CFIP_ADAPTIVE_MEASUREMENT_ENABLED" == true && "$CFIP_ADAPTIVE_MEASUREMENT_MODE" != off ]]; then
        if cfip_adaptive_note_run; then CFIP_ADAPTIVE_AUDIT_DUE=true; fi
    fi
    CFIP_ADAPTIVE_SCHEDULER_STARTED_MS="$(cfip_now_millis)"
    cfip_adaptive_prepare_probe_input "$CFIP_PROBE_INPUT_FILE" "$CFIP_ADAPTIVE_PROBE_INPUT_FILE" "$CFIP_ADAPTIVE_PLAN_FILE" || { fail_run "adaptive measurement planning failed"; return 1; }
    CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=$(( $(cfip_now_millis) - CFIP_ADAPTIVE_SCHEDULER_STARTED_MS )); ((CFIP_ADAPTIVE_SCHEDULER_DURATION_MS < 0)) && CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=0
    CFIP_ADAPTIVE_PROBE_STARTED_MS="$(cfip_now_millis)"
    local eligible audit_rc=0
    if [[ "$CFIP_ADAPTIVE_AUDIT_DUE" == true ]]; then
        # An audit is the production run on this cadence. Probe the full
        # pre-probe pool once, rank that result, and use it for selection.
        cfip_probe_candidates "$CFIP_PROBE_INPUT_FILE" "$CFIP_PROBED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" || audit_rc=$?
        [[ -s "$CFIP_PROBED_FILE" ]] || printf '[]\n' | cfip_atomic_write "$CFIP_PROBED_FILE"
        cfip_adaptive_update_runtime "" "$(jq '.selectedK' "$CFIP_ADAPTIVE_PLAN_FILE")" 0
        cfip_rill_update_history "$CFIP_PROBED_FILE" || cfip_log "candidate history update deferred"
    else
        cfip_adaptive_probe "$CFIP_PROBE_INPUT_FILE" "$CFIP_PROBED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_IP_COUNT" "$CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE" "$CFIP_ADAPTIVE_MAX_PROBE_COUNT" "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_PROBE_METRICS_FILE" "$CFIP_ADAPTIVE_EFFECTIVE_MODE" || { fail_run "candidate probing failed"; return 1; }
        cfip_rill_update_history "$CFIP_PROBED_FILE" || cfip_log "candidate history update deferred"
    fi
    CFIP_ADAPTIVE_PROBE_DURATION_MS=$(( $(cfip_now_millis) - CFIP_ADAPTIVE_PROBE_STARTED_MS )); ((CFIP_ADAPTIVE_PROBE_DURATION_MS < 0)) && CFIP_ADAPTIVE_PROBE_DURATION_MS=0
    CFIP_MEASUREMENT_DURATION_MS=$(( $(cfip_now_millis) - CFIP_MEASUREMENT_STARTED_MS )); ((CFIP_MEASUREMENT_DURATION_MS < 0)) && CFIP_MEASUREMENT_DURATION_MS=0
    cfip_adaptive_record_run_metrics "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_PROBED_FILE" "$CFIP_PROBE_METRICS_FILE" || cfip_log "adaptive operational metrics unavailable"
    [[ "$(cfip_deadline_remaining)" -gt 0 ]] || { fail_run "measurement timeout during target probe"; return 1; }
    CFIP_PHASE=ranking
    cfip_native_rank "$CFIP_PROBED_FILE" "$CFIP_NATIVE_FILE" || { fail_run "native ranking failed"; return 1; }
    eligible="$(jq 'length' "$CFIP_NATIVE_FILE")"
    if [[ "$CFIP_ADAPTIVE_AUDIT_DUE" == true ]]; then
        cfip_adaptive_make_audit_record "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_NATIVE_FILE" "$CFIP_PROBED_FILE" "$CFIP_ADAPTIVE_AUDIT_FILE" "$audit_rc" || cfip_log "adaptive audit diagnostic unavailable"
    fi
    ((eligible>0)) || { fail_run "NoEligibleCandidate: every target-domain probe failed"; return 1; }
    jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
    if [[ "$CFIP_RILL_ENABLED" == true && "$CFIP_RILL_MODE" != off ]]; then
        cfip_rill_rank_shadow "$CFIP_NATIVE_FILE" "$CFIP_RILL_FILE" || true
    fi
    select_assisted_candidates
    build_decision
    prepare_adaptive_final_selection
    CFIP_PHASE=applying
    local txrc=0 holdout_json='{}'
    cfip_txn_apply "$CFIP_MODE" "$CFIP_SELECTED_FILE" || txrc=$?
    if ((txrc!=0)); then
        jq -cn --argjson rc "$txrc" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,rc:$rc,rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE" || true
        jq -cn --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"failure",censored:true,reason:"host_transaction_failed",observedIp:$ip,decisionActionId:$ip}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true
        CFIP_STOPPED_MODE=""
        finalize_adaptive_audit false
        fail_run "apply transaction failed (rc=$txrc)"
        return 1
    fi
    CFIP_STOPPED_MODE=""
    CFIP_PHASE=verifying
    CFIP_DECISION_ACTION_ID="$(jq -r '.authorityActionId // .selectedActionId // empty' "$CFIP_DECISION_FILE")"
    if ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then
        cfip_rill_queue_feedback "$CFIP_DECISION_FILE" "$CFIP_OUTCOME_FILE" || true
        cfip_txn_rollback "$CFIP_MODE" || true
        CFIP_STOPPED_MODE=""
        jq -cn --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,reason:"post_apply_probe_failed",rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
        finalize_adaptive_audit false
        fail_run "post-apply validation failed"
        return 1
    fi
    CFIP_TXN_STATE=HEALTH_OK
    CFIP_MEASUREMENT_DEADLINE=0
    if ! cfip_txn_commit; then
        cfip_txn_rollback "$CFIP_MODE" || true
        CFIP_STOPPED_MODE=""
        jq -cn --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,reason:"transaction_commit_failed",rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
        finalize_adaptive_audit false
        fail_run "transaction commit failed"
        return 1
    fi
    jq -cn '{success:true,rolledBack:false,health:"validated"}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
    holdout_json="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/holdout.json"
    if [[ "$(jq -r '.effectiveMode // empty' "$CFIP_DECISION_FILE" 2>/dev/null)" == assisted ]]; then
        if ! cfip_rill_holdout "$CFIP_DECISION_FILE" "$CFIP_NATIVE_FILE" "$CFIP_OUTCOME_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$holdout_json"; then
            jq -cn '{performed:false,reason:"not_due_or_unavailable",feedbackEligible:false}' | cfip_atomic_write "$holdout_json"
        fi
    else
        jq -cn '{performed:false,reason:"effective_mode_not_assisted",feedbackEligible:false}' | cfip_atomic_write "$holdout_json"
    fi
    cfip_reuse_write_event full-optimize-success full_optimize_completed 0 0 || cfip_log "reuse policy state update deferred"
    CFIP_PHASE=publishing
    cfip_publish_result "$CFIP_SELECTED_FILE" || cfip_log "LAN result publisher failed; network selection remains valid"
    CFIP_PHASE=feedback
    local feedback_file="$CFIP_OUTCOME_FILE" shadow_outcome=""
    if [[ "$(jq -r '.effectiveMode // empty' "$CFIP_DECISION_FILE" 2>/dev/null)" == shadow && -s "$CFIP_RILL_FILE" && -n "$(jq -r '.selectedActionId // empty' "$CFIP_DECISION_FILE")" && "$(jq -r '.selectedActionId // empty' "$CFIP_DECISION_FILE")" != "$(jq -r '.authorityActionId // empty' "$CFIP_DECISION_FILE")" ]]; then
        shadow_outcome="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-outcome.json"
        if cfip_rill_shadow_observe "$CFIP_DECISION_FILE" "$CFIP_RILL_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$shadow_outcome" "$CFIP_OUTCOME_FILE"; then
            feedback_file="$shadow_outcome"
        else
            cfip_log "shadow candidate observation unavailable; suppressing Candidate feedback"
            jq -cn --arg reason "shadow_observation_unavailable" '{feedbackEligible:false,observationUnavailable:true,reason:$reason,candidateOutcome:"unknown",hostOutcome:"success",censored:true}' | cfip_atomic_write "$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-observation-unavailable.json"
            feedback_file="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-observation-unavailable.json"
        fi
    fi
    if [[ "$CFIP_RILL_ENABLED" == true ]]; then
        cfip_rill_record_evidence "$CFIP_DECISION_FILE" "$feedback_file" "$(cat "$holdout_json" 2>/dev/null || printf '{}')" || cfip_log "Rill evidence store update deferred"
        cfip_rill_queue_feedback "$CFIP_DECISION_FILE" "$feedback_file" "$CFIP_TARGET_DOMAINS" || cfip_log "Rill delayed feedback queue unavailable"
    fi
    finalize_adaptive_audit true
    cfip_operational_update full-optimize-success full_optimize_completed || true
    CFIP_LAST_RESULT=success; CFIP_PHASE=done; CFIP_ERROR=""
    write_status false done success ""
    remember_history
    release_lock
    trap - EXIT INT TERM
    jq -cn --arg runId "$CFIP_RUN_ID" --argjson best "$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")" --argjson eligible "$eligible" --argjson requested "$CFIP_IP_COUNT" --argjson measured "$(jq 'length' "$CFIP_INPUT_POOL_FILE")" '{success:true,runId:$runId,best_ips:$best,measurement_input_count:$measured,eligible:$eligible,requested:$requested,degraded:($eligible<$requested)}'
}

cmd_status(){
    if [[ -f "$CFIP_STATUS_FILE" ]]; then
        local version=""
        version="$(cfip_cfst_version "$CFIP_WORK_DIR/cfst/cfst" 2>/dev/null || true)"
        jq --arg version "$version" '. + {cfst_version:(if $version=="" then (.cfst_version // null) else $version end)}' "$CFIP_STATUS_FILE"
        return
    fi
    local version=""
    version="$(cfip_cfst_version "$CFIP_WORK_DIR/cfst/cfst" 2>/dev/null || true)"
    jq -cn --arg script "$SCRIPT_VERSION" --arg cfstVersion "$version" --argjson tar "$(command -v tar >/dev/null 2>&1 && printf true || printf false)" --argjson jq "$(command -v jq >/dev/null 2>&1 && printf true || printf false)" --argjson cfst "$(test -x "$CFIP_WORK_DIR/cfst/cfst" && printf true || printf false)" '{schemaVersion:2,running:false,enabled:false,active_run:false,phase:"idle",last_result:"unknown",best_ips:[],script_version:$script,cfst_version:(if $cfstVersion=="" then null else $cfstVersion end),intelligence:{available:false},env:{tar:$tar,jq:$jq,cfst_installed:$cfst}}'
}
cmd_check_env(){ [[ -x "$CFIP_LEGACY_BIN" ]] && "$CFIP_LEGACY_BIN" --check-env || jq -cn '{success:false,error:"legacy environment probe unavailable"}'; }
cmd_version(){ jq -cn --arg script "$SCRIPT_VERSION" --arg release "$PACKAGE_RELEASE" '{success:true,version:$script,script_version:$script,package_release:$release,engine_schema:2,runtime_api_version:3}'; }
cmd_clear_log(){ mkdir -p "${CFIP_LOG_FILE%/*}"; : >"$CFIP_LOG_FILE"; jq -cn '{success:true,cleared:true}'; }
cmd_ip_history(){ local runs='[]' legacy='{}'; [[ -f "$CFIP_RUN_HISTORY" ]] && runs="$(tail -n 100 "$CFIP_RUN_HISTORY" | jq -s '.' 2>/dev/null || printf '[]')"; [[ -x "$CFIP_LEGACY_BIN" ]] && legacy="$("$CFIP_LEGACY_BIN" --ip-history 2>/dev/null || printf '{}')"; jq -n --argjson runs "$runs" --argjson legacy "$legacy" '{success:true,runs:$runs,ips:($legacy.ips//[])}'; }
cmd_download_cfst(){ load_config >/dev/null; WORK_DIR_OVERRIDE="$CFIP_WORK_DIR" "$CFIP_LEGACY_BIN" --download-cfst; }
cmd_source_status(){ cfip_source_status_json | jq -c '{success:true,sources:.}'; }
cmd_publisher_status(){ cfip_publisher_status_json; }
cmd_source_registry(){ cfip_builtin_registry_json | jq -c '{success:true,presets:.}'; }
cmd_rill_self_check(){
    load_config >/dev/null || return 1
    local status inspect
    status="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    inspect='{}'
    if [[ "$(jq -r '.available // false' <<<"$status")" == true ]]; then
        inspect="$(cfip_rill_inspect_json 2>/dev/null || printf '{}')"
    fi
    jq -cn --argjson status "$status" --argjson inspect "$inspect" \
        '{success:($status.available==true),status:$status,inspect:$inspect}'
}
cmd_rill_diagnostics(){
    load_config >/dev/null || return 1
    local status qualification pending meta source_policy reuse recent prefix_history colo_history prefix_summary colo_summary context evidence aggregate operational_history operational
    status="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    qualification="$(cfip_rill_qualification_json 2>/dev/null || printf '{}')"
    pending='[]'; [[ -s "$CFIP_RILL_PENDING_FILE" ]] && pending="$(cat "$CFIP_RILL_PENDING_FILE")"
    meta='{}'; [[ -s "$CFIP_RILL_STATE_META_FILE" ]] && meta="$(cat "$CFIP_RILL_STATE_META_FILE")"
    source_policy="$(cfip_source_policy_json 2>/dev/null || printf '{}')"
    reuse='{}'; [[ -s "$CFIP_REUSE_STATE_FILE" ]] && reuse="$(cat "$CFIP_REUSE_STATE_FILE")"
    prefix_history="$(cfip_rill_prefix_history_json 2>/dev/null || printf '{}')"; colo_history="$(cfip_rill_colo_history_json 2>/dev/null || printf '{"entries":{},"unknownCount":0}')"
    prefix_summary="$(jq -cn --argjson h "$prefix_history" --argjson now "$(date +%s)" '{trackedPrefixes:($h|length),recentHighQuality:([$h|to_entries[]|select((.value.successRate//0)<=1)|{prefix:.key,samples:(.value.samples//0),successRate:(.value.successRate//0)}]|sort_by(-.successRate,-.samples)|.[0:5]),recentLowQuality:([$h|to_entries[]|select((.value.successRate//0)<=1)|{prefix:.key,samples:(.value.samples//0),successRate:(.value.successRate//0),lastSeen:(.value.lastSeen//0)}]|sort_by(.successRate,.lastSeen)|.[0:5])}')"
    colo_summary="$(jq -cn --argjson h "$colo_history" '{observedColoCount:($h.entries|length),latestObservedColo:($h.lastObserved//null),unknownCount:($h.unknownCount//0),history:($h.entries//{})}')"
    context="$(cfip_rill_context_json 2>/dev/null || printf '{}')"; evidence="$(cfip_rill_evidence_json 2>/dev/null || printf '[]')"; aggregate="$(cfip_rill_evidence_aggregate_json 2>/dev/null || printf '{}')"
    recent='[]'; [[ -f "$CFIP_RUN_HISTORY" ]] && recent="$(tail -n 20 "$CFIP_RUN_HISTORY" | jq -sc '.' 2>/dev/null || printf '[]')"
    operational_history="$(cfip_operational_history_json 2>/dev/null || printf '{"schemaVersion":1,"records":[]}')"; operational="$(cfip_operational_state_json 2>/dev/null || printf '{}')"
    jq -cn --argjson status "$status" --argjson qualification "$qualification" --argjson pending "$pending" --argjson meta "$meta" --argjson sourcePolicy "$source_policy" --argjson reuse "$reuse" --argjson recent "$recent" --argjson prefix "$prefix_summary" --argjson colo "$colo_summary" --argjson context "$context" --argjson evidence "$evidence" --argjson aggregate "$aggregate" --argjson operationalHistory "$operational_history" --argjson operationalHealth "$operational" \
        '{success:true,runtime:$status,qualification:$qualification,recentDecisions:$recent,operationalHistory:$operationalHistory,operationalHealth:$operationalHealth,pendingFeedback:($pending[0:64]),sourcePolicy:$sourcePolicy,reusePolicy:$reuse,prefixIntelligence:$prefix,coloIntelligence:$colo,stateMeta:$meta,learningContext:$context,evidenceAggregate:$aggregate,evidenceWindow:$evidence,warnings:[]}'
}
cmd_rill_reset(){
    load_config >/dev/null || return 1
    local expected="${1:-}" actual stamp quarantine
    actual="$(cfip_rill_state_generation)"
    [[ -z "$expected" || "$expected" == "$actual" ]] || { cfip_json_error "state generation changed; refresh before reset"; return 1; }
    mkdir -p "${CFIP_RILL_STATE%/*}" "$CFIP_RILL_BASE_DIR"
    if [[ -e "$CFIP_RILL_STATE" ]]; then
        stamp="$(date +%Y%m%d%H%M%S)"
        quarantine="${CFIP_RILL_STATE}.quarantine.${stamp}"
        [[ -e "$quarantine" ]] && quarantine="${quarantine}.$$"
        mv "$CFIP_RILL_STATE" "$quarantine" || { cfip_json_error "failed to quarantine Rill state"; return 1; }
    else
        quarantine=''
    fi
    jq -cn --arg reason "manual_reset" --arg from "$quarantine" --argjson schema "$CFIP_RILL_SCHEMA_VERSION" \
        '{resetRequired:false,resetReason:$reason,migratedFrom:(if $from=="" then null else $from end),quarantinedState:($from!=""),featureSchemaVersion:$schema,at:(now|floor)}' \
        | cfip_atomic_write "$CFIP_RILL_STATE_META_FILE"
    cfip_rill_rotate_lineage manual_reset || { cfip_json_error "failed to rotate Rill state lineage"; return 1; }
    rm -f "$CFIP_RILL_QUALIFICATION_FILE" "$CFIP_RILL_PENDING_FILE"
    jq -cn --arg generation "$actual" --arg quarantine "$quarantine" '{success:true,reset:true,previousStateGeneration:($generation|tonumber),quarantinedState:(if $quarantine=="" then null else $quarantine end)}'
}

backup_id_valid(){ [[ "${1:-}" =~ ^[0-9]{14}([.][A-Za-z0-9_-]+)*$ ]]; }
cmd_oc_list_backups(){
    load_config >/dev/null || return 1
    local config="$CFIP_OPENCLASH_CONFIG" file id size timestamp
    local -a backups=()
    shopt -s nullglob
    for file in "$config".bak.*; do
        [ -f "$file" ] || continue
        id="${file#${config}.bak.}"; backup_id_valid "$id" || continue
        size="$(wc -c <"$file" 2>/dev/null || printf 0)"
        timestamp="$(date -r "$file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '%s' "$id")"
        backups+=("$(jq -cn --arg id "$id" --arg file "$file" --arg timestamp "$timestamp" --argjson size "$size" '{id:$id,file:$file,timestamp:$timestamp,size:$size}')")
    done
    shopt -u nullglob
    if ((${#backups[@]})); then
        printf '%s\n' "${backups[@]}" | jq -s --arg config "$config" '{success:true,config:$config,backups:sort_by(.timestamp)|reverse}'
    else
        jq -cn --arg config "$config" '{success:true,config:$config,backups:[]}'
    fi
}
cmd_oc_restore_backup(){
    load_config >/dev/null || return 1
    local id="${1:-}" config="$CFIP_OPENCLASH_CONFIG" backup pre tmp file
    backup_id_valid "$id" || { cfip_json_error "invalid backup id"; return 1; }
    backup="$config.bak.$id"
    if [ ! -f "$backup" ]; then
        backup=""
        shopt -s nullglob
        for file in "$config.bak.$id".*; do [ -f "$file" ] && { backup="$file"; break; }; done
        shopt -u nullglob
    fi
    [ -n "$backup" ] && [ -f "$backup" ] || { cfip_json_error "backup not found: $id"; return 1; }
    [ -f "$config" ] || { cfip_json_error "OpenClash config not found"; return 1; }
    pre="$config.bak.$(date +%Y%m%d%H%M%S).pre-restore"; [ -e "$pre" ] && pre="$pre.$$"
    cp -p "$config" "$pre" || { cfip_json_error "failed to create pre-restore backup"; return 1; }
    tmp="$(mktemp "$config.restore.XXXXXX")" || { cfip_json_error "failed to create restore temp"; return 1; }
    if ! cp -p "$backup" "$tmp" || ! mv "$tmp" "$config"; then
        rm -f "$tmp"; cfip_json_error "failed to restore backup"; return 1
    fi
    if [ -x /etc/init.d/openclash ] && ! /etc/init.d/openclash restart >/dev/null 2>&1; then
        cp -p "$pre" "$tmp" && mv "$tmp" "$config"
        /etc/init.d/openclash restart >/dev/null 2>&1 || true
        cfip_json_error "OpenClash restart failed; restored pre-restore config"; return 1
    fi
    jq -cn --arg restored "$backup" --arg pre "$pre" '{success:true,restored_from:$restored,pre_restore_backup:$pre}'
}
cmd_oc_delete_backup(){
    load_config >/dev/null || return 1
    local id="${1:-}" config="$CFIP_OPENCLASH_CONFIG" file
    backup_id_valid "$id" || { cfip_json_error "invalid backup id"; return 1; }
    local found=false
    shopt -s nullglob
    for file in "$config.bak.$id" "$config.bak.$id".*; do
        [ -f "$file" ] || continue
        found=true
        rm -f "$file" || { shopt -u nullglob; cfip_json_error "failed to delete backup"; return 1; }
    done
    shopt -u nullglob
    [ "$found" = true ] || { cfip_json_error "backup not found: $id"; return 1; }
    jq -cn --arg id "$id" '{success:true,deleted:$id}'
}
cmd_source_refresh(){ load_config >/dev/null || return 1; CFIP_RUN_ID="$(cfip_generate_run_id)"; local d="$CFIP_RUNTIME_DIR/source-refresh-$CFIP_RUN_ID"; mkdir -p "$d"; CFIP_INPUT_POOL_FILE="$d/input-pool.json"; CFIP_CANDIDATE_INPUT_FILE="$d/cfst-input.txt"; CFIP_SOURCE_STATUS_FILE="$CFIP_RUNTIME_DIR/source-status.json"; cfip_prepare_candidate_pool "$CFIP_INPUT_POOL_FILE" "$CFIP_CANDIDATE_INPUT_FILE" "$CFIP_SOURCE_STATUS_FILE" || { cfip_json_error "no candidate IPs available"; rm -rf "$d"; return 1; }; jq -cn --argjson count "$(jq 'length' "$CFIP_INPUT_POOL_FILE")" --argjson sources "$(cat "$CFIP_SOURCE_STATUS_FILE")" '{success:true,candidate_count:$count,sources:$sources}'; rm -rf "$d"; }
cmd_self_update(){ jq -cn '{success:false,error:"deprecated",message:"2.x application code is package-managed; upgrade via IPK/APK release"}'; return 1; }
cmd_validate_config(){
    local candidate="${1:-}"
    if [[ -n "$candidate" ]] && ! jq -e 'type == "object"' <<<"$candidate" >/dev/null 2>&1; then
        cfip_json_error "invalid staged candidate"
        return 1
    fi
    CFIP_VALIDATE_CANDIDATE_JSON="$candidate" load_config && jq -cn --arg mode "$CFIP_MODE" --arg schedule "$CFIP_CRON_INTERVAL" '{success:true,valid:true,mode:$mode,cron_interval:$schedule}'
}
cmd_sync(){ local mode="$1" txrc=0; load_config >/dev/null || return 1; [[ "$mode" == passwall || "$mode" == openclash ]] || { cfip_json_error "invalid sync target"; return 1; }; [[ -f "$CFIP_STATUS_FILE" ]] || { cfip_json_error "no status"; return 1; }; init_run_paths; jq '[.best_ips[]?|{ip:.,family:(if contains(":") then "ipv6" else "ipv4" end)}]' "$CFIP_STATUS_FILE" >"$CFIP_SELECTED_FILE"; CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"; CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT)); cfip_txn_prepare "$mode" || { cfip_json_error "failed to snapshot proxy configuration"; return 1; }; stop_service_for_measurement || { cfip_json_error "failed to stop proxy service"; return 1; }; cfip_txn_apply "$mode" "$CFIP_SELECTED_FILE" || txrc=$?; if ((txrc!=0)); then CFIP_STOPPED_MODE=""; jq -cn --argjson rc "$txrc" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,error:"sync transaction failed",rc:$rc,rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi; CFIP_STOPPED_MODE=""; if ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; CFIP_STOPPED_MODE=""; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync post-apply validation failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi; CFIP_MEASUREMENT_DEADLINE=0; if ! cfip_txn_commit; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; CFIP_STOPPED_MODE=""; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync transaction commit failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi; jq -cn --arg mode "$mode" '{success:true,synced:$mode,health:"validated",restartCount:1}'; }
cmd_sync_explicit(){
    local mode="$1" txrc=0
    load_config >/dev/null || return 1
    [[ "$mode" == passwall || "$mode" == openclash ]] || { cfip_json_error "invalid sync target"; return 1; }
    [[ -f "$CFIP_STATUS_FILE" ]] || { cfip_json_error "no status"; return 1; }
    CFIP_MODE="$mode"
    case "$mode" in
      passwall) CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_PASSWALL_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty PassWall target_domain"; return 1; } ;;
      openclash) [[ -f "$CFIP_OPENCLASH_CONFIG" ]] || { cfip_json_error "OpenClash config not found"; return 1; }; CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty OpenClash target_domain"; return 1; } ;;
    esac
    init_run_paths
    jq '[.best_ips[]?|{ip:.,family:(if contains(":") then "ipv6" else "ipv4" end)}]' "$CFIP_STATUS_FILE" >"$CFIP_SELECTED_FILE"
    CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"; CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT))
    cfip_txn_prepare "$mode" || { cfip_json_error "failed to snapshot proxy configuration"; return 1; }
    stop_service_for_measurement || { cfip_json_error "failed to stop proxy service"; return 1; }
    cfip_txn_apply "$mode" "$CFIP_SELECTED_FILE" || txrc=$?
    if ((txrc!=0)); then CFIP_STOPPED_MODE=""; jq -cn --argjson rc "$txrc" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,error:"sync transaction failed",rc:$rc,rolledBack:$rolledBack,recoveryVerified:($recovery=="")}'; return 1; fi
    CFIP_STOPPED_MODE=""
    if ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync post-apply validation failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}'; return 1; fi
    CFIP_MEASUREMENT_DEADLINE=0
    if ! cfip_txn_commit; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync transaction commit failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}'; return 1; fi
    jq -cn --arg mode "$mode" '{success:true,synced:$mode,health:"validated",restartCount:1}'
}

cmd_refresh_env(){ [[ -x "$CFIP_LEGACY_BIN" ]] && "$CFIP_LEGACY_BIN" --refresh-env || cmd_check_env; }
cmd_write_status(){ load_config >/dev/null || return 1; CFIP_RUN_ID=""; write_status false scheduled scheduled ""; }
cmd_adaptive_status(){ load_config >/dev/null || return 1; jq -cn --argjson adaptive "$(cfip_adaptive_status_json)" '{success:true,adaptiveMeasurement:$adaptive}'; }

to_cron(){
    local interval="${1:-}" custom="${2:-}" value minutes hours
    [[ "$interval" == custom ]] && interval="$custom"
    [[ -n "$interval" ]] || return 1
    case "$interval" in
        15m) printf '*/15 * * * *\n'; return 0 ;;
        30m) printf '*/30 * * * *\n'; return 0 ;;
        1h) printf '0 * * * *\n'; return 0 ;;
        6h) printf '0 */6 * * *\n'; return 0 ;;
    esac
    if [[ "$interval" =~ ^([1-9][0-9]*)m$ ]]; then
        minutes="${BASH_REMATCH[1]}"
        ((minutes <= 60 && 60 % minutes == 0)) || return 1
        printf '*/%s * * * *\n' "$minutes"; return 0
    fi
    if [[ "$interval" =~ ^([1-9][0-9]*)h$ ]]; then
        hours="${BASH_REMATCH[1]}"
        ((hours <= 24 && 24 % hours == 0)) || return 1
        printf '0 */%s * * *\n' "$hours"; return 0
    fi
    cfip_valid_cron "$interval" || return 1
    printf '%s\n' "$interval"
}

usage(){ cat <<'EOF_U'
Usage: cf-ip-auto [--run|--status|--check-env|--validate-config|--version|--read-log|--clear-log|--ip-history|--download-cfst|--source-status|--source-registry|--source-refresh|--publisher-status|--adaptive-status|--rill-self-check|--rill-diagnostics|--rill-reset [GENERATION]|--self-update|--sync MODE|--write-status|--to-cron INTERVAL [CUSTOM]]
EOF_U
}

cmd_sync(){ cmd_sync_explicit "$@"; }

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    action=""; arg=""; arg2=""; no_delay=false
    while (($#)); do case "$1" in --run) action=run ;; --status) action=status ;; --check-env) action=check-env ;; --refresh-env) action=refresh-env ;; --validate-config) action=validate-config; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --version) action=version ;; --read-log) action=read-log ;; --clear-log) action=clear-log ;; --ip-history) action=ip-history ;; --download-cfst) action=download-cfst ;; --source-status) action=source-status ;; --source-registry) action=source-registry ;; --source-refresh) action=source-refresh ;; --publisher-status) action=publisher-status ;; --adaptive-status) action=adaptive-status ;; --rill-self-check) action=rill-self-check ;; --rill-diagnostics) action=rill-diagnostics ;; --rill-reset) action=rill-reset; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --self-update) action=self-update ;; --oc-list-backups) action=oc-list-backups ;; --oc-restore-backup) action=oc-restore-backup; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --oc-delete-backup) action=oc-delete-backup; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --write-status) action=write-status ;; --no-delay) no_delay=true ;; --sync) action=sync; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --to-cron) action=to-cron; if (($# > 1)); then shift; arg="${1:-}"; fi; if (($# > 1)); then shift; arg2="${1:-}"; fi ;; -h|--help) usage; exit 0 ;; *) cfip_json_error "unexpected argument: $1"; exit 2 ;; esac; shift; done
    [[ "$no_delay" == true ]] && CFIP_SKIP_STARTUP_DELAY=true
    case "$action" in run|'') run_v2 ;; status) cmd_status ;; check-env) cmd_check_env ;; refresh-env) cmd_refresh_env ;; validate-config) cmd_validate_config "$arg" ;; version) cmd_version ;; read-log) cfip_read_log_json ;; clear-log) cmd_clear_log ;; ip-history) cmd_ip_history ;; download-cfst) cmd_download_cfst ;; source-status) cmd_source_status ;; source-registry) cmd_source_registry ;; source-refresh) cmd_source_refresh ;; publisher-status) cmd_publisher_status ;; adaptive-status) cmd_adaptive_status ;; rill-self-check) cmd_rill_self_check ;; rill-diagnostics) cmd_rill_diagnostics ;; rill-reset) cmd_rill_reset "$arg" ;; self-update) cmd_self_update ;; oc-list-backups) cmd_oc_list_backups "$arg" ;; oc-restore-backup) cmd_oc_restore_backup "$arg" ;; oc-delete-backup) cmd_oc_delete_backup "$arg" ;; sync) cmd_sync "$arg" ;; write-status) cmd_write_status ;; to-cron) to_cron "$arg" "$arg2" ;; *) usage; exit 2 ;; esac
fi
