#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_VERSION="@PKG_VERSION@"
PACKAGE_RELEASE="@PKG_RELEASE@"
ENGINE_SCHEMA_VERSION=2
CFIP_LIB_DIR="${CFIP_LIB_DIR:-/usr/libexec/cf-ip}"
CFIP_LEGACY_BIN="${CFIP_LEGACY_BIN:-/usr/bin/cf-ip-auto-legacy}"
CFIP_STATUS_DIR="${CFIP_STATUS_DIR:-/etc/cf_ip}"
CFIP_STATUS_FILE="$CFIP_STATUS_DIR/status.json"
CFIP_LOG_FILE="${CFIP_LOG_FILE:-/tmp/cf_ip/cf-ip-auto.log}"
CFIP_RUNTIME_DIR="${CFIP_RUNTIME_DIR:-/tmp/cf_ip}"
CFIP_LOCK_DIR="$CFIP_RUNTIME_DIR/cf-ip-auto-v2.lock"
CFIP_RUN_HISTORY="$CFIP_STATUS_DIR/run-history.ndjson"
CFIP_DNS_GUARD_BIN="${CFIP_DNS_GUARD_BIN:-/usr/sbin/openclash-dns-guard.sh}"
CFIP_PROBE_EXEC="${CFIP_PROBE_EXEC:-/usr/libexec/cf-ip/probe-exec}"
CFIP_DNS_MAINTENANCE_TTL="${CFIP_DNS_MAINTENANCE_TTL:-180}"
CFIP_DNS_MAINTENANCE_ACTIVE=false; CFIP_DNS_MAINTENANCE_ID=""; CFIP_DNS_MAINTENANCE_ERROR=""; CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=false
CFIP_OPENCLASH_HOT_APPLIED=false; CFIP_OPENCLASH_MAINTENANCE_RESTARTED=false
CFIP_OPENCLASH_MEASUREMENT_BYPASS_DISABLED=false
CFIP_VERBOSE=false
CFIP_RUN_ID=""; CFIP_PHASE="idle"; CFIP_LAST_RESULT="unknown"; CFIP_ERROR=""; CFIP_STOPPED_MODE=""; CFIP_CLEANUP_DONE=false
CFIP_SKIP_STARTUP_DELAY=false

CFIP_ENABLED=false; CFIP_MODE=passwall; CFIP_IP_COUNT=4; CFIP_IP_TYPE=ipv4
CFIP_SPEEDTEST_PROTOCOL=tcp; CFIP_SPEEDTEST_CFCOLO=""; CFIP_SPEEDTEST_DN=8; CFIP_SPEEDTEST_DT=6; CFIP_SPEEDTEST_TLL=40; CFIP_SPEEDTEST_TL=""; CFIP_SPEEDTEST_THREADS=200; CFIP_SPEEDTEST_PING_COUNT=3
CFIP_STOP_SERVICE=true; CFIP_STARTUP_DELAY=""; CFIP_WORK_DIR="/usr/bin"; CFIP_CRON_INTERVAL="6h"; CFIP_CANDIDATE_BUDGET=128; CFIP_PROBE_TOP_COUNT=8; CFIP_PROBE_CONCURRENCY=4; CFIP_PROBE_TIMEOUT=5; CFIP_MEASUREMENT_TIMEOUT=60; CFIP_RECOVERY_TIMEOUT=30; CFIP_PROBE_BATCH_SIZE=4; CFIP_MAX_PROBE_COUNT=8; CFIP_EARLY_STOP_ENABLED=true
CFIP_SPEEDTEST_COMPLETED=false
CFIP_BUILTIN_SOURCES="cloudflare-official-v4 cloudflare-official-v6"; CFIP_SOURCE_POLICY=balanced
CFIP_PUBLISH_ENABLED=false; CFIP_PUBLISH_BIND=""; CFIP_PUBLISH_PORT=12345
CFIP_PASSWALL_TARGET_DOMAIN=""; CFIP_PASSWALL_NAME_SUFFIX=" [CF-{n}]"
CFIP_OPENCLASH_CONFIG="/etc/openclash/config/config.yaml"; CFIP_OPENCLASH_RUNTIME_CONFIG=""; CFIP_OPENCLASH_TARGET_CONFIG=""; CFIP_OPENCLASH_PROVIDER_NAME=""; CFIP_OPENCLASH_TARGET_DOMAIN=""; CFIP_OPENCLASH_NAME_SUFFIX=" [CF-{n}]"; CFIP_OPENCLASH_TRANSPORT_FILTER=""; CFIP_OPENCLASH_BACKUP_COUNT=3
CFIP_GITHUB_MIRROR=""
CFIP_RILL_ENABLED=false; CFIP_RILL_MODE=shadow; CFIP_RILL_RUNTIME="${CFIP_RILL_RUNTIME_BIN:-/usr/bin/rill-runtime}"; CFIP_RILL_STATE="$CFIP_STATUS_DIR/rill-state.json"; CFIP_RILL_TIMEOUT_S=2; CFIP_RILL_SAFE_TOP_K=3; CFIP_RILL_MIN_FEEDBACK_SAMPLES=30; CFIP_RILL_EVALUATION_MAX_AGE_SECONDS=86400; CFIP_RILL_EVALUATION_STALE_SECONDS=604800; CFIP_RILL_TRAINING_MAX_AGE_SECONDS=604800; CFIP_RILL_DELAYED_FEEDBACK_SECONDS=600; CFIP_RILL_DELAYED_PROBE_TIMEOUT=5
CFIP_ADAPTIVE_MEASUREMENT_ENABLED=true; CFIP_ADAPTIVE_MEASUREMENT_MODE=shadow; CFIP_ADAPTIVE_TARGET_RATIO_PERCENT=25; CFIP_ADAPTIVE_MIN_PROBE_COUNT=8; CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT=10; CFIP_ADAPTIVE_MIN_EVIDENCE=50; CFIP_ADAPTIVE_EVIDENCE_WINDOW=100; CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS=604800; CFIP_ADAPTIVE_AUDIT_INTERVAL=20; CFIP_ADAPTIVE_MAX_PROBE_COUNT=60; CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE=8; CFIP_ADAPTIVE_NOW="$(date +%s)"; CFIP_ADAPTIVE_CONTEXT_FINGERPRINT=""
CFIP_REUSE_ENABLED=true; CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL=86400; CFIP_REUSE_VALIDATION_TIMEOUT=5; CFIP_REUSE_LOSS_LIMIT=0.25; CFIP_REUSE_TTFB_LIMIT=3000; CFIP_REUSE_TOTAL_LIMIT=5000; CFIP_REUSE_STATE_FILE="$CFIP_STATUS_DIR/reuse-policy.json"; CFIP_REUSE_DECISION_FILE=""
CFIP_MEASUREMENT_STARTED_MS=0; CFIP_MEASUREMENT_DURATION_MS=0; CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=0; CFIP_ADAPTIVE_PROBE_DURATION_MS=0

CFIP_CFST_INSTALL_TIMEOUT="${CFIP_CFST_INSTALL_TIMEOUT:-120}"
CFIP_CANDIDATES_FILE=""; CFIP_PROBED_FILE=""; CFIP_NATIVE_FILE=""; CFIP_SELECTED_FILE=""; CFIP_RILL_FILE=""; CFIP_DECISION_FILE=""; CFIP_OUTCOME_FILE=""; CFIP_TXN_RESULT_FILE=""; CFIP_REUSE_DECISION_FILE=""; CFIP_ADAPTIVE_PLAN_FILE=""; CFIP_ADAPTIVE_PROBE_INPUT_FILE=""; CFIP_ADAPTIVE_AUDIT_FILE=""
CFIP_INPUT_POOL_FILE=""; CFIP_CANDIDATE_INPUT_FILE=""; CFIP_PROBE_INPUT_FILE=""; CFIP_SOURCE_STATUS_FILE=""; CFIP_MEASUREMENT_DEADLINE=0; CFIP_MEASUREMENT_STARTED_AT=0; CFIP_RECOVERY_DEADLINE=0; CFIP_RECOVERY_STARTED_AT=0; CFIP_RECOVERY_ACTIVE=false; CFIP_RECOVERY_ERROR=""

for lib in writer-lock.sh common.sh config.sh status.sh source.sh scheduler.sh cfst.sh observe.sh adaptive-measurement.sh context-policy.sh transaction.sh openclash-transform.sh openclash-readback.sh openclash-provider.sh openclash-bypass.sh homeproxy-transaction.sh passwall2-transaction.sh publisher.sh rill-disabled.sh reuse.sh operational-health.sh; do
    if [[ -r "$CFIP_LIB_DIR/$lib" ]]; then source "$CFIP_LIB_DIR/$lib"; else printf '[cloudflare-ip] ERROR: missing library %s\n' "$CFIP_LIB_DIR/$lib" >&2; exit 1; fi
done
if [[ -r "$CFIP_LIB_DIR/candidate-rill.sh" ]]; then source "$CFIP_LIB_DIR/candidate-rill.sh"; fi

uci_get() {
    local key="$1" default="${2:-}" value
    if [[ -n "${CFIP_VALIDATE_CANDIDATE_JSON:-}" ]] && jq -e --arg key "$key" 'type == "object" and has($key)' <<<"$CFIP_VALIDATE_CANDIDATE_JSON" >/dev/null 2>&1; then
        value="$(jq -r --arg key "$key" 'if .[$key]|type == "array" then .[$key]|join(" ") else .[$key]|tostring end' <<<"$CFIP_VALIDATE_CANDIDATE_JSON")"
        printf '%s' "$value"
        return 0
    fi
    value="$(uci -q get "$key" 2>/dev/null || true)"
    [[ -n "$value" ]] && printf '%s' "$value" || printf '%s' "$default"
}

load_config() {
    command -v uci >/dev/null 2>&1 || { cfip_json_error "uci command not found"; return 1; }
    CFIP_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.enabled 0)")"; CFIP_MODE="$(uci_get cf_ip.main.mode passwall)"; CFIP_IP_COUNT="$(uci_get cf_ip.main.ip_count 4)"; CFIP_IP_TYPE="$(uci_get cf_ip.main.ip_type ipv4)"
    CFIP_SPEEDTEST_PROTOCOL="$(uci_get cf_ip.main.speedtest_protocol tcp)"; CFIP_SPEEDTEST_CFCOLO="$(uci_get cf_ip.main.speedtest_cfcolo '')"; CFIP_SPEEDTEST_DN="$(uci_get cf_ip.main.speedtest_dn 8)"; CFIP_SPEEDTEST_DT="$(uci_get cf_ip.main.speedtest_dt 6)"; CFIP_SPEEDTEST_TLL="$(uci_get cf_ip.main.speedtest_tll 40)"; CFIP_SPEEDTEST_TL="$(uci_get cf_ip.main.speedtest_tl '')"; CFIP_SPEEDTEST_THREADS="$(uci_get cf_ip.main.speedtest_threads 200)"; CFIP_SPEEDTEST_PING_COUNT="$(uci_get cf_ip.main.speedtest_ping_count 3)"
    CFIP_STOP_SERVICE="$(cfip_bool "$(uci_get cf_ip.main.stop_service 0)")"; CFIP_STARTUP_DELAY="$(uci_get cf_ip.main.startup_delay '')"; CFIP_WORK_DIR="$(uci_get cf_ip.main.work_dir /usr/bin)"; [[ -n "$CFIP_WORK_DIR" ]] || CFIP_WORK_DIR=/usr/bin
    CFIP_CRON_INTERVAL="$(uci_get cf_ip.main.cron_interval 6h)"; CFIP_CANDIDATE_BUDGET="$(uci_get cf_ip.main.candidate_budget 128)"; CFIP_PROBE_TOP_COUNT="$(uci_get cf_ip.main.probe_top_count "$(uci_get cf_ip.main.candidate_limit 8)")"; CFIP_PROBE_CONCURRENCY="$(uci_get cf_ip.main.probe_concurrency 4)"; CFIP_PROBE_TIMEOUT="$(uci_get cf_ip.main.probe_timeout 5)"; CFIP_MEASUREMENT_TIMEOUT="$(uci_get cf_ip.main.measurement_timeout 180)"; CFIP_RECOVERY_TIMEOUT="$(uci_get cf_ip.main.recovery_timeout 30)"; CFIP_PROBE_BATCH_SIZE="$(uci_get cf_ip.main.probe_batch_size 4)"; CFIP_MAX_PROBE_COUNT="$(uci_get cf_ip.main.max_probe_count "$CFIP_PROBE_TOP_COUNT")"; CFIP_EARLY_STOP_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.early_stop_enabled 1)")"; CFIP_ADAPTIVE_MEASUREMENT_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.adaptive_measurement_enabled 1)")"; CFIP_ADAPTIVE_MEASUREMENT_MODE="$(uci_get cf_ip.main.adaptive_measurement_mode shadow)"; CFIP_ADAPTIVE_TARGET_RATIO_PERCENT="$(uci_get cf_ip.main.adaptive_target_ratio_percent 25)"; CFIP_ADAPTIVE_MIN_PROBE_COUNT="$(uci_get cf_ip.main.adaptive_min_probe_count 8)"; CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT="$(uci_get cf_ip.main.adaptive_exploration_ratio_percent 10)"; CFIP_ADAPTIVE_MIN_EVIDENCE="$(uci_get cf_ip.main.adaptive_min_evidence 50)"; CFIP_ADAPTIVE_EVIDENCE_WINDOW="$(uci_get cf_ip.main.adaptive_evidence_window 100)"; CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS="$(uci_get cf_ip.main.adaptive_evaluation_max_age_seconds 604800)"; CFIP_ADAPTIVE_AUDIT_INTERVAL="$(uci_get cf_ip.main.adaptive_audit_interval 20)"; CFIP_ADAPTIVE_MAX_PROBE_COUNT="$(uci_get cf_ip.main.adaptive_max_probe_count 60)"; CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE="$(uci_get cf_ip.main.adaptive_expansion_batch_size 8)"; CFIP_BUILTIN_SOURCES="$(cfip_configured_builtin_sources)"; CFIP_SOURCE_POLICY="$(uci_get cf_ip.main.source_policy balanced)"; CFIP_GITHUB_MIRROR="$(uci_get cf_ip.main.github_mirror '')"; CFIP_VERBOSE="$(cfip_bool "$(uci_get cf_ip.main.verbose 0)")"
    CFIP_PASSWALL_TARGET_DOMAIN="$(uci_get cf_ip.passwall.target_domain '')"; CFIP_PASSWALL_NAME_SUFFIX="$(uci_get cf_ip.passwall.name_suffix ' [CF-{n}]')"; CFIP_HOMEPROXY_TARGET_DOMAIN="$(uci_get cf_ip.homeproxy.target_domain '')"; CFIP_PASSWALL2_TARGET_DOMAIN="$(uci_get cf_ip.passwall2.target_domain '')"
    CFIP_OPENCLASH_CONFIG="$(uci_get cf_ip.openclash.config /etc/openclash/config/config.yaml)"; CFIP_OPENCLASH_TARGET_DOMAIN="$(uci_get cf_ip.openclash.target_domain '')"; CFIP_OPENCLASH_NAME_SUFFIX="$(uci_get cf_ip.openclash.name_suffix ' [CF-{n}]')"; CFIP_OPENCLASH_TRANSPORT_FILTER="$(uci_get cf_ip.openclash.transport_filter '')"; CFIP_OPENCLASH_BACKUP_COUNT="$(uci_get cf_ip.openclash.backup_count 3)"
    CFIP_PUBLISH_ENABLED="$(cfip_bool "$(uci_get cf_ip.lan.enabled 0)")"; CFIP_PUBLISH_BIND="$(uci_get cf_ip.lan.bind_address '')"; CFIP_PUBLISH_PORT="$(uci_get cf_ip.lan.port 12345)"
    CFIP_RILL_ENABLED="$(cfip_bool "$(uci_get cf_ip.rill.enabled 0)")"; CFIP_RILL_MODE="$(uci_get cf_ip.rill.mode shadow)"; CFIP_RILL_RUNTIME="${CFIP_RILL_RUNTIME_BIN:-/usr/bin/rill-runtime}"; CFIP_RILL_STATE="$(uci_get cf_ip.rill.state_file "$CFIP_STATUS_DIR/rill-state.json")"; CFIP_RILL_SAFE_TOP_K="$(uci_get cf_ip.rill.safe_top_k 3)"; CFIP_RILL_MIN_FEEDBACK_SAMPLES="$(uci_get cf_ip.rill.min_feedback_samples 30)"; CFIP_RILL_EVALUATION_MAX_AGE_SECONDS="$(uci_get cf_ip.rill.evaluation_max_age_seconds 86400)"; CFIP_RILL_EVALUATION_STALE_SECONDS="$(uci_get cf_ip.rill.evaluation_stale_seconds 604800)"; CFIP_RILL_TRAINING_MAX_AGE_SECONDS="$(uci_get cf_ip.rill.training_max_age_seconds 604800)"; local delayed_minutes; delayed_minutes="$(uci_get cf_ip.rill.delayed_feedback_minutes 10)"; [[ "$delayed_minutes" =~ ^[1-9][0-9]*$ ]] || delayed_minutes=10; CFIP_RILL_DELAYED_FEEDBACK_SECONDS="$((delayed_minutes*60))"
    CFIP_REUSE_ENABLED="$(cfip_bool "$(uci_get cf_ip.main.reuse_enabled 1)")"; CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL="$(uci_get cf_ip.main.max_full_optimize_interval 86400)"; CFIP_REUSE_VALIDATION_TIMEOUT="$(uci_get cf_ip.main.reuse_validation_timeout 5)"; CFIP_REUSE_LOSS_LIMIT="$(uci_get cf_ip.main.reuse_loss_limit 0.25)"; CFIP_REUSE_TTFB_LIMIT="$(uci_get cf_ip.main.reuse_ttfb_limit 3000)"; CFIP_REUSE_TOTAL_LIMIT="$(uci_get cf_ip.main.reuse_total_limit 5000)"; CFIP_REUSE_STATE_FILE="$CFIP_STATUS_DIR/reuse-policy.json"
    cfip_operational_apply_guardrails || true
    local timeout_ms; timeout_ms="$(uci_get cf_ip.rill.timeout_ms 2000)"; [[ "$timeout_ms" =~ ^[0-9]+$ ]] && ((timeout_ms>0)) && CFIP_RILL_TIMEOUT_S=$(((timeout_ms+999)/1000)) || CFIP_RILL_TIMEOUT_S=2
    if [[ "$CFIP_IP_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_PROBE_TOP_COUNT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_TOP_COUNT < CFIP_IP_COUNT)); then CFIP_PROBE_TOP_COUNT="$CFIP_IP_COUNT"; fi
    validate_config "${1:-run}" || return $?
}

reconcile_committed_context() {
    [[ "$CFIP_RILL_ENABLED" == true && "$CFIP_RILL_MODE" != off ]] || return 0
    if declare -F cfip_rill_context_guard >/dev/null 2>&1; then
        cfip_rill_context_guard || { cfip_json_error "failed to establish Rill learning context"; return 1; }
    fi
}

validate_config() {
    [[ "$CFIP_MODE" == passwall || "$CFIP_MODE" == passwall2 || "$CFIP_MODE" == openclash || "$CFIP_MODE" == homeproxy ]] || { cfip_json_error "invalid mode"; return 1; }
    [[ "$CFIP_IP_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_CANDIDATE_BUDGET" =~ ^[1-9][0-9]*$ && "$CFIP_PROBE_TOP_COUNT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid candidate count"; return 1; }
    ((CFIP_CANDIDATE_BUDGET >= 100 && CFIP_CANDIDATE_BUDGET <= 512)) || { cfip_json_error "candidate_budget must be 100..512"; return 1; }
    ((CFIP_PROBE_TOP_COUNT >= CFIP_IP_COUNT && CFIP_PROBE_TOP_COUNT <= 32 && CFIP_PROBE_TOP_COUNT <= CFIP_CANDIDATE_BUDGET)) || { cfip_json_error "probe_top_count must be between ip_count and min(32,candidate_budget)"; return 1; }
    [[ "$CFIP_PROBE_CONCURRENCY" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_CONCURRENCY<=16)) || { cfip_json_error "probe_concurrency must be 1..16"; return 1; }
    [[ "$CFIP_PROBE_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_BATCH_SIZE<=16)) || { cfip_json_error "probe_batch_size must be 1..16"; return 1; }
    [[ "$CFIP_MAX_PROBE_COUNT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_MAX_PROBE_COUNT>=CFIP_IP_COUNT && CFIP_MAX_PROBE_COUNT<=CFIP_PROBE_TOP_COUNT)) || { cfip_json_error "max_probe_count must be between ip_count and probe_top_count"; return 1; }
    [[ "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == off || "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == shadow || "$CFIP_ADAPTIVE_MEASUREMENT_MODE" == guarded ]] || { cfip_json_error "invalid adaptive_measurement_mode"; return 1; }
    [[ "$CFIP_ADAPTIVE_TARGET_RATIO_PERCENT" =~ ^[0-9]+$ ]] && ((CFIP_ADAPTIVE_TARGET_RATIO_PERCENT>=1 && CFIP_ADAPTIVE_TARGET_RATIO_PERCENT<=100)) || { cfip_json_error "adaptive_target_ratio_percent must be 1..100"; return 1; }
    [[ "$CFIP_ADAPTIVE_MIN_PROBE_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_MAX_PROBE_COUNT" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid adaptive probe bounds"; return 1; }
    ((CFIP_ADAPTIVE_MIN_PROBE_COUNT>=CFIP_IP_COUNT && CFIP_ADAPTIVE_MAX_PROBE_COUNT>=CFIP_ADAPTIVE_MIN_PROBE_COUNT && CFIP_ADAPTIVE_MAX_PROBE_COUNT<=CFIP_CANDIDATE_BUDGET && CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE<=32)) || { cfip_json_error "adaptive probe bounds are unsafe"; return 1; }
    [[ "$CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT" =~ ^[0-9]+$ && "$CFIP_ADAPTIVE_EXPLORATION_RATIO_PERCENT" -le 50 ]] || { cfip_json_error "adaptive_exploration_ratio_percent must be 0..50"; return 1; }
    [[ "$CFIP_ADAPTIVE_MIN_EVIDENCE" =~ ^[1-9][0-9]*$ && "$CFIP_ADAPTIVE_EVIDENCE_WINDOW" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid adaptive evidence bounds"; return 1; }
    ((CFIP_ADAPTIVE_MIN_EVIDENCE<=CFIP_ADAPTIVE_EVIDENCE_WINDOW && CFIP_ADAPTIVE_EVIDENCE_WINDOW<=100 && CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS>=3600 && CFIP_ADAPTIVE_EVALUATION_MAX_AGE_SECONDS<=2592000 && CFIP_ADAPTIVE_AUDIT_INTERVAL>=1 && CFIP_ADAPTIVE_AUDIT_INTERVAL<=1000)) || { cfip_json_error "adaptive evidence or audit bounds are unsafe"; return 1; }
    [[ "$CFIP_PROBE_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_PROBE_TIMEOUT<=30)) || { cfip_json_error "probe_timeout must be 1..30"; return 1; }
    [[ "$CFIP_MEASUREMENT_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_MEASUREMENT_TIMEOUT>=20 && CFIP_MEASUREMENT_TIMEOUT<=300)) || { cfip_json_error "measurement_timeout must be 20..300"; return 1; }
    [[ "$CFIP_RECOVERY_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RECOVERY_TIMEOUT>=10 && CFIP_RECOVERY_TIMEOUT<=120)) || { cfip_json_error "recovery_timeout must be 10..120"; return 1; }
    [[ "$CFIP_SPEEDTEST_DN" =~ ^[0-9]+$ && "$CFIP_SPEEDTEST_DT" =~ ^[1-9][0-9]*$ && "$CFIP_SPEEDTEST_THREADS" =~ ^[1-9][0-9]*$ && "$CFIP_SPEEDTEST_PING_COUNT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "invalid CFST limits"; return 1; }
    ((CFIP_SPEEDTEST_DN<=100 && CFIP_SPEEDTEST_DT<=60 && CFIP_SPEEDTEST_THREADS<=1000 && CFIP_SPEEDTEST_PING_COUNT<=20)) || { cfip_json_error "CFST limits out of range"; return 1; }
    [[ "$CFIP_IP_TYPE" == ipv4 || "$CFIP_IP_TYPE" == ipv6 || "$CFIP_IP_TYPE" == both ]] || { cfip_json_error "invalid ip_type"; return 1; }
    [[ "$CFIP_SPEEDTEST_PROTOCOL" == tcp || "$CFIP_SPEEDTEST_PROTOCOL" == http ]] || { cfip_json_error "invalid speedtest_protocol"; return 1; }
    [[ "$CFIP_RILL_MODE" == off || "$CFIP_RILL_MODE" == shadow || "$CFIP_RILL_MODE" == assisted ]] || { cfip_json_error "invalid rill mode"; return 1; }
    [[ "$CFIP_RILL_SAFE_TOP_K" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_SAFE_TOP_K<=8)) || { cfip_json_error "safe_top_k must be 1..8"; return 1; }
    [[ "$CFIP_RILL_MIN_FEEDBACK_SAMPLES" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_MIN_FEEDBACK_SAMPLES<=200)) || { cfip_json_error "min_feedback_samples must be 1..200"; return 1; }
    [[ "$CFIP_RILL_EVALUATION_MAX_AGE_SECONDS" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_EVALUATION_MAX_AGE_SECONDS<=604800)) || { cfip_json_error "evaluation_max_age_seconds must be 1..604800"; return 1; }
    [[ "$CFIP_RILL_EVALUATION_STALE_SECONDS" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_EVALUATION_STALE_SECONDS<=2592000)) || { cfip_json_error "evaluation_stale_seconds must be 1..2592000"; return 1; }
    ((CFIP_RILL_EVALUATION_STALE_SECONDS>=CFIP_RILL_EVALUATION_MAX_AGE_SECONDS)) || { cfip_json_error "evaluation_stale_seconds must be >= evaluation_max_age_seconds"; return 1; }
    [[ "$CFIP_RILL_TRAINING_MAX_AGE_SECONDS" =~ ^[1-9][0-9]*$ ]] && ((CFIP_RILL_TRAINING_MAX_AGE_SECONDS<=2592000)) || { cfip_json_error "training_max_age_seconds must be 1..2592000"; return 1; }
    cfip_source_policy_valid "$CFIP_SOURCE_POLICY" || { cfip_json_error "invalid source_policy"; return 1; }
    ((CFIP_RILL_DELAYED_FEEDBACK_SECONDS>=60 && CFIP_RILL_DELAYED_FEEDBACK_SECONDS<=86400)) || { cfip_json_error "delayed_feedback_minutes must be 1..1440"; return 1; }
    [[ "$CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL" =~ ^[1-9][0-9]*$ ]] && ((CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL>=300 && CFIP_REUSE_MAX_FULL_OPTIMIZE_INTERVAL<=604800)) || { cfip_json_error "max_full_optimize_interval must be 300..604800"; return 1; }
    [[ "$CFIP_REUSE_VALIDATION_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && ((CFIP_REUSE_VALIDATION_TIMEOUT<=30)) || { cfip_json_error "reuse_validation_timeout must be 1..30"; return 1; }
    [[ "$CFIP_REUSE_LOSS_LIMIT" =~ ^0([.][0-9]+)?$|^1([.]0+)?$ ]] || { cfip_json_error "reuse_loss_limit must be 0..1"; return 1; }
    [[ "$CFIP_REUSE_TTFB_LIMIT" =~ ^[1-9][0-9]*$ && "$CFIP_REUSE_TOTAL_LIMIT" =~ ^[1-9][0-9]*$ ]] || { cfip_json_error "reuse latency limits must be positive"; return 1; }
    [[ "$CFIP_PUBLISH_PORT" =~ ^[0-9]+$ ]] && ((CFIP_PUBLISH_PORT>=1024 && CFIP_PUBLISH_PORT<=65535)) || { cfip_json_error "LAN publisher port must be 1024..65535"; return 1; }
    [[ -z "$CFIP_PUBLISH_BIND" || "$CFIP_PUBLISH_BIND" != 0.0.0.0 ]] || { cfip_json_error "LAN publisher may not bind 0.0.0.0"; return 1; }
    cfip_managed_work_dir_safe "$CFIP_WORK_DIR" || { cfip_json_error "work_dir must be root-owned /usr/bin or /usr/share/cf-ip"; return 1; }
    cfip_managed_rill_state_safe "$CFIP_RILL_STATE" || { cfip_json_error "rill state_file must stay under /etc/cf_ip and be root-owned/non-symlink"; return 1; }
    cfip_managed_openclash_config_safe "$CFIP_OPENCLASH_CONFIG" || { cfip_json_error "openclash.config must be an existing root-owned/non-symlink file, or a new path under /etc/openclash"; return 1; }
    if [[ -n "${CFIP_RILL_RUNTIME_BIN:-}" ]]; then
        # Process-local test/qualification seam; never read from UCI.
        cfip_path_regular_root_safe "$CFIP_RILL_RUNTIME" || { cfip_json_error "rill runtime override must be an executable regular file"; return 1; }
    else
        [[ "$CFIP_RILL_RUNTIME" == /usr/bin/rill-runtime ]] || { cfip_json_error "rill runtime path is not package-managed"; return 1; }
    fi
    if [[ "$CFIP_RILL_ENABLED" == true && ( "${1:-run}" == run || "${1:-run}" == save ) ]]; then
        if ! cfip_rill_runtime_allowed; then
            case "$(cfip_rill_runtime_channel)" in
                legacy-preview) cfip_json_error "Legacy rill-runtime-preview is installed; remove it and install Stable rill-runtime" ;;
                unknown)        cfip_json_error "Rill Runtime is not installed; install Stable rill-runtime first" ;;
                *)              cfip_json_error "Rill requires Stable rill-runtime; current channel is not compatible" ;;
            esac
            return 1
        fi
    fi
    local schedule="$CFIP_CRON_INTERVAL" custom_schedule=""
    if [[ "$schedule" == custom ]]; then
        custom_schedule="$(uci_get cf_ip.main.cron_custom '')"
        [[ -n "$custom_schedule" ]] || { cfip_json_error "custom cron schedule is empty"; return 1; }
        schedule="$custom_schedule"
    fi
    to_cron "$schedule" >/dev/null || { cfip_json_error "invalid cron schedule"; return 1; }
    if [[ -n "$CFIP_GITHUB_MIRROR" ]]; then cfip_https_url_or_empty "$CFIP_GITHUB_MIRROR" || { cfip_json_error "github_mirror must use https"; return 1; }; [[ "$CFIP_GITHUB_MIRROR" == */ ]] || { cfip_json_error "github_mirror must end with /"; return 1; }; fi
    # A disabled installation can be saved before a proxy is configured.
    # Auxiliary/read-only operations must also work before proxy setup;
    # execution, sync and apply stay strict.
    local require_proxy=true
    case "${1:-run}" in
        aux) require_proxy=false ;;
        save) [[ "$CFIP_ENABLED" == false ]] && require_proxy=false ;;
    esac
    case "$CFIP_MODE" in
      passwall)
        if [[ "$require_proxy" == true || -n "$CFIP_PASSWALL_TARGET_DOMAIN" ]]; then
          CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_PASSWALL_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty PassWall target_domain"; return 1; }
        fi ;;
      openclash)
        if [[ "$require_proxy" == true && ! -f "$CFIP_OPENCLASH_CONFIG" ]]; then cfip_json_error "OpenClash config not found"; return 1; fi
        if [[ "$require_proxy" == true || -n "$CFIP_OPENCLASH_TARGET_DOMAIN" ]]; then
          CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty OpenClash target_domain"; return 1; }
        fi ;;
      homeproxy)
        if [[ "$require_proxy" == true || -n "$CFIP_HOMEPROXY_TARGET_DOMAIN" ]]; then
          CFIP_TARGET_DOMAINS="$(cfip_homeproxy_normalize_domain "$CFIP_HOMEPROXY_TARGET_DOMAIN")" || { cfip_json_error "HomeProxy requires exactly one valid target DNS hostname"; return 1; }
          if [[ "$require_proxy" == true ]]; then
            cfip_homeproxy_resolve_active_node "$CFIP_TARGET_DOMAINS" || { cfip_json_error "$CFIP_RECOVERY_ERROR"; return 1; }
          fi
        fi ;;
      passwall2)
        if [[ "$require_proxy" == true || -n "$CFIP_PASSWALL2_TARGET_DOMAIN" ]]; then
          CFIP_TARGET_DOMAINS="$(cfip_pw2_normalize_target "$CFIP_PASSWALL2_TARGET_DOMAIN")" || { cfip_json_error "PassWall2 requires exactly one valid target DNS hostname"; return 1; }
          if [[ "$require_proxy" == true ]]; then
            cfip_pw2_resolve_target "$CFIP_TARGET_DOMAINS" || { cfip_json_error "$CFIP_RECOVERY_ERROR"; return 1; }
          fi
        fi ;;
    esac
}

acquire_lock() { cf_ip_writer_lock_acquire "$CFIP_RUNTIME_DIR"; }
release_lock(){ cf_ip_writer_lock_release "$CFIP_RUNTIME_DIR" || cfip_log "writer lock release deferred: ${CF_IP_WRITER_LOCK_ERROR:-metadata cleanup failed}"; }

init_run_paths(){ CFIP_RUN_ID="${1:-$(cfip_generate_run_id)}" || return 1; local d="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID"; mkdir -p "$d" || return 1; CFIP_INPUT_POOL_FILE="$d/input-pool.json"; CFIP_CANDIDATE_INPUT_FILE="$d/cfst-input.txt"; CFIP_PROBE_INPUT_FILE="$d/probe-input.json"; CFIP_SOURCE_STATUS_FILE="$CFIP_RUNTIME_DIR/source-status.json"; CFIP_CANDIDATES_FILE="$d/candidates.json"; CFIP_PROBED_FILE="$d/probed.json"; CFIP_NATIVE_FILE="$d/native.json"; CFIP_SELECTED_FILE="$d/selected.json"; CFIP_RILL_FILE="$d/rill.json"; CFIP_DECISION_FILE="$d/decision.json"; CFIP_OUTCOME_FILE="$d/outcome.json"; CFIP_TXN_RESULT_FILE="$d/transaction.json"; CFIP_PROBE_METRICS_FILE="$d/probe-metrics.json"; CFIP_REUSE_DECISION_FILE="$d/reuse-decision.json"; CFIP_ADAPTIVE_PLAN_FILE="$d/adaptive-plan.json"; CFIP_ADAPTIVE_PROBE_INPUT_FILE="$d/adaptive-probe-input.json"; CFIP_ADAPTIVE_AUDIT_FILE="$d/adaptive-audit.json"; }
cleanup_run_files(){
    find "$CFIP_RUNTIME_DIR" -maxdepth 1 -type d -name 'run-*' -mmin +120 -exec rm -rf {} + 2>/dev/null || true
    find "$CFIP_RUNTIME_DIR" -maxdepth 1 -type f -name 'cfst-*.csv' -mmin +120 -exec rm -f {} + 2>/dev/null || true
}

write_status() {
    local active_run="$1" phase="$2" result="$3" error="${4:-}" candidates=0 input_count=0 eligible=0 selected=0 best='[]' rill='{}' adaptive='{}' transaction='{}' sources='[]' publisher='{}' decision='{}' probe_metrics='{}' source_policy='{}' reuse='{}' context='{}' evidence_aggregate='{}' operational='{}' proxy_service='{}' why='' previous='{}' last_completed='' status_now completed_at=''
    [[ -f "$CFIP_CANDIDATES_FILE" ]] && candidates="$(jq 'length' "$CFIP_CANDIDATES_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_INPUT_POOL_FILE" ]] && input_count="$(jq 'length' "$CFIP_INPUT_POOL_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_NATIVE_FILE" ]] && eligible="$(jq 'length' "$CFIP_NATIVE_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_SELECTED_FILE" ]] && selected="$(jq 'length' "$CFIP_SELECTED_FILE" 2>/dev/null || printf 0)"
    [[ -f "$CFIP_SELECTED_FILE" ]] && best="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE" 2>/dev/null || printf '[]')"
    [[ -f "$CFIP_SOURCE_STATUS_FILE" ]] && sources="$(cat "$CFIP_SOURCE_STATUS_FILE" 2>/dev/null || printf '[]')"
    rill="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    adaptive="$(cfip_adaptive_status_json 2>/dev/null || printf '{"available":false,"effectiveMode":"shadow","qualificationState":"insufficient"}')"
    publisher="$(cfip_publisher_status_json 2>/dev/null || printf '{"success":false,"state":"error"}')"
    [[ -f "$CFIP_TXN_RESULT_FILE" ]] && transaction="$(cat "$CFIP_TXN_RESULT_FILE")"
    [[ -f "$CFIP_DECISION_FILE" ]] && decision="$(jq -c . "$CFIP_DECISION_FILE" 2>/dev/null || printf '{}')"
    [[ -f "${CFIP_PROBE_METRICS_FILE:-}" ]] && probe_metrics="$(jq -c . "$CFIP_PROBE_METRICS_FILE" 2>/dev/null || printf '{}')"
    source_policy="$(cfip_source_policy_json 2>/dev/null || printf '{}')"
    [[ -f "${CFIP_REUSE_DECISION_FILE:-}" ]] && reuse="$(jq -c . "$CFIP_REUSE_DECISION_FILE" 2>/dev/null || printf '{}')"
    operational="$(cfip_operational_state_json 2>/dev/null || printf '{}')"
    if [[ "$CFIP_MODE" == openclash ]]; then
        proxy_service="$(jq -cn --argjson enabled "${CFIP_OPENCLASH_EXPECTED_ENABLED:-null}" --argjson speedtest "${CFIP_SPEEDTEST_COMPLETED:-false}" --argjson initiallyRunning "${CFIP_OPENCLASH_INITIAL_RUNNING:-false}" --argjson initiallyHealthy "${CFIP_OPENCLASH_INITIAL_HEALTHY:-false}" --argjson stoppedByCf "${CFIP_OPENCLASH_CF_STOPPED:-false}" --argjson fileWritten "${CFIP_OPENCLASH_FILE_WRITTEN:-false}" --argjson applied "${CFIP_OPENCLASH_SERVICE_APPLIED:-false}" --argjson deferred "${CFIP_OPENCLASH_DEFERRED:-false}" --argjson recoveryAttempted "${CFIP_OPENCLASH_RECOVERY_ATTEMPTED:-false}" --argjson recoveryVerified "${CFIP_OPENCLASH_RECOVERY_VERIFIED:-false}" --arg error "${CFIP_OPENCLASH_SERVICE_ERROR:-}" '{target:"openclash",expectedEnabled:$enabled,speedtestCompleted:$speedtest,initiallyRunning:$initiallyRunning,initiallyHealthy:$initiallyHealthy,stoppedByCf:$stoppedByCf,nodeFileWritten:$fileWritten,serviceApplied:($applied and $fileWritten),deferredUntilServiceStart:$deferred,recoveryAttempted:$recoveryAttempted,recoveryVerified:$recoveryVerified,error:(if $error=="" then null else $error end)}')"
    elif [[ "$CFIP_MODE" == homeproxy && "$phase" == done ]]; then
        local hp_maintenance=false hp_applied=false hp_method=none
        local hp_node="${CFIP_HOMEPROXY_NODE_SECTION:-}" hp_candidate="$(jq -r '.[0].ip // empty' "${CFIP_SELECTED_FILE:-/dev/null}" 2>/dev/null)"
        [[ "${CFIP_HOMEPROXY_MAINTENANCE_RESTARTED:-false}" == true ]] && { hp_maintenance=true; hp_applied=true; hp_method=maintenance_restart; }
        proxy_service="$(jq -cn --arg node "$hp_node" --arg candidate "$hp_candidate" --argjson applied "$hp_applied" --argjson maintenance "$hp_maintenance" --arg method "$hp_method" '{target:"homeproxy",configurationPersisted:true,serviceApplied:$applied,applyPending:true,maintenanceRestarted:$maintenance,applicationMethod:$method,updatedNodeCount:(if $node=="" then 0 else 1 end),updatedNode:(if $node=="" then null else $node end),appliedCandidate:(if $candidate=="" then null else $candidate end),runtimeEgressVerified:false,restartCount:(if $maintenance then 1 else 0 end)}')"
    elif [[ "$CFIP_MODE" == passwall2 && "$phase" == done ]]; then
        local pw2_maintenance=false pw2_node="${CFIP_PW2_TARGET_NODE:-}" pw2_candidate="$(jq -r '.[0].ip // empty' "${CFIP_SELECTED_FILE:-/dev/null}" 2>/dev/null)"
        [[ "${CFIP_PW2_MAINTENANCE_RESTARTED:-false}" == true ]] && pw2_maintenance=true
        proxy_service="$(jq -cn --arg node "$pw2_node" --arg candidate "$pw2_candidate" --argjson maintenance "$pw2_maintenance" '{target:"passwall2",configurationPersisted:true,serviceApplied:false,applyPending:true,maintenanceRestarted:$maintenance,applicationMethod:"persisted_only",updatedNodeCount:(if $node=="" then 0 else 1 end),updatedNode:(if $node=="" then null else $node end),appliedCandidate:(if $candidate=="" then null else $candidate end),runtimeEgressVerified:false,restartCount:0}')"
    fi
    why="$(cfip_operational_why_run 2>/dev/null || printf '')"
    if declare -F cfip_rill_context_json >/dev/null 2>&1; then context="$(cfip_rill_context_json 2>/dev/null || printf '{}')"; fi
    if declare -F cfip_rill_evidence_aggregate_json >/dev/null 2>&1; then evidence_aggregate="$(cfip_rill_evidence_aggregate_json 2>/dev/null || printf '{}')"; fi
    status_now="$(date +%s)"
    [[ -s "$CFIP_STATUS_FILE" ]] && previous="$(jq -c 'if type=="object" then . else {} end' "$CFIP_STATUS_FILE" 2>/dev/null || printf '{}')"
    last_completed="$(jq -r '.last_completed_run_at // .last_run // empty' <<<"$previous" 2>/dev/null || true)"
    completed_at="$last_completed"
    if [[ "$active_run" == false && ("$phase" == done || "$phase" == failed) ]]; then completed_at="$(date -u -r "$status_now" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%dT%H:%M:%SZ')"; fi
    mkdir -p "$CFIP_STATUS_DIR"
    local tar_ok=false jq_ok=false cfst_ok=false cfst_version="" passwall_installed=false passwall_running=false openclash_installed=false openclash_running=false homeproxy_env='{}' passwall2_env='{}'
    command -v tar >/dev/null 2>&1 && tar_ok=true
    command -v jq >/dev/null 2>&1 && jq_ok=true
    [[ -x "$CFIP_WORK_DIR/cfst/cfst" ]] && cfst_ok=true
    cfst_version="$(cfip_cfst_version "$CFIP_WORK_DIR/cfst/cfst" 2>/dev/null || true)"
    [[ -x "$CFIP_INIT_DIR/passwall" ]] && passwall_installed=true
    [[ "$passwall_installed" == true ]] && cfip_service_running passwall status && passwall_running=true
    [[ -x "$CFIP_INIT_DIR/openclash" ]] && openclash_installed=true
    [[ "$openclash_installed" == true ]] && cfip_service_running openclash status && openclash_running=true
    homeproxy_env="$(cfip_homeproxy_environment_json 2>/dev/null || printf '{}')"
    passwall2_env="$(cfip_pw2_environment_json 2>/dev/null || printf '{}')"
    local recovery_remaining recovery_active
    recovery_remaining="$(cfip_recovery_remaining)"
    [[ "${CFIP_RECOVERY_ACTIVE:-false}" == true ]] && recovery_active=true || recovery_active=false
    jq -n --argjson schemaVersion "$ENGINE_SCHEMA_VERSION" --argjson activeRun "$active_run" --argjson enabled "$CFIP_ENABLED" --argjson speedtestCompleted "${CFIP_SPEEDTEST_COMPLETED:-false}" --arg runId "$CFIP_RUN_ID" --arg requestId "${CFIP_RUN_REQUEST_ID:-}" --arg phase "$phase" --arg lastResult "$result" --arg error "$error" --arg mode "$CFIP_MODE" --arg ipType "$CFIP_IP_TYPE" --arg protocol "$CFIP_SPEEDTEST_PROTOCOL" --arg version "$SCRIPT_VERSION" --arg packageVersion "$SCRIPT_VERSION-r$PACKAGE_RELEASE" --arg cfstVersion "$cfst_version" --argjson requested "$CFIP_IP_COUNT" --argjson candidates "$candidates" --argjson inputCount "$input_count" --argjson budget "$CFIP_CANDIDATE_BUDGET" --argjson eligible "$eligible" --argjson selected "$selected" --argjson best "$best" --argjson intelligence "$rill" --argjson adaptive "$adaptive" --argjson transaction "$transaction" --argjson sources "$sources" --argjson publisher "$publisher" --argjson decision "$decision" --argjson probeMetrics "$probe_metrics" --argjson sourcePolicy "$source_policy" --argjson context "$context" --argjson evidenceAggregate "$evidence_aggregate" --argjson operational "$operational" --argjson proxyService "$proxy_service" --argjson homeproxyEnv "$homeproxy_env" --argjson passwall2Env "$passwall2_env" --arg why "$why" --argjson tar "$tar_ok" --argjson jq "$jq_ok" --argjson cfst "$cfst_ok" --argjson pi "$passwall_installed" --argjson pr "$passwall_running" --argjson oi "$openclash_installed" --argjson openclashRunning "$openclash_running" --argjson recoveryRemaining "$recovery_remaining" --argjson recoveryActive "$recovery_active" --arg recoveryError "${CFIP_RECOVERY_ERROR:-}" --arg statusUpdatedAt "$(date -u -r "$status_now" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg lastCompleted "$completed_at" '
      {schemaVersion:$schemaVersion,running:$enabled,enabled:$enabled,scheduled:$enabled,disabled:($enabled|not),active_run:$activeRun,jobRunning:$activeRun,speedtestCompleted:$speedtestCompleted,runId:$runId,requestId:(if $requestId=="" then null else $requestId end),phase:$phase,last_result:$lastResult,error:$error,mode:$mode,ip_type:$ipType,ip_count:$selected,requested_ip_count:$requested,speedtest_protocol:$protocol,best_ips:$best,script_version:$version,package_version:$packageVersion,cfst_version:(if $cfstVersion=="" then null else $cfstVersion end),candidate_budget:$budget,measurement_input_count:$inputCount,candidate_count:$candidates,eligible_count:$eligible,degraded_candidate_count:($selected<$requested),probeMetrics:$probeMetrics,efficiency:$probeMetrics,sourcePolicy:$sourcePolicy,learningContext:$context,evidenceAggregate:$evidenceAggregate,adaptiveMeasurement:$adaptive,operationalHealth:$operational,whyThisRun:(if $why=="" then null else $why end),tar:$tar,jq:$jq,cfst_installed:$cfst,passwall_installed:$pi,passwall_running:$pr,openclash_installed:$oi,openclash_running:$openclashRunning,service:$proxyService,env:({tar:$tar,jq:$jq,cfst_installed:$cfst,passwall_installed:$pi,passwall_running:$pr,openclash_installed:$oi,openclash_running:$openclashRunning}+$homeproxyEnv+$passwall2Env),sources:$sources,publisher:$publisher,intelligence:$intelligence,decision:$decision,confidenceLevel:($decision.confidenceLevel // null),confidenceReasons:($decision.confidenceReasons // []),requestedMode:($decision.requestedMode // null),effectiveMode:($decision.effectiveMode // null),fallbackReason:($decision.fallbackReason // null),authorityActionId:($decision.authorityActionId // null),nativeRillTop1Agreement:($decision.nativeRillTop1Agreement // null),rillTop3Overlap:($decision.rillTop3Overlap // null),transaction:$transaction,recovery:{active:$recoveryActive,remaining:$recoveryRemaining,error:(if $recoveryError=="" then null else $recoveryError end)},status_updated_at:$statusUpdatedAt,last_completed_run_at:(if $lastCompleted=="" then null else $lastCompleted end),last_run:(if $lastCompleted=="" then null else $lastCompleted end)}' | cfip_atomic_write "$CFIP_STATUS_FILE"
    if [[ -s "${CFIP_REUSE_DECISION_FILE:-}" && -s "$CFIP_STATUS_FILE" ]]; then
        jq --slurpfile reuse "$CFIP_REUSE_DECISION_FILE" '. + {reusePolicy: ($reuse[0] // {})}' "$CFIP_STATUS_FILE" | cfip_atomic_write "$CFIP_STATUS_FILE"
    fi
}

remember_history(){
    [[ -n "$CFIP_RUN_ID" ]] || return 0
    mkdir -p "$CFIP_STATUS_DIR"
    local metrics='{}' adaptive='{}' decision='{}' qualification='{}' transaction='{}' audit='{}' best='[]' context='' planned='null' actual='null' full='null' expansion='null' fallback='null' audit_run=false transaction_applied='null' adaptive_effective='' candidate_effective=''
    [[ -s "${CFIP_PROBE_METRICS_FILE:-}" ]] && metrics="$(jq -c . "$CFIP_PROBE_METRICS_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_ADAPTIVE_STATE_FILE:-}" ]] && adaptive="$(jq -c . "$CFIP_ADAPTIVE_STATE_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_DECISION_FILE:-}" ]] && decision="$(jq -c . "$CFIP_DECISION_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_TXN_RESULT_FILE:-}" ]] && transaction="$(jq -c . "$CFIP_TXN_RESULT_FILE" 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] && audit="$(jq -c . "$CFIP_ADAPTIVE_AUDIT_FILE" 2>/dev/null || printf '{}')"
    declare -F cfip_rill_qualification_json >/dev/null 2>&1 && qualification="$(cfip_rill_qualification_json 2>/dev/null || printf '{}')"
    [[ -s "${CFIP_SELECTED_FILE:-}" ]] && best="$(jq -c '[.[].ip]' "$CFIP_SELECTED_FILE" 2>/dev/null || printf '[]')"
    adaptive_effective="$(jq -r '.effectiveAdaptiveMode // empty' <<<"$metrics")"; [[ -n "$adaptive_effective" ]] || adaptive_effective="${CFIP_ADAPTIVE_EFFECTIVE_MODE:-}"
    candidate_effective="$(jq -r '.effectiveMode // empty' <<<"$decision")"
    context="${CFIP_ADAPTIVE_CONTEXT_FINGERPRINT:-$(jq -r '.contextFingerprint // .lastContextFingerprint // empty' <<<"$adaptive" 2>/dev/null || true)}"
    planned="$(jq -r '.plannedK // .selectedK // "null"' <<<"$metrics")"
    actual="$(jq -r '.actualUniqueProbeCount // "null"' <<<"$metrics")"
    full="$(jq -r '.fullCandidateCount // "null"' <<<"$metrics")"
    expansion="$(jq -r '.expansionCount // "null"' <<<"$metrics")"
    fallback="$(jq -r 'if has("fallbackUsed") then .fallbackUsed else "null" end' <<<"$metrics")"
    audit_run="$(jq -r '.auditRun // false' <<<"$metrics")"
    transaction_applied="$(jq -r 'if has("success") then (.success == true) else "null" end' <<<"$transaction")"
    jq -cn --arg runId "$CFIP_RUN_ID" --arg result "$CFIP_LAST_RESULT" --arg mode "$CFIP_MODE" --arg policy "${CFIP_SOURCE_POLICY_EFFECTIVE:-${CFIP_SOURCE_POLICY:-balanced}}" --arg adaptiveRequestedMode "${CFIP_ADAPTIVE_MEASUREMENT_MODE:-}" --arg adaptiveEffectiveMode "$adaptive_effective" --arg adaptiveQualificationState "$(jq -r '.qualificationState // "null"' <<<"$adaptive")" --arg candidateRequestedMode "${CFIP_RILL_MODE:-}" --arg candidateEffectiveMode "$candidate_effective" --arg candidateQualificationState "$(jq -r '.state // .qualificationState // "null"' <<<"$qualification")" --arg contextFingerprint "$context" --argjson best "$best" --argjson plannedK "$planned" --argjson actualUniqueProbeCount "$actual" --argjson fullCandidateCount "$full" --argjson expansionCount "$expansion" --argjson fallbackUsed "$fallback" --argjson auditRun "$audit_run" --argjson transactionApplied "$transaction_applied" --argjson audit "$audit" --argjson measurementDurationMs "$(jq -r '.measurementDurationMs // "null"' <<<"$metrics")" --argjson probeDurationMs "$(jq -r '.probeDurationMs // "null"' <<<"$metrics")" '{schemaVersion:1,time:now,runId:$runId,result:$result,mode:$mode,sourcePolicy:$policy,bestIps:$best,proxyMode:$mode,adaptiveMode:(if $adaptiveEffectiveMode=="" then null else $adaptiveEffectiveMode end),candidateMode:(if $candidateEffectiveMode=="" then null else $candidateEffectiveMode end),adaptiveRequestedMode:(if $adaptiveRequestedMode=="" then null else $adaptiveRequestedMode end),candidateRequestedMode:(if $candidateRequestedMode=="" then null else $candidateRequestedMode end),adaptiveQualificationState:(if $adaptiveQualificationState=="null" then null else $adaptiveQualificationState end),candidateQualificationState:(if $candidateQualificationState=="null" then null else $candidateQualificationState end),contextFingerprint:(if $contextFingerprint=="" then null else $contextFingerprint end),fullCandidateCount:$fullCandidateCount,plannedK:$plannedK,actualUniqueProbeCount:$actualUniqueProbeCount,fallbackUsed:$fallbackUsed,expansionCount:$expansionCount,measurementDurationMs:$measurementDurationMs,transactionApplied:$transactionApplied,auditRun:$auditRun,winnerRecall:($audit.winnerRecall // null),topNRecall:($audit.topNRecall // null),severeMiss:($audit.severeMiss // null)}' >>"$CFIP_RUN_HISTORY"
    tail -n 100 "$CFIP_RUN_HISTORY" >"$CFIP_RUN_HISTORY.tmp" 2>/dev/null && mv "$CFIP_RUN_HISTORY.tmp" "$CFIP_RUN_HISTORY" || true
    declare -F cfip_operational_record_run >/dev/null 2>&1 && cfip_operational_record_run "${CFIP_OPERATIONAL_FINAL_EVENT:-completed-run}" "${CFIP_OPERATIONAL_FINAL_REASON:-$CFIP_LAST_RESULT}" || true
}

apply_startup_delay(){ local d="$CFIP_STARTUP_DELAY"; [[ "${CFIP_SKIP_STARTUP_DELAY:-false}" == true ]] && return 0; [[ -z "$d" || "$d" == 0 ]] && return 0; [[ "$d" == random ]] && d=300; [[ "$d" =~ ^[0-9]+$ ]] || return 1; ((d>0)) && sleep $((RANDOM%(d+1))); }

ensure_cfst(){
    [[ -x "$CFIP_WORK_DIR/cfst/cfst" ]] && return 0
    [[ -x "$CFIP_LEGACY_BIN" ]] || return 1
    local timeout="${CFIP_CFST_INSTALL_TIMEOUT:-120}"
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=120
    cfip_run_with_timeout "$timeout" env WORK_DIR_OVERRIDE="$CFIP_WORK_DIR" "$CFIP_LEGACY_BIN" --download-cfst >/dev/null
}

run_cfst() {
    local cfst="$CFIP_WORK_DIR/cfst/cfst" out="$CFIP_RUNTIME_DIR/cfst-$CFIP_RUN_ID.csv" input="$CFIP_CANDIDATE_INPUT_FILE" remaining rc=0 workdir=""
    local -a args
    [[ -x "$cfst" && -s "$CFIP_CANDIDATE_INPUT_FILE" ]] || return 1
    cfip_cfst_invocation_record
    args=(-f "$CFIP_CANDIDATE_INPUT_FILE" -n "$CFIP_SPEEDTEST_THREADS" -t "$CFIP_SPEEDTEST_PING_COUNT" -dn "$CFIP_SPEEDTEST_DN" -dt "$CFIP_SPEEDTEST_DT" -tll "$CFIP_SPEEDTEST_TLL")
    if [[ "$CFIP_SPEEDTEST_PROTOCOL" == http ]]; then
        args+=(-httping)
        [[ -n "$CFIP_SPEEDTEST_CFCOLO" ]] && args+=(-cfcolo "$CFIP_SPEEDTEST_CFCOLO")
    fi
    [[ -n "$CFIP_SPEEDTEST_TL" ]] && args+=(-tl "$CFIP_SPEEDTEST_TL")
    if [[ "${CFIP_OPENCLASH_BYPASS_ACTIVE:-false}" == true ]]; then
        workdir="$(mktemp -d "${TMPDIR:-/tmp}/cfip-probe-${CFIP_RUN_ID}.XXXXXX")" || return 1
        chown "$CFIP_OPENCLASH_BYPASS_UID:$CFIP_OPENCLASH_BYPASS_GID" "$workdir" || { rm -rf "$workdir"; return 1; }
        chmod 700 "$workdir"
        input="$workdir/candidates.txt"
        out="$workdir/cfst.csv"
        cp "$CFIP_CANDIDATE_INPUT_FILE" "$input" && chown "$CFIP_OPENCLASH_BYPASS_UID:$CFIP_OPENCLASH_BYPASS_GID" "$input" && chmod 600 "$input" || { rm -rf "$workdir"; return 1; }
        args=(-f "$input" "${args[@]:2}")
    fi
    args+=(-o "$out")
    remaining="$(cfip_deadline_remaining)"; ((remaining>0)) || { [[ -z "$workdir" ]] || rm -rf "$workdir"; return 124; }
    if [[ "${CFIP_OPENCLASH_BYPASS_ACTIVE:-false}" == true ]]; then
        cfip_openclash_measurement_bypass_assert || { [[ -z "$workdir" ]] || rm -rf "$workdir"; return 125; }
        cfip_run_with_timeout "$remaining" start-stop-daemon -S -c \
            "$CFIP_OPENCLASH_BYPASS_USER:$CFIP_OPENCLASH_BYPASS_GROUP" \
            -x "$CFIP_PROBE_EXEC" -- "$cfst" "${args[@]}" >/dev/null 2>&1 || rc=$?
    else
        cfip_run_with_timeout "$remaining" "$cfst" "${args[@]}" >/dev/null 2>&1 || rc=$?
    fi
    if ((rc==124)); then [[ -z "$workdir" ]] || rm -rf "$workdir"; return 124; fi
    if [[ "${CFIP_OPENCLASH_BYPASS_ACTIVE:-false}" == true ]] && ! cfip_openclash_measurement_bypass_assert; then
        CFIP_OPENCLASH_SERVICE_ERROR="${CFIP_OPENCLASH_BYPASS_ERROR:-OpenClash bypass changed during CloudflareSpeedTest; measurements discarded}"
        rm -rf "$workdir"
        return 125
    fi
    [[ -s "$out" ]] || { [[ -z "$workdir" ]] || rm -rf "$workdir"; return 2; }
    cfip_parse_cfst "$CFIP_CANDIDATES_FILE" "$CFIP_SPEEDTEST_PROTOCOL" "$CFIP_PROBE_TOP_COUNT" "$out:auto"
    local parse_rc=$?
    if [[ -n "$workdir" ]]; then rm -rf "$workdir"; else rm -f "$out"; fi
    return "$parse_rc"
}

cfip_dns_maintenance_begin(){
    [[ -x "$CFIP_DNS_GUARD_BIN" ]] || return 0
    [[ "$CFIP_DNS_MAINTENANCE_ACTIVE" == true ]] && return 0
    local txn_id="${CFIP_RUN_ID:-cf-ip-$$}"
    txn_id="$(printf '%s' "$txn_id" | tr -cd 'A-Za-z0-9._:')"
    [[ -n "$txn_id" ]] || txn_id="cf-ip-$$"
    [[ "$CFIP_DNS_MAINTENANCE_TTL" =~ ^[1-9][0-9]{0,2}$ ]] && ((CFIP_DNS_MAINTENANCE_TTL <= 180)) || {
        CFIP_DNS_MAINTENANCE_ERROR="invalid DNS maintenance lease TTL"
        return 1
    }
    if ! "$CFIP_DNS_GUARD_BIN" --maintenance-begin "$txn_id" "$CFIP_DNS_MAINTENANCE_TTL" >/dev/null 2>&1; then
        CFIP_DNS_MAINTENANCE_ERROR="DNS guard refused the bounded maintenance lease; OpenClash was not stopped"
        return 1
    fi
    CFIP_DNS_MAINTENANCE_ID="$txn_id"
    CFIP_DNS_MAINTENANCE_ACTIVE=true
    CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=false
    CFIP_DNS_MAINTENANCE_ERROR=""
}

cfip_dns_maintenance_end(){
    [[ "$CFIP_DNS_MAINTENANCE_ACTIVE" == true ]] || return 0
    if ! "$CFIP_DNS_GUARD_BIN" --maintenance-end "$CFIP_DNS_MAINTENANCE_ID" >/dev/null 2>&1; then
        CFIP_DNS_MAINTENANCE_ERROR="DNS guard maintenance lease did not release cleanly; the owner-bound lease will still expire or fail closed"
        return 1
    fi
    CFIP_DNS_MAINTENANCE_ACTIVE=false
    CFIP_DNS_MAINTENANCE_ID=""
    CFIP_DNS_MAINTENANCE_ERROR=""
    CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=false
}

stop_service_for_measurement(){
    if [[ "$CFIP_MODE" == openclash ]]; then
        [[ "${CFIP_OPENCLASH_EXPECTED_ENABLED:-}" == 1 ]] || return 0
        if [[ "${CFIP_OPENCLASH_MEASUREMENT_BYPASS_DISABLED:-false}" != true ]] && cfip_openclash_measurement_bypass_begin; then
            cfip_log "OpenClash measurement bypass active: low-privilege uid=${CFIP_OPENCLASH_BYPASS_UID}, non-OpenClash-exempt gid=${CFIP_OPENCLASH_BYPASS_GID}, candidate TCP/443 only; no proxy restart"
            return 0
        fi
        [[ "$CFIP_STOP_SERVICE" == true ]] || {
            CFIP_OPENCLASH_SERVICE_ERROR="${CFIP_OPENCLASH_BYPASS_ERROR:-OpenClash measurement bypass is unavailable and stop_service is disabled}"
            return 1
        }
        [[ -z "${CFIP_OPENCLASH_BYPASS_ERROR:-}" ]] || cfip_log "OpenClash measurement bypass unavailable; using explicit maintenance stop: $CFIP_OPENCLASH_BYPASS_ERROR"
        [[ "$CFIP_STOP_SERVICE" == true ]] || return 0
        CFIP_OPENCLASH_SERVICE_ERROR=""
        if ! cfip_openclash_health_wait 10; then
            CFIP_OPENCLASH_SERVICE_ERROR="OpenClash became unhealthy before stop; no node file was changed"
            return 1
        fi
        cfip_dns_maintenance_begin || {
            CFIP_OPENCLASH_SERVICE_ERROR="${CFIP_DNS_MAINTENANCE_ERROR:-DNS maintenance lease could not be acquired}"
            return 1
        }
        cfip_stop_service openclash || {
            if [[ "${CFIP_OPENCLASH_CF_STOPPED:-false}" == true ]]; then
                CFIP_STOPPED_MODE=openclash
            else
                CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=true
                cfip_dns_maintenance_end || cfip_log "$CFIP_DNS_MAINTENANCE_ERROR"
            fi
            return 1
        }
        CFIP_STOPPED_MODE=openclash
        return 0
    fi
    if cfip_service_running "$CFIP_MODE" measurement; then
        [[ "$CFIP_STOP_SERVICE" == true ]] || {
            CFIP_MEASUREMENT_ERROR="${CFIP_MODE} online measurement bypass is not verified; refusing to measure through the running proxy. Enable the explicit maintenance stop option to accept a temporary outage"
            return 1
        }
        CFIP_STOPPED_MODE="$CFIP_MODE"
        cfip_stop_service "$CFIP_MODE" || return 1
    fi
}
restore_stopped_service_if_needed(){
    [[ -n "$CFIP_STOPPED_MODE" ]] || return 0
    cfip_begin_recovery
    local service="$CFIP_STOPPED_MODE" rc=0 old_config="${CFIP_OPENCLASH_RUNTIME_CONFIG:-}" old_target="${CFIP_OPENCLASH_TARGET_CONFIG:-}" old_provider="${CFIP_OPENCLASH_PROVIDER_NAME:-}"
    [[ "$service" == openclash ]] && CFIP_OPENCLASH_RECOVERY_ATTEMPTED=true
    cfip_restart_service "$service" recovery || rc=$?
    if ((rc==0)); then
        # A successful bounded start means the service is running again. Drop
        # stop ownership before any DNS lease release attempt so an end failure
        # can never make cleanup restart the already-running core a second time.
        [[ "$service" != openclash ]] || { CFIP_STOPPED_MODE=""; CFIP_OPENCLASH_CF_STOPPED=false; }
        if [[ "$service" == openclash ]]; then
            cfip_openclash_capture_runtime && cfip_openclash_resolve_provider_target || rc=1
            if ((rc==0)) && [[ "$CFIP_OPENCLASH_RUNTIME_CONFIG" != "$old_config" || "$CFIP_OPENCLASH_TARGET_CONFIG" != "$old_target" || "$CFIP_OPENCLASH_PROVIDER_NAME" != "$old_provider" ]]; then
                CFIP_OPENCLASH_SERVICE_ERROR="OpenClash maintenance restart changed core config or provider identity"
                rc=1
            fi
            if ((rc==0)); then
                CFIP_OPENCLASH_SERVICE_APPLIED=true
                CFIP_OPENCLASH_MAINTENANCE_RESTARTED=true
                CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=true
                cfip_dns_maintenance_end || {
                    CFIP_OPENCLASH_SERVICE_ERROR="$CFIP_DNS_MAINTENANCE_ERROR"
                    rc=1
                }
            fi
        fi
    fi
    if ((rc==0)); then
        CFIP_STOPPED_MODE=""
    elif ((rc==124)); then
        CFIP_RECOVERY_ERROR="${CFIP_OPENCLASH_SERVICE_ERROR:-RecoveryTimeout}"
    else
        CFIP_RECOVERY_ERROR="${CFIP_OPENCLASH_SERVICE_ERROR:-RecoveryRestartFailed}"
    fi
    return "$rc"
}
cfip_dns_maintenance_cleanup(){
    [[ "${CFIP_DNS_MAINTENANCE_ACTIVE:-false}" == true && "${CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED:-false}" == true && -z "${CFIP_STOPPED_MODE:-}" ]] || return 0
    cfip_dns_maintenance_end
}

build_decision() {
    local effective="$CFIP_RILL_MODE" reason="" rill_candidates='[]' generation=null decision_id='' selected_action_id='' rill_selected_action_id='' authority_id='' native_order selected_order rill_order safe_count=0 agreement=false top3_overlap=0 confidence_level=low confidence_reasons='[]'
    [[ "$CFIP_RILL_ENABLED" == true ]] || effective=off
    if [[ -s "$CFIP_RILL_FILE" ]] && jq -e '.success==true' "$CFIP_RILL_FILE" >/dev/null 2>&1; then
        rill_candidates="$(jq '.candidates' "$CFIP_RILL_FILE")"
        generation="$(jq '.generation//null' "$CFIP_RILL_FILE")"
        decision_id="$(jq -r '.decisionId // empty' "$CFIP_RILL_FILE")"
        rill_selected_action_id="$(jq -r '.selectedActionId // empty' "$CFIP_RILL_FILE")"
    else
        [[ "$effective" != off ]] && reason="${reason:-rill_unavailable_or_error}"
    fi
    if [[ "$effective" == assisted ]] && ! cfip_rill_qualified; then effective=shadow; reason="${reason:-assisted_not_qualified}"; fi
    if [[ "$effective" == assisted ]] && ! cfip_rill_assisted_ready; then
        local runtime_status
        runtime_status="$(cfip_rill_status_json 2>/dev/null || printf '{}')"
        effective=shadow
        if [[ "$(jq -r '.resourcePressure // false' <<<"$runtime_status")" == true ]]; then reason="${reason:-runtime_resource_pressure}"
        elif [[ "$(jq -r '.available // false' <<<"$runtime_status")" != true ]]; then reason="${reason:-runtime_unavailable}"
        elif [[ "$(jq -r '.healthHealthy // false' <<<"$runtime_status")" != true ]]; then reason="${reason:-runtime_unhealthy}"
        else reason="${reason:-runtime_health_or_generation_gate}"; fi
    fi
    native_order="$(jq '[.[].ip]' "$CFIP_NATIVE_FILE")"
    selected_order="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")"
    authority_id="$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")"
    rill_order="$(jq -c '[.[]|select(.rillRank != null)|.ip]' <<<"$rill_candidates" 2>/dev/null || printf '[]')"
    safe_count="$(jq -r --argjson k "$CFIP_RILL_SAFE_TOP_K" '.[0:$k]|length' "$CFIP_NATIVE_FILE")"
    [[ "$(jq -r '.[0] // empty' <<<"$native_order")" == "$(jq -r '.[0] // empty' <<<"$rill_order")" ]] && agreement=true
    top3_overlap="$(jq -cn --argjson native "$native_order" --argjson rill "$rill_order" '([ $native[0:3][] ] | unique) as $n | ([ $rill[0:3][] ] | unique) as $r | ([$n[] as $x | select($r|index($x))] | length)' 2>/dev/null || printf 0)"
    if [[ "$effective" == assisted ]]; then
        selected_action_id="$authority_id"
    else
        selected_action_id="$rill_selected_action_id"
    fi
    # Native selection remains the safety boundary. If a caller ever invokes
    # this function after a partial Candidate mutation, a failed health,
    # qualification, or resource gate still restores the transaction input to
    # the Native selection before the immutable decision is written.
    if [[ "$effective" != assisted ]]; then
        jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        selected_order="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")"
        authority_id="$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")"
    fi
    if [[ "$effective" == assisted ]]; then
        confidence_level=high; confidence_reasons='["qualification_valid","runtime_healthy","inside_native_safe_envelope","context_current"]'
        # Stale evidence keeps the candidate in charge but must not keep
        # claiming high confidence: the last comparable evaluation is old
        # enough that today's ranking is only weakly corroborated.
        if [[ "$(cfip_rill_qualification_freshness 2>/dev/null || printf none)" == stale ]]; then
            confidence_level=medium
            confidence_reasons='["qualification_valid","runtime_healthy","inside_native_safe_envelope","evaluation_stale"]'
        fi
    elif [[ "$effective" == shadow ]]; then
        confidence_level=medium; confidence_reasons='["native_authority","candidate_observation_only"]'
        [[ -n "$reason" ]] && confidence_reasons="$(jq -cn --arg reason "$reason" '["native_authority",$reason]')"
    else
        confidence_level=low; confidence_reasons='["native_authority"]'
    fi
    jq -n --arg runId "$CFIP_RUN_ID" --arg requestedMode "$CFIP_RILL_MODE" --arg effectiveMode "$effective" --arg reason "$reason" --arg decisionId "$decision_id" --arg selectedActionId "$selected_action_id" --arg rillSelectedActionId "$rill_selected_action_id" --arg authorityActionId "$authority_id" --arg confidenceLevel "$confidence_level" --argjson confidenceReasons "$confidence_reasons" --argjson nativeOrder "$native_order" --argjson selectedOrder "$selected_order" --argjson rillOrder "$rill_order" --argjson generation "$generation" --argjson safeCount "$safe_count" --argjson agreement "$agreement" --argjson top3Overlap "$top3_overlap" '{schemaVersion:2,runId:$runId,decisionId:(if $decisionId=="" then null else $decisionId end),selectedActionId:(if $selectedActionId=="" then null else $selectedActionId end),rillSelectedActionId:(if $rillSelectedActionId=="" then null else $rillSelectedActionId end),authorityActionId:(if $authorityActionId=="" then null else $authorityActionId end),requestedMode:$requestedMode,effectiveMode:$effectiveMode,fallbackReason:(if $reason=="" then null else $reason end),generation:$generation,rillOrder:$rillOrder,nativeOrder:$nativeOrder,selectedOrder:$selectedOrder,safeEnvelopeSize:$safeCount,nativeRillTop1Agreement:$agreement,rillTop3Overlap:$top3Overlap,confidenceLevel:$confidenceLevel,confidenceReasons:$confidenceReasons,shadowInvariant:($effectiveMode!="shadow" or $selectedOrder==($nativeOrder[0:($selectedOrder|length)]))}' | cfip_atomic_write "$CFIP_DECISION_FILE"
}

select_assisted_candidates() {
    [[ "$CFIP_RILL_MODE" == assisted ]] || return 0
    if ! cfip_rill_qualified; then
        [[ -s "$CFIP_NATIVE_FILE" ]] && jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        return 0
    fi
    # Do not mutate CFIP_SELECTED_FILE until Runtime health, schema/model,
    # reset, and resource-pressure checks have all passed.
    if ! cfip_rill_assisted_ready; then
        [[ -s "$CFIP_NATIVE_FILE" ]] && jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
        return 0
    fi
    local safe selected ids history
    history="$(cfip_rill_history_json)"
    safe="$(jq --argjson k "$CFIP_RILL_SAFE_TOP_K" --argjson history "$(cfip_rill_history_json)" '.[0:$k] | map(select(.eligible==true and ((.probeSummary.lossRate // .lossRate // 0) <= 0.25) and ((.probeSummary.ttfbMs // 0) <= 3000) and ((.probeSummary.totalMs // 0) <= 5000) and (($history[.ip].consecutiveFailures // 0) < 3)))' "$CFIP_NATIVE_FILE")"
    ids="$(jq -c '[.[].ip]' <<<"$safe")"; [[ "$(jq 'length' <<<"$safe")" -gt 0 ]] || return 0
    selected="$(jq --argjson ids "$ids" --argjson history "$history" --argjson count "$CFIP_IP_COUNT" --argjson cap "${CFIP_RILL_UNSEEN_CANDIDATE_CAP:-1}" '
      def prefix:
        if (.family // "") == "ipv6" then ((.ip|tostring)|split(":")[0:4]|join(":"))
        else ((.ip|tostring)|split(".")[0:3]|join(".")) end;
      def source: (.sourceClass // .origin // "unknown");
      [.candidates[] | select(.ip as $ip | ($ids|index($ip)))] | sort_by(.rillRank // 99999) |
      .[0] as $primary |
      (if $primary then
        (reduce .[1:][] as $candidate ({chosen:[$primary],deferred:[],unseen:0};
          if (.chosen|length) >= $count then .
          else ($candidate.ip|tostring) as $id |
            (($history[$id].successCount//0)+($history[$id].failureCount//0) == 0) as $is_unseen |
            if ($is_unseen and .unseen >= $cap) then .deferred += [$candidate]
            else ($candidate|prefix) as $prefix | ($candidate|source) as $source |
              ([.chosen[]|prefix]|index($prefix)|not) as $newPrefix |
              ([.chosen[].family]|index($candidate.family)|not) as $newFamily |
              ([.chosen[]|source]|index($source)|not) as $newSource |
              if ($newPrefix or $newFamily or $newSource) then .chosen += [$candidate] | .unseen += (if $is_unseen then 1 else 0 end)
              else .deferred += [$candidate] end
            end
          end) | .chosen + (.deferred[:($count-(.chosen|length))]))
      else [] end)
    ' "$CFIP_RILL_FILE")"
    [[ "$(jq 'length' <<<"$selected")" -gt 0 ]] || return 0
    if [[ "$(jq 'length' <<<"$selected")" -lt "$CFIP_IP_COUNT" ]]; then
        selected="$(jq --argjson chosen "$selected" --argjson safe "$safe" --argjson count "$CFIP_IP_COUNT" '($chosen|map(.ip)) as $chosenIds | ($chosen + ($safe|map(select(.ip as $ip | ($chosenIds|index($ip)|not)))))[:$count]' <<<"$selected")"
    fi
    printf '%s\n' "$selected" | cfip_atomic_write "$CFIP_SELECTED_FILE"
}

rollback_active_transaction() {
    local recovery_rc=0
    [[ "${CFIP_CLEANUP_DONE:-false}" == true ]] && return 0
    if [[ "${CFIP_OPENCLASH_BYPASS_ACTIVE:-false}" == true ]]; then
        cfip_openclash_measurement_bypass_end || {
            CFIP_RECOVERY_ERROR="${CFIP_OPENCLASH_BYPASS_ERROR:-temporary OpenClash measurement rule cleanup failed}"
            recovery_rc=1
        }
    fi
    if [[ -n "${CFIP_TXN_DIR:-}" && -d "${CFIP_TXN_DIR:-}" && "${CFIP_TXN_COMMITTED:-false}" != true ]]; then
        cfip_txn_rollback "${CFIP_TXN_MODE:-$CFIP_MODE}" || recovery_rc=$?
    fi
    if [[ -n "$CFIP_STOPPED_MODE" ]]; then
        restore_stopped_service_if_needed || recovery_rc=$?
    fi
    CFIP_CLEANUP_DONE=true
    return "$recovery_rc"
}

fail_run(){ local message="$1" recovery_rc=0; [[ -n "${CFIP_OPENCLASH_SERVICE_ERROR:-}" && "$message" != *"$CFIP_OPENCLASH_SERVICE_ERROR"* ]] && message="$message; $CFIP_OPENCLASH_SERVICE_ERROR"; CFIP_LAST_RESULT=error; CFIP_ERROR="$message"; CFIP_OPERATIONAL_FINAL_EVENT=run-failed; CFIP_OPERATIONAL_FINAL_REASON="$message"; rollback_active_transaction || recovery_rc=$?; [[ -n "$CFIP_RECOVERY_ERROR" && "$message" != *"$CFIP_RECOVERY_ERROR"* ]] && message="$message; $CFIP_RECOVERY_ERROR"; CFIP_OPERATIONAL_FINAL_REASON="$message"; remember_history || true; write_status false failed error "$message" || true; cfip_log "run failed: $message"; ((recovery_rc==0)) || return 1; return 1; }
# Capture the prior cache under the shared writer lock without replacing it:
# the current-IP reuse gate must still inspect the previous successful result.
capture_run_status() {
    CFIP_RUN_STATUS_CAPTURED=false
    CFIP_START_STATUS_SHA=""; CFIP_START_STATUS_KIND=absent
    if [[ -e "$CFIP_STATUS_FILE" || -L "$CFIP_STATUS_FILE" ]]; then
        [[ -f "$CFIP_STATUS_FILE" && ! -L "$CFIP_STATUS_FILE" ]] || return 1
        CFIP_START_STATUS_SHA="$(sha256sum "$CFIP_STATUS_FILE" | awk '{print $1}')" || return 1
        [[ "$CFIP_START_STATUS_SHA" =~ ^[0-9a-f]{64}$ ]] || return 1
        CFIP_START_STATUS_KIND=file
    fi
    CFIP_RUN_STATUS_CAPTURED=true
}

run_status_matches_start() {
    local observed
    case "${CFIP_START_STATUS_KIND:-}" in
        absent) [[ ! -e "$CFIP_STATUS_FILE" && ! -L "$CFIP_STATUS_FILE" ]] ;;
        file)
            [[ -f "$CFIP_STATUS_FILE" && ! -L "$CFIP_STATUS_FILE" ]] || return 1
            observed="$(sha256sum "$CFIP_STATUS_FILE" | awk '{print $1}')" || return 1
            [[ "$observed" == "${CFIP_START_STATUS_SHA:-}" ]]
            ;;
        *) return 1 ;;
    esac
}

run_cleanup(){
    local rc="${1:-$?}" recovery_rc=0 publish_failure=false recorded_error="" message=""
    trap - EXIT INT TERM
    cfip_cancel_active_operation || true
    rollback_active_transaction || recovery_rc=$?
    cfip_dns_maintenance_cleanup || {
        CFIP_RECOVERY_ERROR="${CFIP_DNS_MAINTENANCE_ERROR:-DNS maintenance lease cleanup failed}"
        recovery_rc=1
    }
    if ((recovery_rc!=0)); then
        CFIP_RECOVERY_ERROR="${CFIP_RECOVERY_ERROR:-rollback or service restoration failed}"
        cfip_log "RECOVERY REQUIRED: ${CFIP_RECOVERY_ERROR}; transaction snapshot retained at ${CFIP_TXN_DIR:-unknown}"
        ((rc==0)) && rc=1
    fi
    if ((rc != 0)) && [[ -n "${CFIP_RUN_ID:-}" ]]; then
        if [[ "${CFIP_RUN_ENTERED:-false}" == true && "${CFIP_RUN_STATUS_CAPTURED:-false}" == true ]]; then
            if [[ "$(cat "$CFIP_LOCK_DIR/pid" 2>/dev/null)" != "$$" ]]; then
                cfip_log "lost writer lock: refusing task status publication for $CFIP_RUN_ID"
            elif [[ -f "$CFIP_STATUS_FILE" && ! -L "$CFIP_STATUS_FILE" ]] &&
                jq -e --arg runId "$CFIP_RUN_ID" '.runId==$runId' "$CFIP_STATUS_FILE" >/dev/null 2>&1; then
                publish_failure=true
                if jq -e '.active_run==false and .last_result=="error"' "$CFIP_STATUS_FILE" >/dev/null 2>&1; then
                    recorded_error="$(jq -r '.error // empty' "$CFIP_STATUS_FILE")"
                    # Preserve a more specific terminal error already recorded.
                    ((recovery_rc != 0)) || [[ -n "${CFIP_RECOVERY_ERROR:-}" ]] || publish_failure=false
                fi
            elif run_status_matches_start; then publish_failure=true
            else cfip_log "task status conflict: refusing to replace a changed or foreign observation for $CFIP_RUN_ID"; fi
        elif [[ "${CFIP_MODE:-}" == openclash && -f "${CFIP_STATUS_FILE:-}" && ! -L "$CFIP_STATUS_FILE" ]] &&
            jq -e --arg runId "$CFIP_RUN_ID" '.runId==$runId and .active_run==true' "$CFIP_STATUS_FILE" >/dev/null 2>&1; then
            # Keep the existing recovery-only behavior outside full run_v2.
            publish_failure=true
        fi
    fi
    if [[ "$publish_failure" == true ]]; then
        if [[ "${CFIP_MODE:-}" == openclash ]]; then message="OpenClash run interrupted or failed (rc=$rc)"
        else message="Run interrupted or failed (rc=$rc)"; fi
        message="${recorded_error:-${CFIP_ERROR:-$message}}"
        if [[ -n "${CFIP_RECOVERY_ERROR:-}" && "$message" != *"$CFIP_RECOVERY_ERROR"* ]]; then message="$message; recovery: $CFIP_RECOVERY_ERROR"; fi
        write_status false failed error "$message" || cfip_log "failed to publish terminal task status for $CFIP_RUN_ID"
    fi
    release_lock
    exit "$rc"
}
run_signal_cleanup(){ cfip_cancel_active_operation; run_cleanup 143; }

run_locked_entry(){
    local needs_config="$1"; shift
    acquire_lock || { cfip_json_error "$(cf_ip_writer_lock_message)"; return 1; }
    CFIP_CLEANUP_DONE=false
    trap 'run_cleanup "$?"' EXIT
    trap run_signal_cleanup INT TERM
    if [[ "$needs_config" == true ]]; then load_config || return 1; fi
    "$@"
}

sync_recovery_failure(){
    local message="$1" rc=0 recovery_required=false best='[]' service='null'
    rollback_active_transaction || rc=$?
    if ((rc!=0)); then
        recovery_required=true
        CFIP_RECOVERY_ERROR="${CFIP_RECOVERY_ERROR:-rollback or service restoration failed}"
        cfip_log "RECOVERY REQUIRED: ${CFIP_RECOVERY_ERROR}; transaction snapshot retained at ${CFIP_TXN_DIR:-unknown}"
    fi
    [[ -z "${CFIP_RECOVERY_ERROR:-}" ]] || recovery_required=true
    [[ -s "${CFIP_SELECTED_FILE:-}" ]] && best="$(jq '[.[].ip]' "$CFIP_SELECTED_FILE" 2>/dev/null || printf '[]')"
    if [[ "${CFIP_MODE:-}" == openclash ]]; then
        service="$(jq -cn --argjson enabled "${CFIP_OPENCLASH_EXPECTED_ENABLED:-null}" --argjson nodeFileWritten "${CFIP_OPENCLASH_FILE_WRITTEN:-false}" --argjson applied "${CFIP_OPENCLASH_SERVICE_APPLIED:-false}" --argjson deferred "${CFIP_OPENCLASH_DEFERRED:-false}" --argjson recoveryAttempted "${CFIP_OPENCLASH_RECOVERY_ATTEMPTED:-false}" --argjson recoveryVerified "${CFIP_OPENCLASH_RECOVERY_VERIFIED:-false}" --arg error "${CFIP_OPENCLASH_SERVICE_ERROR:-${CFIP_RECOVERY_ERROR:-}}" '{target:"openclash",expectedEnabled:$enabled,nodeFileWritten:$nodeFileWritten,serviceApplied:($applied and $nodeFileWritten),deferredUntilServiceStart:$deferred,recoveryAttempted:$recoveryAttempted,recoveryVerified:$recoveryVerified,error:(if $error=="" then null else $error end)}')"
    fi
    jq -cn --arg error "$message" --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson committed "${CFIP_TXN_COMMITTED:-false}" --argjson speedtestCompleted "${CFIP_SPEEDTEST_COMPLETED:-false}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --argjson recoveryRequired "$recovery_required" --argjson best "$best" --argjson service "$service" '{success:false,error:$error,configurationCommitted:$committed,speedtestCompleted:$speedtestCompleted,rolledBack:$rolledBack,recoveryRequired:$recoveryRequired,recoveryError:(if $recovery=="" then null else $recovery end),best_ips:$best,service:$service}'
    return 1
}

prepare_adaptive_final_selection() {
    [[ "${CFIP_ADAPTIVE_AUDIT_DUE:-false}" == true && -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] || return 0
    cfip_adaptive_patch_final_selection "$CFIP_ADAPTIVE_AUDIT_FILE" "$CFIP_SELECTED_FILE" "$CFIP_DECISION_FILE" false || cfip_log "adaptive final selection patch unavailable"
}

finalize_adaptive_audit() {
    local applied="${1:-false}"
    [[ "${CFIP_ADAPTIVE_AUDIT_DUE:-false}" == true && -s "${CFIP_ADAPTIVE_AUDIT_FILE:-}" ]] || return 0
    cfip_adaptive_patch_final_selection "$CFIP_ADAPTIVE_AUDIT_FILE" "$CFIP_SELECTED_FILE" "$CFIP_DECISION_FILE" "$applied" || { cfip_log "adaptive final selection patch unavailable"; return 0; }
    cfip_adaptive_record_audit "$CFIP_ADAPTIVE_AUDIT_FILE" || cfip_log "adaptive audit qualification update deferred"
}

# RPC receives this only after both committed config reads and lock acquisition.
# A missing reader must fail before context/transaction/user state changes.
acknowledge_run_start() {
    [[ -n "${CFIP_RUN_ACK_FD:-}" ]] || return 0
    [[ "$CFIP_RUN_ACK_FD" == 3 && -n "${CFIP_RUN_REQUEST_ID:-}" && -n "$CFIP_RUN_ID" ]] || return 1
    jq -cn --arg requestId "$CFIP_RUN_REQUEST_ID" --arg runId "$CFIP_RUN_ID" --argjson pid "$$" \
        '{success:true,action:"run",accepted:true,acknowledged:true,running:true,requestId:$requestId,runId:$runId,pid:$pid,observedAt:now}' >&3 || return 1
    exec 3>&-
    unset CFIP_RUN_ACK_FD
}

run_v2() {
    local reuse_allowed=true
    CFIP_RUN_ENTERED=false; CFIP_RUN_STATUS_CAPTURED=false; CFIP_ERROR=""
    CFIP_SPEEDTEST_COMPLETED=false
    CFIP_OPENCLASH_EXPECTED_ENABLED=""; CFIP_OPENCLASH_INITIAL_RUNNING=false; CFIP_OPENCLASH_INITIAL_HEALTHY=false; CFIP_OPENCLASH_DEFERRED=false; CFIP_OPENCLASH_CF_STOPPED=false; CFIP_OPENCLASH_RECOVERY_ATTEMPTED=false; CFIP_OPENCLASH_RECOVERY_VERIFIED=false; CFIP_OPENCLASH_RESTART_ATTEMPTS=0; CFIP_OPENCLASH_FILE_WRITTEN=false; CFIP_OPENCLASH_SERVICE_APPLIED=false; CFIP_OPENCLASH_HOT_APPLIED=false; CFIP_OPENCLASH_MAINTENANCE_RESTARTED=false; CFIP_DNS_MAINTENANCE_ACTIVE=false; CFIP_DNS_MAINTENANCE_ID=""; CFIP_DNS_MAINTENANCE_ERROR=""; CFIP_DNS_MAINTENANCE_RELEASE_ALLOWED=false; CFIP_OPENCLASH_SERVICE_ERROR=""; CFIP_RECOVERY_ERROR=""
    CFIP_HOMEPROXY_MAINTENANCE_RESTARTED=false; CFIP_PW2_MAINTENANCE_RESTARTED=false
    load_config || return 1
    # The boot delay must not hold the writer lock: an auto-run waiting here is
    # not an active task, so a manual "Run now" must not be reported as busy.
    apply_startup_delay || { cfip_json_error "invalid startup delay"; return 1; }
    acquire_lock || { cfip_json_error "$(cf_ip_writer_lock_message)"; return 1; }
    CFIP_CLEANUP_DONE=false
    trap 'run_cleanup "$?"' EXIT
    trap run_signal_cleanup INT TERM
    load_config || { cfip_json_error "failed to reload committed configuration"; return 1; }
    CFIP_RUN_ID="$(cfip_generate_run_id)" && [[ -n "$CFIP_RUN_ID" ]] || { cfip_json_error "failed to allocate run identity"; return 1; }
    capture_run_status || { cfip_json_error "failed to capture previous task status"; return 1; }
    acknowledge_run_start || { cfip_json_error "run startup acknowledgement failed"; return 1; }
    CFIP_RUN_ENTERED=true
    reconcile_committed_context || { CFIP_ERROR="${CFIP_ERROR:-failed to establish Rill learning context}"; cfip_json_error "$CFIP_ERROR"; return 1; }
    init_run_paths "$CFIP_RUN_ID" || { CFIP_ERROR="failed to initialize run workspace"; cfip_json_error "$CFIP_ERROR"; return 1; }
    cleanup_run_files
    cfip_rill_process_pending_feedback || cfip_log "pending Rill feedback processing deferred"
    CFIP_PHASE=preflight; CFIP_LAST_RESULT=running
    if [[ "$CFIP_MODE" == openclash ]]; then
        cfip_openclash_capture_state || { fail_run "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash preflight failed}"; return 1; }
        # Keep the CF task running normally when its target service is disabled.
        [[ "$CFIP_OPENCLASH_DEFERRED" != true ]] || reuse_allowed=false
    fi
    if [[ "$reuse_allowed" == true ]] && cfip_reuse_try_current; then
        # Reuse only revalidates the persisted candidate; it never applies it.
        # Modes without a verified hot-apply path therefore remain a warning.
        local reuse_result=success
        case "$CFIP_MODE" in
            passwall|passwall2|homeproxy) reuse_result=warning ;;
        esac
        CFIP_LAST_RESULT="$reuse_result"; CFIP_PHASE=done; CFIP_ERROR=""
        CFIP_OPERATIONAL_FINAL_EVENT=reuse-success; CFIP_OPERATIONAL_FINAL_REASON=validated_current_ip
        remember_history
        write_status false done "$reuse_result" ""
        release_lock
        trap - EXIT INT TERM
        jq -cn --arg runId "$CFIP_RUN_ID" --arg result "$reuse_result" --argjson best "$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")" --argjson requested "$CFIP_IP_COUNT" '{success:true,runId:$runId,best_ips:$best,eligible:($best|length),requested:$requested,reused:true,last_result:$result,speedtestCompleted:false,nodeFileWritten:false,serviceApplied:false,degraded:(($best|length)<$requested)}'
        return 0
    fi
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    CFIP_PHASE=acquiring
    ensure_cfst || { fail_run "failed to prepare CloudflareSpeedTest"; return 1; }
    cfip_prepare_candidate_pool "$CFIP_INPUT_POOL_FILE" "$CFIP_CANDIDATE_INPUT_FILE" "$CFIP_SOURCE_STATUS_FILE" || { fail_run "no candidate IPs available from enabled sources/cache"; return 1; }
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    CFIP_PHASE=measuring
    CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"
    CFIP_MEASUREMENT_STARTED_MS="$(cfip_now_millis)"
    CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT))
    cfip_txn_prepare "$CFIP_MODE" || { fail_run "${CFIP_RECOVERY_ERROR:-${CFIP_OPENCLASH_SERVICE_ERROR:-failed to snapshot proxy configuration}}"; return 1; }
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    stop_service_for_measurement || { fail_run "${CFIP_OPENCLASH_SERVICE_ERROR:-${CFIP_MEASUREMENT_ERROR:-failed to stop proxy service before measurement}}"; return 1; }
    local cfstrc=0
    run_cfst || cfstrc=$?
    if ((cfstrc!=0)); then
        if [[ "$cfstrc" == 124 ]]; then fail_run "measurement timeout during CloudflareSpeedTest"; else fail_run "no valid CloudflareSpeedTest candidates"; fi
        return 1
    fi
    CFIP_SPEEDTEST_COMPLETED=true
    CFIP_PHASE=probing
    write_status true "$CFIP_PHASE" "$CFIP_LAST_RESULT" ""
    cfip_rill_probe_priority "$CFIP_CANDIDATES_FILE" "$CFIP_PROBE_INPUT_FILE" || cp "$CFIP_CANDIDATES_FILE" "$CFIP_PROBE_INPUT_FILE"
    CFIP_ADAPTIVE_CONTEXT_FINGERPRINT="$(cfip_rill_context_fingerprint 2>/dev/null || printf '')"; CFIP_ADAPTIVE_NOW="$(date +%s)"
    CFIP_ADAPTIVE_EFFECTIVE_MODE="$(cfip_adaptive_effective_mode)"; CFIP_ADAPTIVE_AUDIT_DUE=false
    # Off is a hard no-side-effect mode: it does not advance audit cadence or
    # create qualification evidence. Shadow still records a plan, but keeps
    # the production input and probe behavior unchanged.
    if [[ "$CFIP_ADAPTIVE_MEASUREMENT_ENABLED" == true && "$CFIP_ADAPTIVE_MEASUREMENT_MODE" != off ]]; then
        if cfip_adaptive_note_run; then CFIP_ADAPTIVE_AUDIT_DUE=true; fi
    fi
    CFIP_ADAPTIVE_SCHEDULER_STARTED_MS="$(cfip_now_millis)"
    cfip_adaptive_prepare_probe_input "$CFIP_PROBE_INPUT_FILE" "$CFIP_ADAPTIVE_PROBE_INPUT_FILE" "$CFIP_ADAPTIVE_PLAN_FILE" || { fail_run "adaptive measurement planning failed"; return 1; }
    CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=$(( $(cfip_now_millis) - CFIP_ADAPTIVE_SCHEDULER_STARTED_MS )); ((CFIP_ADAPTIVE_SCHEDULER_DURATION_MS < 0)) && CFIP_ADAPTIVE_SCHEDULER_DURATION_MS=0
    CFIP_ADAPTIVE_PROBE_STARTED_MS="$(cfip_now_millis)"
    local eligible audit_rc=0
    if [[ "$CFIP_ADAPTIVE_AUDIT_DUE" == true ]]; then
        # An audit is the production run on this cadence. Probe the full
        # pre-probe pool once, rank that result, and use it for selection.
        cfip_probe_candidates "$CFIP_PROBE_INPUT_FILE" "$CFIP_PROBED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" || audit_rc=$?
        [[ -s "$CFIP_PROBED_FILE" ]] || printf '[]\n' | cfip_atomic_write "$CFIP_PROBED_FILE"
        cfip_adaptive_update_runtime "" "$(jq '.selectedK' "$CFIP_ADAPTIVE_PLAN_FILE")" 0
        cfip_rill_update_history "$CFIP_PROBED_FILE" || cfip_log "candidate history update deferred"
    else
        cfip_adaptive_probe "$CFIP_PROBE_INPUT_FILE" "$CFIP_PROBED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_IP_COUNT" "$CFIP_ADAPTIVE_EXPANSION_BATCH_SIZE" "$CFIP_ADAPTIVE_MAX_PROBE_COUNT" "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_PROBE_METRICS_FILE" "$CFIP_ADAPTIVE_EFFECTIVE_MODE" || { fail_run "candidate probing failed"; return 1; }
        cfip_rill_update_history "$CFIP_PROBED_FILE" || cfip_log "candidate history update deferred"
    fi
    CFIP_ADAPTIVE_PROBE_DURATION_MS=$(( $(cfip_now_millis) - CFIP_ADAPTIVE_PROBE_STARTED_MS )); ((CFIP_ADAPTIVE_PROBE_DURATION_MS < 0)) && CFIP_ADAPTIVE_PROBE_DURATION_MS=0
    CFIP_MEASUREMENT_DURATION_MS=$(( $(cfip_now_millis) - CFIP_MEASUREMENT_STARTED_MS )); ((CFIP_MEASUREMENT_DURATION_MS < 0)) && CFIP_MEASUREMENT_DURATION_MS=0
    cfip_adaptive_record_run_metrics "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_PROBED_FILE" "$CFIP_PROBE_METRICS_FILE" || cfip_log "adaptive operational metrics unavailable"
    [[ "$(cfip_deadline_remaining)" -gt 0 ]] || { fail_run "measurement timeout during target probe"; return 1; }
    if [[ "${CFIP_OPENCLASH_BYPASS_ACTIVE:-false}" == true ]]; then
        cfip_openclash_measurement_bypass_end || {
            fail_run "${CFIP_OPENCLASH_BYPASS_ERROR:-temporary OpenClash measurement bypass was lost; candidate results are invalid}"
            return 1
        }
    fi
    CFIP_PHASE=ranking
    cfip_native_rank "$CFIP_PROBED_FILE" "$CFIP_NATIVE_FILE" || { fail_run "native ranking failed"; return 1; }
    eligible="$(jq 'length' "$CFIP_NATIVE_FILE")"
    if [[ "$CFIP_ADAPTIVE_AUDIT_DUE" == true ]]; then
        cfip_adaptive_make_audit_record "$CFIP_ADAPTIVE_PLAN_FILE" "$CFIP_NATIVE_FILE" "$CFIP_PROBED_FILE" "$CFIP_ADAPTIVE_AUDIT_FILE" "$audit_rc" || cfip_log "adaptive audit diagnostic unavailable"
    fi
    ((eligible>0)) || { fail_run "NoEligibleCandidate: every target-domain probe failed"; return 1; }
    jq ".[0:${CFIP_IP_COUNT}]" "$CFIP_NATIVE_FILE" | cfip_atomic_write "$CFIP_SELECTED_FILE"
    if [[ "$CFIP_RILL_ENABLED" == true && "$CFIP_RILL_MODE" != off ]]; then
        cfip_rill_rank_shadow "$CFIP_NATIVE_FILE" "$CFIP_RILL_FILE" || true
    fi
    select_assisted_candidates
    build_decision
    prepare_adaptive_final_selection
    if [[ ( "$CFIP_MODE" == passwall && "$CFIP_STOPPED_MODE" == passwall ) || ( "$CFIP_MODE" == passwall2 && "$CFIP_STOPPED_MODE" == passwall2 ) ]]; then
        # PassWall has no verified hot-apply path. Restore the service with its
        # old runtime configuration before changing UCI, so a later failure can
        # roll back persistence without needing a proxy restart.
        restore_stopped_service_if_needed || { fail_run "PassWall measurement maintenance restart could not be verified"; return 1; }
        [[ "$CFIP_MODE" != passwall2 ]] || CFIP_PW2_MAINTENANCE_RESTARTED=true
    fi
    CFIP_PHASE=applying
    local txrc=0 holdout_json='{}'
    cfip_txn_apply "$CFIP_MODE" "$CFIP_SELECTED_FILE" || txrc=$?
    if ((txrc!=0)); then
        jq -cn --argjson rc "$txrc" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,rc:$rc,rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE" || true
        jq -cn --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"failure",censored:true,reason:"host_transaction_failed",observedIp:$ip,decisionActionId:$ip}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true
        finalize_adaptive_audit false
        fail_run "apply transaction failed (rc=$txrc)"
        return 1
    fi
    if [[ -n "$CFIP_STOPPED_MODE" ]]; then
        local maintenance_service="$CFIP_STOPPED_MODE"
        restore_stopped_service_if_needed || { fail_run "$maintenance_service maintenance restart could not be verified"; return 1; }
        [[ "$maintenance_service" != homeproxy ]] || CFIP_HOMEPROXY_MAINTENANCE_RESTARTED=true
    else
        CFIP_STOPPED_MODE=""
    fi
    CFIP_PHASE=verifying
    CFIP_DECISION_ACTION_ID="$(jq -r '.authorityActionId // .selectedActionId // empty' "$CFIP_DECISION_FILE")"
    if [[ "$CFIP_MODE" != passwall && "$CFIP_MODE" != passwall2 && "$CFIP_MODE" != homeproxy ]] && ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then
        cfip_rill_queue_feedback "$CFIP_DECISION_FILE" "$CFIP_OUTCOME_FILE" || true
        rollback_active_transaction || true
        jq -cn --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,reason:"post_apply_probe_failed",rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
        finalize_adaptive_audit false
        fail_run "post-apply validation failed"
        return 1
    fi
    if [[ "$CFIP_MODE" == passwall || "$CFIP_MODE" == passwall2 || "$CFIP_MODE" == homeproxy ]]; then
        local outcome_reason=passwall_runtime_apply_unverified
        [[ "$CFIP_MODE" != homeproxy ]] || outcome_reason=homeproxy_runtime_egress_unverified
        [[ "$CFIP_MODE" != passwall2 ]] || outcome_reason=passwall2_apply_pending
        jq -cn --arg reason "$outcome_reason" '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:$reason}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true
    fi
    CFIP_TXN_STATE=HEALTH_OK
    CFIP_MEASUREMENT_DEADLINE=0
    if ! cfip_txn_commit; then
        rollback_active_transaction || true
        jq -cn --argjson committed "${CFIP_TXN_COMMITTED:-false}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,reason:"transaction_commit_failed",configurationCommitted:$committed,rolledBack:$rolledBack,recoveryVerified:($recovery==""),recoveryError:(if $recovery=="" then null else $recovery end)}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
        finalize_adaptive_audit false
        fail_run "${CFIP_RECOVERY_ERROR:-transaction commit failed}"
        return 1
    fi
    jq -cn '{success:true,rolledBack:false,health:"validated"}' | cfip_atomic_write "$CFIP_TXN_RESULT_FILE"
    holdout_json="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/holdout.json"
    if [[ "$(jq -r '.effectiveMode // empty' "$CFIP_DECISION_FILE" 2>/dev/null)" == assisted ]]; then
        if ! cfip_rill_holdout "$CFIP_DECISION_FILE" "$CFIP_NATIVE_FILE" "$CFIP_OUTCOME_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$holdout_json"; then
            jq -cn '{performed:false,reason:"not_due_or_unavailable",feedbackEligible:false}' | cfip_atomic_write "$holdout_json"
        fi
    else
        jq -cn '{performed:false,reason:"effective_mode_not_assisted",feedbackEligible:false}' | cfip_atomic_write "$holdout_json"
    fi
    cfip_reuse_write_event full-optimize-success full_optimize_completed 0 0 "$CFIP_SELECTED_FILE" || cfip_log "reuse policy state update deferred"
    CFIP_PHASE=publishing
    cfip_publish_result "$CFIP_SELECTED_FILE" || cfip_log "LAN result publisher failed; network selection remains valid"
    CFIP_PHASE=feedback
    local feedback_file="$CFIP_OUTCOME_FILE" shadow_outcome=""
    if [[ "$(jq -r '.effectiveMode // empty' "$CFIP_DECISION_FILE" 2>/dev/null)" == shadow && -s "$CFIP_RILL_FILE" && -n "$(jq -r '.selectedActionId // empty' "$CFIP_DECISION_FILE")" && "$(jq -r '.selectedActionId // empty' "$CFIP_DECISION_FILE")" != "$(jq -r '.authorityActionId // empty' "$CFIP_DECISION_FILE")" ]]; then
        shadow_outcome="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-outcome.json"
        if cfip_rill_shadow_observe "$CFIP_DECISION_FILE" "$CFIP_RILL_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$shadow_outcome" "$CFIP_OUTCOME_FILE"; then
            feedback_file="$shadow_outcome"
        else
            cfip_log "shadow candidate observation unavailable; suppressing Candidate feedback"
            jq -cn --arg reason "shadow_observation_unavailable" '{feedbackEligible:false,observationUnavailable:true,reason:$reason,candidateOutcome:"unknown",hostOutcome:"success",censored:true}' | cfip_atomic_write "$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-observation-unavailable.json"
            feedback_file="$CFIP_RUNTIME_DIR/run-$CFIP_RUN_ID/shadow-observation-unavailable.json"
        fi
    fi
    if [[ "$CFIP_RILL_ENABLED" == true ]]; then
        cfip_rill_record_evidence "$CFIP_DECISION_FILE" "$feedback_file" "$(cat "$holdout_json" 2>/dev/null || printf '{}')" || cfip_log "Rill evidence store update deferred"
        cfip_rill_queue_feedback "$CFIP_DECISION_FILE" "$feedback_file" "$CFIP_TARGET_DOMAINS" || cfip_log "Rill delayed feedback queue unavailable"
    fi
    finalize_adaptive_audit true
    CFIP_OPERATIONAL_FINAL_EVENT=full-optimize-success; CFIP_OPERATIONAL_FINAL_REASON=full_optimize_completed
    local completion_notice="" completion_result=success service_json='null'
    if [[ "$CFIP_MODE" == openclash ]]; then
        local apply_method=none
        [[ "$CFIP_OPENCLASH_HOT_APPLIED" == true ]] && apply_method=file_provider_put
        [[ "$CFIP_OPENCLASH_MAINTENANCE_RESTARTED" == true ]] && apply_method=maintenance_restart
        [[ "$CFIP_OPENCLASH_DEFERRED" == true ]] && apply_method=deferred_until_service_start
        service_json="$(jq -cn --argjson enabled "$CFIP_OPENCLASH_EXPECTED_ENABLED" --argjson speedtest "$CFIP_SPEEDTEST_COMPLETED" --argjson bypassUsed "${CFIP_OPENCLASH_MEASUREMENT_BYPASS_USED:-false}" --argjson nodeFileWritten "$CFIP_OPENCLASH_FILE_WRITTEN" --argjson applied "$CFIP_OPENCLASH_SERVICE_APPLIED" --argjson hotApplied "$CFIP_OPENCLASH_HOT_APPLIED" --argjson maintenanceRestarted "$CFIP_OPENCLASH_MAINTENANCE_RESTARTED" --arg method "$apply_method" --argjson deferred "$CFIP_OPENCLASH_DEFERRED" --argjson recoveryAttempted "$CFIP_OPENCLASH_RECOVERY_ATTEMPTED" --argjson recoveryVerified "${CFIP_OPENCLASH_RECOVERY_VERIFIED:-false}" '{target:"openclash",expectedEnabled:$enabled,speedtestCompleted:$speedtest,measurementBypassUsed:$bypassUsed,nodeFileWritten:$nodeFileWritten,serviceApplied:($applied and $nodeFileWritten),hotApplied:$hotApplied,maintenanceRestarted:$maintenanceRestarted,applicationMethod:$method,deferredUntilServiceStart:$deferred,recoveryAttempted:$recoveryAttempted,recoveryVerified:$recoveryVerified}')"
        if [[ "$CFIP_OPENCLASH_DEFERRED" == true ]]; then
            completion_result=warning
            completion_notice="Nodes updated; OpenClash is disabled and the changes will take effect after it is started"
            CFIP_OPERATIONAL_FINAL_EVENT=nodes-updated-service-disabled; CFIP_OPERATIONAL_FINAL_REASON=openclash_disabled_pending
        fi
    elif [[ "$CFIP_MODE" == passwall ]]; then
        local maintenance_restarted=false
        [[ "${CFIP_TXN_ORIGINAL_RUNNING:-false}" == true && "${CFIP_SPEEDTEST_COMPLETED:-false}" == true && "$CFIP_STOP_SERVICE" == true ]] && maintenance_restarted=true
        service_json="$(jq -cn --argjson running "${CFIP_TXN_ORIGINAL_RUNNING:-false}" --argjson maintenanceRestarted "$maintenance_restarted" '{target:"passwall",configurationPersisted:true,serviceApplied:false,applyPending:true,maintenanceRestarted:$maintenanceRestarted,runtimeEgressVerified:false}')"
        completion_result=warning
        completion_notice="PassWall configuration was written but the running service was not hot-applied; apply it with a separately managed PassWall restart"
        CFIP_OPERATIONAL_FINAL_EVENT=passwall-config-persisted; CFIP_OPERATIONAL_FINAL_REASON=manual_apply_pending
    elif [[ "$CFIP_MODE" == passwall2 ]]; then
        local pw2_maintenance=false
        [[ "${CFIP_PW2_MAINTENANCE_RESTARTED:-false}" == true ]] && pw2_maintenance=true
        service_json="$(jq -cn --arg node "$CFIP_PW2_TARGET_NODE" --arg candidate "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" --argjson maintenance "$pw2_maintenance" '{target:"passwall2",configurationPersisted:true,serviceApplied:false,applyPending:true,maintenanceRestarted:$maintenance,applicationMethod:"persisted_only",updatedNodeCount:1,updatedNode:$node,appliedCandidate:$candidate,runtimeEgressVerified:false,restartCount:0}')"
        completion_result=warning
        completion_notice="PassWall2 UCI was persisted to one active graph leaf; the running service was not reloaded and runtime egress is unverified. The update remains pending."
        CFIP_OPERATIONAL_FINAL_EVENT=passwall2-config-persisted; CFIP_OPERATIONAL_FINAL_REASON=manual_apply_pending
    elif [[ "$CFIP_MODE" == homeproxy ]]; then
        local hp_maintenance=false hp_applied=false hp_method=none hp_restart_count=0
        [[ "${CFIP_HOMEPROXY_MAINTENANCE_RESTARTED:-false}" == true ]] && { hp_maintenance=true; hp_applied=true; hp_method=maintenance_restart; hp_restart_count=1; }
        service_json="$(jq -cn --arg node "$CFIP_HOMEPROXY_NODE_SECTION" --arg candidate "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" --argjson applied "$hp_applied" --argjson maintenance "$hp_maintenance" --arg method "$hp_method" --argjson restartCount "$hp_restart_count" '{target:"homeproxy",configurationPersisted:true,serviceApplied:$applied,applyPending:true,maintenanceRestarted:$maintenance,applicationMethod:$method,updatedNodeCount:1,updatedNode:$node,appliedCandidate:$candidate,runtimeEgressVerified:false,restartCount:$restartCount}')"
        completion_result=warning
        if [[ "$hp_maintenance" == true ]]; then
            completion_notice="HomeProxy was restored after the configured maintenance stop and loaded the persisted node; target-domain egress remains unverified."
        else
            completion_notice="HomeProxy UCI was persisted; the running service was not changed. Apply the node update through a separately managed HomeProxy action."
        fi
        CFIP_OPERATIONAL_FINAL_EVENT=homeproxy-config-persisted; CFIP_OPERATIONAL_FINAL_REASON=manual_apply_pending
    fi
    CFIP_LAST_RESULT="$completion_result"; CFIP_PHASE=done; CFIP_ERROR="$completion_notice"
    remember_history
    write_status false done "$completion_result" "$completion_notice"
    release_lock
    trap - EXIT INT TERM
    jq -cn --arg runId "$CFIP_RUN_ID" --arg result "$completion_result" --arg notice "$completion_notice" --argjson speedtestCompleted "$CFIP_SPEEDTEST_COMPLETED" --argjson service "$service_json" --argjson best "$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")" --argjson eligible "$eligible" --argjson requested "$CFIP_IP_COUNT" --argjson measured "$(jq 'length' "$CFIP_INPUT_POOL_FILE")" '{success:true,runId:$runId,best_ips:$best,measurement_input_count:$measured,eligible:$eligible,requested:$requested,degraded:($eligible<$requested),speedtestCompleted:$speedtestCompleted,last_result:$result,service:$service,warning:(if $notice=="" then null else $notice end)}'
}

cmd_status(){
    local version="" metadata work_dir cfst_installed=false passwall_installed=false passwall_running=false openclash_installed=false openclash_running=false homeproxy_env='{}' passwall2_env='{}'
    # Status must stay readable even when unrelated run configuration is invalid.
    work_dir="$(uci_get cf_ip.main.work_dir "$CFIP_WORK_DIR")"; [[ -n "$work_dir" ]] || work_dir=/usr/bin
    if [[ -x "$work_dir/cfst/cfst" ]]; then
        cfst_installed=true
        version="$(cfip_cfst_version "$work_dir/cfst/cfst" 2>/dev/null || true)"
    fi
    [[ -x "$CFIP_INIT_DIR/passwall" ]] && passwall_installed=true
    [[ "$passwall_installed" == true ]] && cfip_service_running passwall status && passwall_running=true
    [[ -x "$CFIP_INIT_DIR/openclash" ]] && openclash_installed=true
    [[ "$openclash_installed" == true ]] && cfip_service_running openclash status && openclash_running=true
    homeproxy_env="$(cfip_homeproxy_environment_json 2>/dev/null || printf '{}')"
    passwall2_env="$(cfip_pw2_environment_json 2>/dev/null || printf '{}')"
    metadata="$(jq -cn --arg script "$SCRIPT_VERSION" --arg packageVersion "$SCRIPT_VERSION-r$PACKAGE_RELEASE" --argjson homeproxy "$homeproxy_env" --argjson passwall2 "$passwall2_env" \
      --argjson tar "$(command -v tar >/dev/null 2>&1 && printf true || printf false)" \
      --argjson jq "$(command -v jq >/dev/null 2>&1 && printf true || printf false)" \
      --argjson cfst "$cfst_installed" \
      --argjson passwall "$passwall_installed" --argjson passwallRunning "$passwall_running" \
      --argjson openclash "$openclash_installed" --argjson openclashRunning "$openclash_running" \
      '{script_version:$script,package_version:$packageVersion,env:({tar:$tar,jq:$jq,cfst_installed:$cfst,passwall_installed:$passwall,passwall_running:$passwallRunning,openclash_installed:$openclash,openclash_running:$openclashRunning}+$homeproxy+$passwall2)}')" || return 1
    if [[ -f "$CFIP_STATUS_FILE" ]]; then
        jq --argjson current "$metadata" --arg version "$version" '
          . + ($current|del(.env)) + {
            env:((if (.env|type)=="object" then .env else {} end) + $current.env),
            cfst_version:(if $version=="" then null else $version end)
          }' "$CFIP_STATUS_FILE"
        return
    fi
    jq -cn --argjson current "$metadata" --arg cfstVersion "$version" '$current + {schemaVersion:2,running:false,enabled:false,active_run:false,phase:"idle",last_result:"unknown",best_ips:[],cfst_version:(if $cfstVersion=="" then null else $cfstVersion end),intelligence:{available:false}}'
}
cmd_check_env(){
    local legacy='{}' homeproxy_env='{}' passwall2_env='{}'
    if [[ -x "$CFIP_LEGACY_BIN" ]]; then legacy="$("$CFIP_LEGACY_BIN" --check-env 2>/dev/null || printf '{}')"; fi
    jq -e 'type=="object"' <<<"$legacy" >/dev/null 2>&1 || legacy='{}'
    homeproxy_env="$(cfip_homeproxy_environment_json 2>/dev/null || printf '{}')"
    passwall2_env="$(cfip_pw2_environment_json 2>/dev/null || printf '{}')"
    jq -cn --argjson legacy "$legacy" --argjson homeproxy "$homeproxy_env" --argjson passwall2 "$passwall2_env" '$legacy+$homeproxy+$passwall2'
}
cmd_version(){ jq -cn --arg script "$SCRIPT_VERSION" --arg release "$PACKAGE_RELEASE" '{success:true,version:$script,script_version:$script,package_release:$release,package_version:($script+"-r"+$release),engine_schema:2,runtime_api_version:3}'; }
cmd_clear_log(){ mkdir -p "${CFIP_LOG_FILE%/*}"; : >"$CFIP_LOG_FILE"; rm -rf "${CFIP_RUNTIME_DIR}/log_state" 2>/dev/null || true; jq -cn '{success:true,cleared:true}'; }
cmd_ip_history(){ local runs='[]' legacy='{}'; [[ -f "$CFIP_RUN_HISTORY" ]] && runs="$(tail -n 100 "$CFIP_RUN_HISTORY" | jq -s '.' 2>/dev/null || printf '[]')"; [[ -x "$CFIP_LEGACY_BIN" ]] && legacy="$("$CFIP_LEGACY_BIN" --ip-history 2>/dev/null || printf '{}')"; jq -n --argjson runs "$runs" --argjson legacy "$legacy" '{success:true,runs:$runs,ips:($legacy.ips//[])}'; }
cmd_download_cfst(){
    load_config aux >/dev/null || { cfip_json_error "configuration rejected"; return 1; }
    local timeout="${CFIP_CFST_INSTALL_TIMEOUT:-120}" out rc=0
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=120
    out="$(cfip_run_with_timeout "$timeout" env WORK_DIR_OVERRIDE="$CFIP_WORK_DIR" "$CFIP_LEGACY_BIN" --download-cfst 2>/dev/null)" || rc=$?
    if ((rc != 0)); then
        cfip_json_error "CloudflareSpeedTest install timed out or failed (rc=$rc)"
        return 1
    fi
    printf '%s\n' "$out"
}
cmd_source_status(){ cfip_source_status_json | jq -c '{success:true,sources:.}'; }
cmd_publisher_status(){ load_config aux >/dev/null || return 1; cfip_publisher_status_json; }
cmd_source_registry(){ cfip_builtin_registry_json | jq -c '{success:true,presets:.}'; }
cmd_rill_self_check(){
    load_config aux >/dev/null || return 1
    CFIP_RILL_READONLY=true
    local status inspect
    status="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    inspect='{}'
    if [[ "$(jq -r '.available // false' <<<"$status")" == true ]]; then
        inspect="$(cfip_rill_inspect_json 2>/dev/null || printf '{}')"
    fi
    jq -cn --argjson status "$status" --argjson inspect "$inspect" \
        '{success:($status.available==true),status:$status,inspect:$inspect}'
}
cmd_rill_diagnostics(){
    load_config aux >/dev/null || return 1
    CFIP_RILL_READONLY=true
    local status qualification pending meta source_policy reuse recent prefix_history colo_history prefix_summary colo_summary context evidence aggregate operational_history operational
    status="$(cfip_rill_status_json 2>/dev/null || printf '{"available":false,"state":"error"}')"
    qualification="$(cfip_rill_qualification_json 2>/dev/null || printf '{}')"
    pending='[]'; [[ -s "$CFIP_RILL_PENDING_FILE" ]] && pending="$(cat "$CFIP_RILL_PENDING_FILE")"
    meta='{}'; [[ -s "$CFIP_RILL_STATE_META_FILE" ]] && meta="$(cat "$CFIP_RILL_STATE_META_FILE")"
    source_policy="$(cfip_source_policy_json 2>/dev/null || printf '{}')"
    reuse='{}'; [[ -s "$CFIP_REUSE_STATE_FILE" ]] && reuse="$(cat "$CFIP_REUSE_STATE_FILE")"
    prefix_history="$(cfip_rill_prefix_history_json 2>/dev/null || printf '{}')"; colo_history="$(cfip_rill_colo_history_json 2>/dev/null || printf '{"entries":{},"unknownCount":0}')"
    prefix_summary="$(jq -cn --argjson h "$prefix_history" --argjson now "$(date +%s)" '{trackedPrefixes:($h|length),recentHighQuality:([$h|to_entries[]|select((.value.successRate//0)<=1)|{prefix:.key,samples:(.value.samples//0),successRate:(.value.successRate//0)}]|sort_by(-.successRate,-.samples)|.[0:5]),recentLowQuality:([$h|to_entries[]|select((.value.successRate//0)<=1)|{prefix:.key,samples:(.value.samples//0),successRate:(.value.successRate//0),lastSeen:(.value.lastSeen//0)}]|sort_by(.successRate,.lastSeen)|.[0:5])}')"
    colo_summary="$(jq -cn --argjson h "$colo_history" '{observedColoCount:($h.entries|length),latestObservedColo:($h.lastObserved//null),unknownCount:($h.unknownCount//0),history:($h.entries//{})}')"
    context="$(cfip_rill_context_json 2>/dev/null || printf '{}')"; evidence="$(cfip_rill_evidence_json 2>/dev/null || printf '[]')"; aggregate="$(cfip_rill_evidence_aggregate_json 2>/dev/null || printf '{}')"
    recent='[]'; [[ -f "$CFIP_RUN_HISTORY" ]] && recent="$(tail -n 20 "$CFIP_RUN_HISTORY" | jq -sc '.' 2>/dev/null || printf '[]')"
    operational_history="$(cfip_operational_history_json 2>/dev/null || printf '{"schemaVersion":1,"records":[]}')"; operational="$(cfip_operational_state_json 2>/dev/null || printf '{}')"
    jq -cn --argjson status "$status" --argjson qualification "$qualification" --argjson pending "$pending" --argjson meta "$meta" --argjson sourcePolicy "$source_policy" --argjson reuse "$reuse" --argjson recent "$recent" --argjson prefix "$prefix_summary" --argjson colo "$colo_summary" --argjson context "$context" --argjson evidence "$evidence" --argjson aggregate "$aggregate" --argjson operationalHistory "$operational_history" --argjson operationalHealth "$operational" \
        '{success:true,runtime:$status,qualification:$qualification,recentDecisions:$recent,operationalHistory:$operationalHistory,operationalHealth:$operationalHealth,pendingFeedback:($pending[0:64]),sourcePolicy:$sourcePolicy,reusePolicy:$reuse,prefixIntelligence:$prefix,coloIntelligence:$colo,stateMeta:$meta,learningContext:$context,evidenceAggregate:$aggregate,evidenceWindow:$evidence,warnings:[]}'
}
cmd_rill_reset(){
    load_config aux || return 1
    local expected="${1:-}" actual stamp quarantine
    actual="$(cfip_rill_state_generation)"
    [[ -z "$expected" || "$expected" == "$actual" ]] || { cfip_json_error "state generation changed; refresh before reset"; return 1; }
    mkdir -p "${CFIP_RILL_STATE%/*}" "$CFIP_RILL_BASE_DIR"
    if [[ -e "$CFIP_RILL_STATE" ]]; then
        stamp="$(date +%Y%m%d%H%M%S)"
        quarantine="$(cfip_unique_path "${CFIP_RILL_STATE}.quarantine.${stamp}")"
        mv "$CFIP_RILL_STATE" "$quarantine" || { cfip_json_error "failed to quarantine Rill state"; return 1; }
    else
        quarantine=''
    fi
    jq -cn --arg reason "manual_reset" --arg from "$quarantine" --argjson schema "$CFIP_RILL_SCHEMA_VERSION" \
        '{resetRequired:false,resetReason:$reason,migratedFrom:(if $from=="" then null else $from end),quarantinedState:($from!=""),featureSchemaVersion:$schema,at:(now|floor)}' \
        | cfip_atomic_write "$CFIP_RILL_STATE_META_FILE"
    cfip_rill_rotate_lineage manual_reset || { cfip_json_error "failed to rotate Rill state lineage"; return 1; }
    rm -f "$CFIP_RILL_QUALIFICATION_FILE" "$CFIP_RILL_PENDING_FILE"
    jq -cn --arg generation "$actual" --arg quarantine "$quarantine" '{success:true,reset:true,previousStateGeneration:($generation|tonumber),quarantinedState:(if $quarantine=="" then null else $quarantine end)}'
}

backup_id_valid(){ [[ "${1:-}" =~ ^[0-9]{14}([.][A-Za-z0-9_-]+)*$ ]]; }
cfip_openclash_capture_backup_context(){
    if cfip_openclash_capture_runtime; then
        cfip_openclash_resolve_provider_target
        return $?
    fi
    local enabled config
    enabled="$(uci -q get openclash.config.enable 2>/dev/null)" || enabled=""
    [[ "$enabled" == 0 ]] || { CFIP_OPENCLASH_SERVICE_ERROR="OpenClash runtime identity unavailable"; return 1; }
    config="$(uci -q get openclash.config.config_path 2>/dev/null)" || config=""
    cfip_managed_openclash_config_safe "$config" || { CFIP_OPENCLASH_SERVICE_ERROR="disabled OpenClash main config path is unavailable or unsafe"; return 1; }
    CFIP_OPENCLASH_RUNTIME_CONFIG="$config"; CFIP_OPENCLASH_RUNTIME_ID=""
    cfip_openclash_resolve_provider_target
}
cmd_oc_list_backups(){
    load_config aux >/dev/null || return 1
    if ! cfip_openclash_capture_backup_context; then
        # Listing is read-only and must stay usable before OpenClash is
        # configured. With OpenClash disabled there is no captured provider
        # target, so there is nothing to enumerate yet.
        local enabled
        enabled="$(uci -q get openclash.config.enable 2>/dev/null)" || enabled=""
        if [[ "$enabled" != 1 ]]; then
            jq -cn '{success:true,backups:[]}'
            return 0
        fi
        cfip_json_error "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash file provider unavailable}"
        return 1
    fi
    local config="$CFIP_OPENCLASH_TARGET_CONFIG" file id size timestamp
    local -a backups=()
    shopt -s nullglob
    for file in "$config".bak.*; do
        [ -f "$file" ] || continue
        id="${file#${config}.bak.}"; backup_id_valid "$id" || continue
        size="$(wc -c <"$file" 2>/dev/null || printf 0)"
        timestamp="$(date -r "$file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '%s' "$id")"
        backups+=("$(jq -cn --arg id "$id" --arg file "$file" --arg timestamp "$timestamp" --argjson size "$size" '{id:$id,file:$file,timestamp:$timestamp,size:$size}')")
    done
    shopt -u nullglob
    if ((${#backups[@]})); then
        printf '%s\n' "${backups[@]}" | jq -s --arg config "$config" '{success:true,config:$config,backups:sort_by(.timestamp)|reverse}'
    else
        jq -cn --arg config "$config" '{success:true,config:$config,backups:[]}'
    fi
}
cmd_oc_restore_backup(){
    load_config aux >/dev/null || return 1
    cfip_openclash_capture_backup_context || { cfip_json_error "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash file provider unavailable}"; return 1; }
    local id="${1:-}" config="$CFIP_OPENCLASH_TARGET_CONFIG" backup pre file
    backup_id_valid "$id" || { cfip_json_error "invalid backup id"; return 1; }
    backup="$config.bak.$id"
    if [ ! -f "$backup" ]; then
        backup=""
        shopt -s nullglob
        for file in "$config.bak.$id".*; do [ -f "$file" ] && { backup="$file"; break; }; done
        shopt -u nullglob
    fi
    [ -n "$backup" ] && [ -f "$backup" ] || { cfip_json_error "backup not found: $id"; return 1; }
    [ -f "$config" ] || { cfip_json_error "OpenClash config not found"; return 1; }
    if ! cfip_openclash_provider_document_valid "$backup" || ! cfip_openclash_provider_expected_names "$backup" >/dev/null; then
        cfip_json_error "backup is not a provider-only document; legacy whole-config backups cannot be restored through the provider API"
        return 1
    fi
    CFIP_MODE=openclash; CFIP_RUN_ID="$(cfip_generate_run_id)"; CFIP_SPEEDTEST_COMPLETED=false
    cfip_txn_prepare openclash || { cfip_json_error "${CFIP_RECOVERY_ERROR:-${CFIP_OPENCLASH_SERVICE_ERROR:-failed to snapshot OpenClash config}}"; return 1; }
    cfip_openclash_check_before_write || { sync_recovery_failure "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash state changed}"; return 1; }
    if ! cfip_txn_publish_openclash "$backup" pre-restore; then
        sync_recovery_failure "${CFIP_OPENCLASH_SERVICE_ERROR:-failed to stage and publish restored config}"; return 1
    fi
    pre="$CFIP_TXN_BACKUP_FILE"
    if [[ "$CFIP_OPENCLASH_EXPECTED_ENABLED" == 1 && "$CFIP_OPENCLASH_DEFERRED" != true ]]; then
        if ! cfip_openclash_provider_refresh; then
            cfip_txn_rollback openclash >/dev/null 2>&1 || true
            cfip_json_error "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash backup hot refresh failed; rollback was attempted without restart}"
            return 1
        fi
        CFIP_OPENCLASH_SERVICE_APPLIED=true
    fi
    cfip_txn_commit || { sync_recovery_failure "backup restore commit failed"; return 1; }
    jq -cn --arg restored "$backup" --arg pre "$pre" --argjson deferred "$CFIP_OPENCLASH_DEFERRED" --argjson applied "$CFIP_OPENCLASH_SERVICE_APPLIED" '{success:true,restored_from:$restored,pre_restore_backup:$pre,nodeFileWritten:true,serviceApplied:$applied,deferredUntilServiceStart:$deferred,last_result:(if $deferred then "warning" else "success" end),warning:(if $deferred then "Nodes updated; OpenClash is disabled and the changes will take effect after it is started" else null end)}'
}
cmd_oc_delete_backup(){
    load_config aux >/dev/null || return 1
    cfip_openclash_capture_backup_context || { cfip_json_error "${CFIP_OPENCLASH_SERVICE_ERROR:-OpenClash file provider unavailable}"; return 1; }
    local id="${1:-}" config="$CFIP_OPENCLASH_TARGET_CONFIG" file
    backup_id_valid "$id" || { cfip_json_error "invalid backup id"; return 1; }
    local found=false
    shopt -s nullglob
    for file in "$config.bak.$id" "$config.bak.$id".*; do
        [ -f "$file" ] || continue
        found=true
        rm -f "$file" || { shopt -u nullglob; cfip_json_error "failed to delete backup"; return 1; }
    done
    shopt -u nullglob
    [ "$found" = true ] || { cfip_json_error "backup not found: $id"; return 1; }
    jq -cn --arg id "$id" '{success:true,deleted:$id}'
}
cmd_source_refresh(){ load_config aux >/dev/null || return 1; CFIP_RUN_ID="$(cfip_generate_run_id)"; local d="$CFIP_RUNTIME_DIR/source-refresh-$CFIP_RUN_ID"; mkdir -p "$d"; CFIP_INPUT_POOL_FILE="$d/input-pool.json"; CFIP_CANDIDATE_INPUT_FILE="$d/cfst-input.txt"; CFIP_SOURCE_STATUS_FILE="$CFIP_RUNTIME_DIR/source-status.json"; cfip_prepare_candidate_pool "$CFIP_INPUT_POOL_FILE" "$CFIP_CANDIDATE_INPUT_FILE" "$CFIP_SOURCE_STATUS_FILE" || { cfip_json_error "no candidate IPs available"; rm -rf "$d"; return 1; }; jq -cn --argjson count "$(jq 'length' "$CFIP_INPUT_POOL_FILE")" --argjson sources "$(cat "$CFIP_SOURCE_STATUS_FILE")" '{success:true,candidate_count:$count,sources:$sources}'; rm -rf "$d"; }
cmd_self_update(){ jq -cn '{success:false,error:"deprecated",message:"2.x application code is package-managed; upgrade via IPK/APK release"}'; return 1; }
cmd_validate_config(){
    local candidate="${1:-}"
    if [[ -n "$candidate" ]] && ! jq -e 'type == "object"' <<<"$candidate" >/dev/null 2>&1; then
        cfip_json_error "invalid staged candidate"
        return 1
    fi
    CFIP_VALIDATE_CANDIDATE_JSON="$candidate" load_config save && jq -cn --arg mode "$CFIP_MODE" --arg schedule "$CFIP_CRON_INTERVAL" '{success:true,valid:true,mode:$mode,cron_interval:$schedule}'
}
cmd_sync(){
    local mode="$1" txrc=0 restart_count=0
    load_config >/dev/null || return 1
    [[ "$mode" == passwall || "$mode" == passwall2 || "$mode" == openclash || "$mode" == homeproxy ]] || { cfip_json_error "invalid sync target"; return 1; }
    CFIP_MODE="$mode"
    case "$mode" in
      passwall) CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_PASSWALL_TARGET_DOMAIN")" || { cfip_json_error "invalid PassWall target_domain"; return 1; } ;;
      openclash) CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" || { cfip_json_error "invalid OpenClash target_domain"; return 1; }; restart_count=0 ;;
      homeproxy) CFIP_TARGET_DOMAINS="$(cfip_homeproxy_normalize_domain "$CFIP_HOMEPROXY_TARGET_DOMAIN")" || { cfip_json_error "invalid HomeProxy target_domain"; return 1; } ;;
      passwall2) CFIP_TARGET_DOMAINS="$(cfip_pw2_normalize_target "$CFIP_PASSWALL2_TARGET_DOMAIN")" || { cfip_json_error "invalid PassWall2 target_domain"; return 1; } ;;
    esac
    [[ -f "$CFIP_STATUS_FILE" ]] || { cfip_json_error "no status"; return 1; }
    init_run_paths
    jq '[.best_ips[]?|{ip:.,family:(if contains(":") then "ipv6" else "ipv4" end)}]' "$CFIP_STATUS_FILE" >"$CFIP_SELECTED_FILE"
    CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"; CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT))
    cfip_txn_prepare "$mode" || { cfip_json_error "${CFIP_RECOVERY_ERROR:-${CFIP_OPENCLASH_SERVICE_ERROR:-failed to snapshot proxy configuration}}"; return 1; }
    cfip_txn_apply "$mode" "$CFIP_SELECTED_FILE" || txrc=$?
    if ((txrc!=0)); then CFIP_STOPPED_MODE=""; jq -cn --argjson rc "$txrc" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" --arg recovery "${CFIP_RECOVERY_ERROR:-}" '{success:false,error:"sync transaction failed",rc:$rc,rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi
    CFIP_STOPPED_MODE=""
    if [[ "$mode" != passwall && "$mode" != passwall2 && "$mode" != homeproxy ]] && ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync post-apply validation failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi
    if [[ "$mode" == passwall ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"passwall_runtime_apply_unverified"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    if [[ "$mode" == homeproxy ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"homeproxy_apply_pending"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    if [[ "$mode" == passwall2 ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"passwall2_apply_pending"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    CFIP_MEASUREMENT_DEADLINE=0
    if ! cfip_txn_commit; then cfip_txn_rollback "$mode" >/dev/null 2>&1 || true; jq -cn --arg recovery "${CFIP_RECOVERY_ERROR:-}" --argjson rolledBack "${CFIP_TXN_ROLLED_BACK:-false}" '{success:false,error:"sync transaction commit failed",rolledBack:$rolledBack,recoveryVerified:($recovery=="")}' ; return 1; fi
    if [[ "$mode" == passwall ]]; then
        jq -cn --arg mode "$mode" '{success:true,synced:$mode,configurationPersisted:true,serviceApplied:false,applyPending:true,last_result:"warning",warning:"PassWall has no verified hot-apply path; the running service was not restarted",restartCount:0}'
    elif [[ "$mode" == passwall2 ]]; then
        jq -cn --arg mode "$mode" --arg node "$CFIP_PW2_TARGET_NODE" --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{success:true,synced:$mode,configurationPersisted:true,serviceApplied:false,applyPending:true,updatedNodeCount:1,updatedNode:$node,appliedCandidate:$ip,runtimeEgressVerified:false,last_result:"warning",warning:"Only the top candidate was persisted to one active PassWall2 graph leaf; the service was not reloaded or restarted",restartCount:0}'
    elif [[ "$mode" == homeproxy ]]; then
        jq -cn --arg mode "$mode" --arg section "$CFIP_HOMEPROXY_NODE_SECTION" --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{success:true,synced:$mode,configurationPersisted:true,serviceApplied:false,applyPending:true,updatedNodeCount:1,updatedNode:$section,appliedCandidate:$ip,runtimeEgressVerified:false,last_result:"warning",warning:"Only the active HomeProxy main node was updated to the top candidate; the service was not changed",restartCount:0}'
    elif [[ "$CFIP_OPENCLASH_DEFERRED" == true ]]; then
        jq -cn --arg mode "$mode" '{success:true,synced:$mode,configurationPersisted:true,serviceApplied:false,applyPending:true,applicationMethod:"deferred_until_service_start",last_result:"warning",warning:"OpenClash is disabled; provider changes take effect when it starts",restartCount:0}'
    else
        jq -cn --arg mode "$mode" --argjson applied "${CFIP_OPENCLASH_SERVICE_APPLIED:-false}" --argjson hot "${CFIP_OPENCLASH_HOT_APPLIED:-false}" --argjson restarts "$restart_count" '{success:true,synced:$mode,serviceApplied:$applied,hotApplied:$hot,maintenanceRestarted:false,applicationMethod:(if $hot then "file_provider_put" else "none" end),health:"validated",restartCount:$restarts}'
    fi
}
cmd_sync_explicit(){
    local mode="$1" external_selected="${2:-}" txrc=0
    CFIP_SPEEDTEST_COMPLETED=false; CFIP_OPENCLASH_EXPECTED_ENABLED=""; CFIP_OPENCLASH_INITIAL_RUNNING=false; CFIP_OPENCLASH_INITIAL_HEALTHY=false; CFIP_OPENCLASH_DEFERRED=false; CFIP_OPENCLASH_CF_STOPPED=false; CFIP_OPENCLASH_RECOVERY_ATTEMPTED=false; CFIP_OPENCLASH_RECOVERY_VERIFIED=false; CFIP_OPENCLASH_RESTART_ATTEMPTS=0; CFIP_OPENCLASH_FILE_WRITTEN=false; CFIP_OPENCLASH_SERVICE_APPLIED=false; CFIP_OPENCLASH_HOT_APPLIED=false; CFIP_OPENCLASH_MAINTENANCE_RESTARTED=false; CFIP_OPENCLASH_SERVICE_ERROR=""; CFIP_RECOVERY_ERROR=""
    load_config >/dev/null || return 1
    [[ "$mode" == passwall || "$mode" == passwall2 || "$mode" == openclash || "$mode" == homeproxy ]] || { cfip_json_error "invalid sync target"; return 1; }
    [[ -n "$external_selected" || -f "$CFIP_STATUS_FILE" ]] || { cfip_json_error "no status"; return 1; }
    CFIP_MODE="$mode"
    case "$mode" in
      passwall) CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_PASSWALL_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty PassWall target_domain"; return 1; } ;;
      openclash) [[ -f "$CFIP_OPENCLASH_CONFIG" ]] || { cfip_json_error "OpenClash config not found"; return 1; }; CFIP_TARGET_DOMAINS="$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" || { cfip_json_error "invalid or empty OpenClash target_domain"; return 1; } ;;
      homeproxy) CFIP_TARGET_DOMAINS="$(cfip_homeproxy_normalize_domain "$CFIP_HOMEPROXY_TARGET_DOMAIN")" || { cfip_json_error "invalid HomeProxy target_domain"; return 1; } ;;
      passwall2) CFIP_TARGET_DOMAINS="$(cfip_pw2_normalize_target "$CFIP_PASSWALL2_TARGET_DOMAIN")" || { cfip_json_error "invalid PassWall2 target_domain"; return 1; } ;;
    esac
    init_run_paths
    if [[ -n "$external_selected" ]]; then
        [[ "$mode" == openclash && -f "$external_selected" && ! -L "$external_selected" ]] || { cfip_json_error "invalid external OpenClash selection"; return 1; }
        jq -e 'type=="array" and length>0 and length<=64 and all(.[]; type=="object" and (.ip|type)=="string" and (.family=="ipv4" or .family=="ipv6") and .family==(if (.ip|contains(":")) then "ipv6" else "ipv4" end)) and ([.[].ip]|unique|length)==length' "$external_selected" >/dev/null 2>&1 || { cfip_json_error "external selection is malformed or contains duplicate candidates"; return 1; }
        while IFS= read -r ip; do cfip_ip_family "$ip" >/dev/null || { cfip_json_error "external selection contains an invalid IP"; return 1; }; done < <(jq -r '.[].ip' "$external_selected")
        cp "$external_selected" "$CFIP_SELECTED_FILE" || { cfip_json_error "failed to snapshot external OpenClash selection"; return 1; }
    else
        jq '[.best_ips[]?|{ip:.,family:(if contains(":") then "ipv6" else "ipv4" end)}]' "$CFIP_STATUS_FILE" >"$CFIP_SELECTED_FILE"
    fi
    CFIP_MEASUREMENT_STARTED_AT="$(cfip_monotonic_seconds)"; CFIP_MEASUREMENT_DEADLINE=$((CFIP_MEASUREMENT_STARTED_AT+CFIP_MEASUREMENT_TIMEOUT))
    cfip_txn_prepare "$mode" || { cfip_json_error "${CFIP_RECOVERY_ERROR:-${CFIP_OPENCLASH_SERVICE_ERROR:-failed to snapshot proxy configuration}}"; return 1; }
    if [[ -n "$external_selected" ]]; then
        [[ "$CFIP_OPENCLASH_RUNTIME_CONFIG" == "$CFIP_BRIDGE_EXPECTED_CONFIG" ]] || { CFIP_OPENCLASH_SERVICE_ERROR="active OpenClash config does not match the standalone script config"; sync_recovery_failure "$CFIP_OPENCLASH_SERVICE_ERROR"; return 1; }
    fi
    if [[ "$mode" == openclash ]]; then
        CFIP_OPENCLASH_RESTART_ATTEMPTS=0
    fi
    cfip_txn_apply "$mode" "$CFIP_SELECTED_FILE" || txrc=$?
    if ((txrc!=0)); then sync_recovery_failure "sync transaction failed (rc=$txrc)"; return 1; fi
    CFIP_STOPPED_MODE=""
    if [[ "$mode" != passwall && "$mode" != passwall2 && "$mode" != homeproxy ]] && ! cfip_post_apply_probe "$CFIP_SELECTED_FILE" "$CFIP_TARGET_DOMAINS" "$CFIP_PROBE_TIMEOUT" "$CFIP_OUTCOME_FILE"; then sync_recovery_failure "sync post-apply validation failed"; return 1; fi
    if [[ "$mode" == passwall ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"passwall_runtime_apply_unverified"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    if [[ "$mode" == homeproxy ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"homeproxy_apply_pending"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    if [[ "$mode" == passwall2 ]]; then jq -cn '{schemaVersion:2,candidateOutcome:"unknown",hostOutcome:"unknown",censored:true,reason:"passwall2_apply_pending"}' | cfip_atomic_write "$CFIP_OUTCOME_FILE" || true; fi
    CFIP_MEASUREMENT_DEADLINE=0
    if ! cfip_txn_commit; then sync_recovery_failure "sync transaction commit failed"; return 1; fi
    if [[ "$mode" == openclash && "$CFIP_OPENCLASH_DEFERRED" == true ]]; then
        jq -cn --arg message "Nodes updated; OpenClash is disabled and the changes will take effect after it is started" --argjson best "$(jq '[.[].ip]' "$CFIP_SELECTED_FILE")" '{success:true,synced:"openclash",speedtestCompleted:false,nodeFileWritten:true,serviceApplied:false,hotApplied:false,maintenanceRestarted:false,applicationMethod:"deferred_until_service_start",serviceState:"disabled_pending",best_ips:$best,last_result:"warning",warning:$message,restartCount:0}'
    elif [[ "$mode" == openclash ]]; then
        jq -cn --arg mode "$mode" --argjson applied "${CFIP_OPENCLASH_SERVICE_APPLIED:-true}" --argjson hot "${CFIP_OPENCLASH_HOT_APPLIED:-false}" --argjson deferred "${CFIP_OPENCLASH_DEFERRED:-false}" --argjson fileWritten "${CFIP_OPENCLASH_FILE_WRITTEN:-true}" --argjson restarts "${CFIP_OPENCLASH_RESTART_ATTEMPTS:-0}" '{success:true,synced:$mode,speedtestCompleted:false,nodeFileWritten:$fileWritten,serviceApplied:($applied and $fileWritten),hotApplied:$hot,maintenanceRestarted:false,applicationMethod:(if $deferred then "deferred_until_service_start" elif $hot then "file_provider_put" else "none" end),serviceState:(if $deferred then "disabled_pending" else "running_verified" end),health:"validated",last_result:(if $deferred then "warning" else "success" end),restartCount:$restarts}'
    elif [[ "$mode" == homeproxy ]]; then
        jq -cn --arg mode "$mode" --arg section "$CFIP_HOMEPROXY_NODE_SECTION" --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{success:true,synced:$mode,speedtestCompleted:false,configurationPersisted:true,serviceApplied:false,applyPending:true,updatedNodeCount:1,updatedNode:$section,appliedCandidate:$ip,runtimeEgressVerified:false,last_result:"warning",warning:"Only the active HomeProxy main node was updated to the top candidate; the service was not changed",restartCount:0}'
    elif [[ "$mode" == passwall2 ]]; then
        jq -cn --arg mode "$mode" --arg node "$CFIP_PW2_TARGET_NODE" --arg ip "$(jq -r '.[0].ip // empty' "$CFIP_SELECTED_FILE")" '{success:true,synced:$mode,speedtestCompleted:false,configurationPersisted:true,serviceApplied:false,applyPending:true,updatedNodeCount:1,updatedNode:$node,appliedCandidate:$ip,runtimeEgressVerified:false,last_result:"warning",warning:"Only the top candidate was persisted to one active PassWall2 graph leaf; the service was not reloaded or restarted",restartCount:0}'
    else
        jq -cn --arg mode "$mode" '{success:true,synced:$mode,configurationPersisted:true,serviceApplied:false,applyPending:true,last_result:"warning",warning:"PassWall has no verified hot-apply path; the running service was not restarted",restartCount:0}'
    fi
}
cmd_apply_selected_bridge(){
    local selected="$1" mode="$2" expected_config="$3" expected_domains="$4" expected_suffix="$5" expected_transport="$6" domains
    [[ "$mode" == openclash && "$expected_config" == /* && -f "$expected_config" && ! -L "$expected_config" ]] || { cfip_json_error "invalid standalone OpenClash bridge context"; return 1; }
    [[ -f "$selected" && ! -L "$selected" ]] || { cfip_json_error "invalid external OpenClash selection"; return 1; }
    jq -e 'type=="array" and length>0 and length<=64 and all(.[]; type=="object" and (.ip|type)=="string" and (.family=="ipv4" or .family=="ipv6") and .family==(if (.ip|contains(":")) then "ipv6" else "ipv4" end)) and ([.[].ip]|unique|length)==length' "$selected" >/dev/null 2>&1 || { cfip_json_error "external selection is malformed or contains duplicate candidates"; return 1; }
    load_config >/dev/null || return 1
    domains="$(cfip_normalize_domain_list "$expected_domains")" || { cfip_json_error "invalid standalone OpenClash target domain"; return 1; }
    [[ "$domains" == "$(cfip_normalize_domain_list "$CFIP_OPENCLASH_TARGET_DOMAIN")" ]] || { cfip_json_error "standalone and packaged OpenClash target domains differ"; return 1; }
    [[ "$expected_suffix" == "$CFIP_OPENCLASH_NAME_SUFFIX" ]] || { cfip_json_error "standalone and packaged OpenClash name suffixes differ"; return 1; }
    [[ "$expected_transport" == "$CFIP_OPENCLASH_TRANSPORT_FILTER" ]] || { cfip_json_error "standalone and packaged OpenClash transport filters differ"; return 1; }
    CFIP_MODE=openclash; CFIP_TARGET_DOMAINS="$domains"; CFIP_BRIDGE_EXPECTED_CONFIG="$expected_config"
    cmd_sync_explicit openclash "$selected"
}

cmd_refresh_env(){ [[ -x "$CFIP_LEGACY_BIN" ]] && "$CFIP_LEGACY_BIN" --refresh-env || cmd_check_env; }
cmd_write_status(){
    load_config aux >/dev/null || return 1
    local previous='{}' latest_history='{}' last_success='{}' current
    if [[ -s "$CFIP_STATUS_FILE" ]]; then
        previous="$(jq -ce 'select(type=="object")' "$CFIP_STATUS_FILE" 2>/dev/null || printf '{}')"
    fi
    if [[ -s "$CFIP_RUN_HISTORY" ]]; then
        latest_history="$(tail -n 100 "$CFIP_RUN_HISTORY" 2>/dev/null | jq -cs '[.[] | select(type=="object" and (.runId|type)=="string" and (.result|type)=="string")][-1] // {}' 2>/dev/null || printf '{}')"
        last_success="$(tail -n 100 "$CFIP_RUN_HISTORY" 2>/dev/null | jq -cs '[.[] | select(type=="object" and .result=="success" and (.bestIps|type)=="array" and (.bestIps|length)>0)][-1] // {}' 2>/dev/null || printf '{}')"
    fi

    CFIP_RUN_ID=""
    write_status false scheduled scheduled "" || return $?
    current="$(cat "$CFIP_STATUS_FILE" 2>/dev/null || printf '{}')"
    jq -cn --argjson current "$current" --argjson previous "$previous" \
        --argjson latest "$latest_history" --argjson lastSuccess "$last_success" '
      def terminal_status:
        type=="object" and .active_run!=true and .jobRunning!=true and
        (.last_completed_run_at!=null) and
        (.last_result!=null and .last_result!="scheduled" and .last_result!="running" and .last_result!="unknown");
      ($previous|terminal_status) as $hasPrevious |
      (if $hasPrevious then $previous.last_result else ($latest.result // $current.last_result) end) as $lastResult |
      (if $hasPrevious and ($previous.best_ips|type)=="array" and ($previous.best_ips|length)>0 then $previous.best_ips
       elif ($lastSuccess.bestIps|type)=="array" and ($lastSuccess.bestIps|length)>0 then $lastSuccess.bestIps
       else $current.best_ips end) as $best |
      $current + {
        last_result:$lastResult,
        best_ips:$best,
        ip_count:(if ($best|type)=="array" and ($best|length)>0 then ($best|length) else ($previous.ip_count // $current.ip_count) end),
        eligible_count:(if ($previous|terminal_status) and (($previous.eligible_count // 0)>0) then $previous.eligible_count else ($best|length) end),
        runId:(if $hasPrevious then ($previous.runId // "") else ($latest.runId // $current.runId) end),
        error:(if $hasPrevious then ($previous.error // null) else null end)
      }' | cfip_atomic_write "$CFIP_STATUS_FILE"
}
cmd_mark_stopped(){
    local status='{}'
    if [[ -s "$CFIP_STATUS_FILE" ]]; then
        status="$(jq -ce 'type=="object"' "$CFIP_STATUS_FILE" >/dev/null 2>&1 && cat "$CFIP_STATUS_FILE")" || { cfip_json_error "status file is corrupt; refusing to mark service stopped"; return 1; }
        jq '. + {enabled:false,running:false,scheduled:false,disabled:true,jobRunning:(.active_run==true),status_updated_at:(now|todateiso8601)}' <<<"$status" | cfip_atomic_write "$CFIP_STATUS_FILE" || { cfip_json_error "failed to write stopped status"; return 1; }
    else
        jq -cn '{schemaVersion:2,enabled:false,running:false,scheduled:false,disabled:true,active_run:false,jobRunning:false,phase:"idle",last_result:"unknown",error:null,status_updated_at:(now|todateiso8601)}' | cfip_atomic_write "$CFIP_STATUS_FILE" || { cfip_json_error "failed to create stopped status"; return 1; }
    fi
    jq -cn --argjson jobRunning "$(jq -r '.jobRunning' "$CFIP_STATUS_FILE")" '{success:true,running:false,scheduled:false,jobRunning:$jobRunning}'
}
cmd_adaptive_status(){ load_config aux >/dev/null || return 1; CFIP_ADAPTIVE_READONLY=true; jq -cn --argjson adaptive "$(cfip_adaptive_status_json)" '{success:true,adaptiveMeasurement:$adaptive}'; }

to_cron(){
    local interval="${1:-}" custom="${2:-}" value minutes hours
    [[ "$interval" == custom ]] && interval="$custom"
    [[ -n "$interval" ]] || return 1
    case "$interval" in
        15m) printf '*/15 * * * *\n'; return 0 ;;
        30m) printf '*/30 * * * *\n'; return 0 ;;
        1h) printf '0 * * * *\n'; return 0 ;;
        6h) printf '0 */6 * * *\n'; return 0 ;;
    esac
    if [[ "$interval" =~ ^([1-9][0-9]*)m$ ]]; then
        minutes="${BASH_REMATCH[1]}"
        ((minutes <= 60 && 60 % minutes == 0)) || return 1
        printf '*/%s * * * *\n' "$minutes"; return 0
    fi
    if [[ "$interval" =~ ^([1-9][0-9]*)h$ ]]; then
        hours="${BASH_REMATCH[1]}"
        ((hours <= 24 && 24 % hours == 0)) || return 1
        printf '0 */%s * * *\n' "$hours"; return 0
    fi
    cfip_valid_cron "$interval" || return 1
    printf '%s\n' "$interval"
}

usage(){ cat <<'EOF_U'
Usage: cf-ip-auto [--run|--status|--check-env|--validate-config|--version|--read-log|--clear-log|--ip-history|--download-cfst|--source-status|--source-registry|--source-refresh|--publisher-status|--adaptive-status|--rill-self-check|--rill-diagnostics|--rill-reset [GENERATION]|--self-update|--sync MODE|--apply-selected FILE openclash CONFIG DOMAIN SUFFIX TRANSPORT|--write-status|--mark-stopped|--to-cron INTERVAL [CUSTOM]]
EOF_U
}

cmd_sync(){ run_locked_entry true cmd_sync_explicit "$@"; }

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == "--apply-selected" ]]; then
        shift
        if (($# != 6)); then cfip_json_error "--apply-selected requires FILE MODE CONFIG DOMAIN SUFFIX TRANSPORT"; exit 2; fi
        run_locked_entry true cmd_apply_selected_bridge "$@"
        exit $?
    fi
    action=""; arg=""; arg2=""; no_delay=false
    while (($#)); do case "$1" in --run) action=run ;; --status) action=status ;; --check-env) action=check-env ;; --refresh-env) action=refresh-env ;; --validate-config) action=validate-config; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --version) action=version ;; --read-log) action=read-log ;; --clear-log) action=clear-log ;; --ip-history) action=ip-history ;; --download-cfst) action=download-cfst ;; --source-status) action=source-status ;; --source-registry) action=source-registry ;; --source-refresh) action=source-refresh ;; --publisher-status) action=publisher-status ;; --adaptive-status) action=adaptive-status ;; --rill-self-check) action=rill-self-check ;; --rill-diagnostics) action=rill-diagnostics ;; --rill-reset) action=rill-reset; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --self-update) action=self-update ;; --oc-list-backups) action=oc-list-backups ;; --oc-restore-backup) action=oc-restore-backup; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --oc-delete-backup) action=oc-delete-backup; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --write-status) action=write-status ;; --write-status-held) action=write-status-held ;; --mark-stopped) action=mark-stopped ;; --mark-stopped-held) action=mark-stopped-held ;; --no-delay) no_delay=true ;; --sync) action=sync; if (($# > 1)); then shift; arg="${1:-}"; fi ;; --to-cron) action=to-cron; if (($# > 1)); then shift; arg="${1:-}"; fi; if (($# > 1)); then shift; arg2="${1:-}"; fi ;; -h|--help) usage; exit 0 ;; *) cfip_json_error "unexpected argument: $1"; exit 2 ;; esac; shift; done
    [[ "$no_delay" == true ]] && CFIP_SKIP_STARTUP_DELAY=true
    case "$action" in run|'') run_v2 ;; status) cmd_status ;; check-env) cmd_check_env ;; refresh-env) run_locked_entry false cmd_refresh_env ;; validate-config) cmd_validate_config "$arg" ;; version) cmd_version ;; read-log) cfip_read_log_json ;; clear-log) run_locked_entry false cmd_clear_log ;; ip-history) cmd_ip_history ;; download-cfst) run_locked_entry false cmd_download_cfst ;; source-status) cmd_source_status ;; source-registry) cmd_source_registry ;; source-refresh) run_locked_entry false cmd_source_refresh ;; publisher-status) cmd_publisher_status ;; adaptive-status) cmd_adaptive_status ;; rill-self-check) cmd_rill_self_check ;; rill-diagnostics) cmd_rill_diagnostics ;; rill-reset) run_locked_entry false cmd_rill_reset "$arg" ;; self-update) cmd_self_update ;; oc-list-backups) cmd_oc_list_backups "$arg" ;; oc-restore-backup) run_locked_entry false cmd_oc_restore_backup "$arg" ;; oc-delete-backup) run_locked_entry false cmd_oc_delete_backup "$arg" ;; sync) cmd_sync "$arg" ;; write-status) run_locked_entry false cmd_write_status ;; write-status-held) cmd_write_status ;; mark-stopped) run_locked_entry false cmd_mark_stopped ;; mark-stopped-held) cmd_mark_stopped ;; to-cron) to_cron "$arg" "$arg2" ;; *) usage; exit 2 ;; esac
fi
