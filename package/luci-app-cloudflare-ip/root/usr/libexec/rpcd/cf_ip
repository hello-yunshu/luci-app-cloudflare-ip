#!/bin/sh

RPCD_VERSION="@PKG_VERSION@"
RPCD_PACKAGE_VERSION="@PKG_FULL_VERSION@"
RPCD_PACKAGE_RELEASE="@PKG_RELEASE@"
CF_IP_AUTO_BIN="${CF_IP_AUTO_BIN:-/usr/bin/cf-ip-auto}"
INIT_SCRIPT="${INIT_SCRIPT:-/etc/init.d/cf_ip}"
CF_IP_RUNTIME_DIR="${CF_IP_RUNTIME_DIR:-/tmp/cf_ip}"

# Keep valid failure details, but never turn a failing backend into RPC success.
command_result() {
	_result_rc=0
	_result_json="$("$CF_IP_AUTO_BIN" "$@" 2>/dev/null)" || _result_rc=$?
	if _result_json="$(printf '%s\n' "$_result_json" | jq -ces 'if length==1 and (.[0]|type)=="object" then .[0] else error("one result object required") end' 2>/dev/null)"; then
		if [ "$_result_rc" -ne 0 ]; then
			printf '%s\n' "$_result_json" | jq -c --argjson rc "$_result_rc" '.success=false | . + {error:(.error // "cf-ip-auto command failed"),rc:$rc}'
		else
			printf '%s\n' "$_result_json"
		fi
	else
		[ "$_result_rc" -ne 0 ] || _result_rc=1
		printf '{"success":false,"error":"cf-ip-auto returned no valid result","rc":%s}\n' "$_result_rc"
	fi
}

service_running_state() {
	case "$(uci -q get cf_ip.main.enabled 2>/dev/null)" in
		1|on|true|enabled)
			if [ -f /etc/cf_ip/status.json ] && grep -q '"running"[[:space:]]*:[[:space:]]*true' /etc/cf_ip/status.json 2>/dev/null; then
				return 0
			fi
			;;
	esac
	return 1
}

cf_ip_rpc_lock_acquire() {
	mkdir -p "$CF_IP_RUNTIME_DIR" || return 1
	mkdir "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock" 2>/dev/null || return 1
	printf '%s\n' "$$" >"$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid"
}

cf_ip_rpc_lock_release() {
	[ "$(cat "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid" 2>/dev/null)" = "$$" ] || return 0
	rm -f "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid"
	rmdir "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock" 2>/dev/null || true
}

service_action_unlocked() {
	action="$1"

	case "$action" in
		start|restart) _enabled=1 ;;
		stop) _enabled=0 ;;
		*) echo '{"success":false,"error":"unknown_action"}'; return 0 ;;
	esac
	uci set "cf_ip.main.enabled=$_enabled" 2>/dev/null; _rc=$?
	if [ "$_rc" -ne 0 ]; then
		printf '{"success":false,"action":"%s","error":"uci_set_failed","rc":%d}\n' "$action" "$_rc"
		return 0
	fi
	uci commit cf_ip 2>/dev/null; _rc=$?
	if [ "$_rc" -ne 0 ]; then
		printf '{"success":false,"action":"%s","error":"uci_commit_failed","rc":%d}\n' "$action" "$_rc"
		return 0
	fi
	case "$action" in
		start|restart)
			"$INIT_SCRIPT" enable >/dev/null 2>&1; _rc=$?
			if [ "$_rc" -ne 0 ]; then
				printf '{"success":false,"action":"%s","error":"init_enable_failed","rc":%d}\n' "$action" "$_rc"
				return 0
			fi
			;;
	esac

	case "$action" in
		start)
		CF_IP_LOCK_HELD=1 "$INIT_SCRIPT" start >/dev/null 2>&1
			;;
		stop)
		CF_IP_LOCK_HELD=1 "$INIT_SCRIPT" stop >/dev/null 2>&1
			;;
		restart)
		CF_IP_LOCK_HELD=1 "$INIT_SCRIPT" restart >/dev/null 2>&1
			;;
		*)
			echo '{"success":false,"error":"unknown_action"}'
			return 0
			;;
	esac

	_rc=$?
	if [ "$_rc" -ne 0 ]; then
		printf '{"success":false,"action":"%s","error":"init_action_failed","rc":%d}\n' "$action" "$_rc"
		return 0
	fi

	_wait=0
	while [ "$_wait" -lt 4 ]; do
		if [ "$action" = "stop" ]; then
			if ! service_running_state; then
				printf '{"success":true,"action":"%s","running":false}\n' "$action"
				return 0
			fi
		else
			if service_running_state; then
				printf '{"success":true,"action":"%s","running":true}\n' "$action"
				return 0
			fi
		fi
		sleep 1
		_wait=$((_wait + 1))
	done

	if [ "$action" = "stop" ]; then
		printf '{"success":false,"action":"%s","error":"service_still_running"}\n' "$action"
	else
		printf '{"success":false,"action":"%s","error":"service_not_running"}\n' "$action"
	fi
}

service_action() {
	local action="$1" rc
	cf_ip_rpc_lock_acquire || { printf '{"success":false,"action":"%s","error":"busy"}\n' "$action"; return 0; }
	trap 'cf_ip_rpc_lock_release' EXIT INT TERM
	service_action_unlocked "$action"; rc=$?
	trap - EXIT INT TERM
	cf_ip_rpc_lock_release
	return "$rc"
}

case "$1" in
	list)
		cat <<'EOF'
{
	"status": {},
		"validate-config": { "candidate": "candidate" },
	"check-env": {},
	"refresh-env": {},
	"run": {},
	"speedtest-status": {},
	"version": {},
	"read-log": {},
	"clear-log": {},
	"ip-history": {},
	"download-cfst": {},
	"source-status": {},
	"source-registry": {},
	"source-refresh": {},
	"publisher-status": {},
	"adaptive-status": {},
	"rill-self-check": {},
	"rill-diagnostics": {},
	"rill-reset": { "expectedGeneration": "expectedGeneration" },
	"self-update": {},
	"start": {},
	"stop": {},
	"restart": {},
	"sync": { "plugin": "plugin" },
	"oc-list-backups": {},
	"oc-restore-backup": { "id": "id" },
	"oc-delete-backup": { "id": "id" }
}
EOF
		;;
	call)
		method="$2"
		case "$method" in
			status|check-env|refresh-env|read-log|clear-log|ip-history|download-cfst|source-status|source-registry|source-refresh|publisher-status|adaptive-status|rill-self-check|rill-diagnostics|self-update|oc-list-backups)
				command_result "--$method"
				;;
			validate-config)
				read _input
				_candidate="$(printf '%s\n' "$_input" | jq -c '.candidate // {}' 2>/dev/null)" || _candidate='{}'
				command_result --validate-config "$_candidate"
				;;
			run)
				# Check lock before starting background speedtest
				if [ -d /tmp/cf_ip/cf-ip-auto-v2.lock ]; then
					echo '{"success":false,"error":"another instance is running"}'
				else
					# Start speedtest in background to avoid rpcd timeout
					( "$CF_IP_AUTO_BIN" --run --no-delay >/dev/null 2>&1 ) &
					echo '{"success":true,"action":"run","running":true}'
				fi
				;;
			speedtest-status)
				_status="$(command_result --status)"
				_log="$(command_result --read-log)"
				# Both branches are normalized to one object, preserving their own
				# backend failures without emitting a second top-level JSON value.
				printf '%s\n' "$_status" | jq -c --argjson log "$_log" '. + {log_data: $log}'
				;;
			version)
				printf '{"version":"%s","package_version":"%s","package_release":"%s"}\n' "$RPCD_VERSION" "$RPCD_PACKAGE_VERSION" "$RPCD_PACKAGE_RELEASE"
				;;
			rill-reset)
				read _input
				_generation="$(jsonfilter -s "$_input" -e '$.expectedGeneration' 2>/dev/null)" || true
				command_result --rill-reset "$_generation"
				;;
			start)
				service_action start
				;;
			stop)
				service_action stop
				;;
			restart)
				service_action restart
				;;
			sync)
				read _input
				_plugin="$(jsonfilter -s "$_input" -e '$.plugin' 2>/dev/null)" || true
				if [ -z "$_plugin" ]; then
					echo '{"success":false,"error":"missing plugin name"}'
				else
					command_result --sync "$_plugin"
				fi
				;;
			oc-restore-backup)
				read _input
				_backup_id="$(jsonfilter -s "$_input" -e '$.id' 2>/dev/null)" || true
				if [ -z "$_backup_id" ]; then
					echo '{"success":false,"error":"missing backup id"}'
				else
					command_result --oc-restore-backup "$_backup_id"
				fi
				;;
			oc-delete-backup)
				read _input
				_backup_id="$(jsonfilter -s "$_input" -e '$.id' 2>/dev/null)" || true
				if [ -z "$_backup_id" ]; then
					echo '{"success":false,"error":"missing backup id"}'
				else
					command_result --oc-delete-backup "$_backup_id"
				fi
				;;
			*)
				echo '{"error":"unknown_method"}'
				;;
		esac
		;;
	*)
		echo '{"error":"invalid_usage"}'
		;;
esac
