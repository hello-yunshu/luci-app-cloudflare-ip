#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

CRONTAB_FILE="/etc/crontabs/root"
CF_IP_RUNTIME_DIR="${CF_IP_RUNTIME_DIR:-/tmp/cf_ip}"

cron_ensure_newline() {
	[ -s "$CRONTAB_FILE" ] || return 0
	[ -n "$(tail -c1 "$CRONTAB_FILE")" ] && echo "" >> "$CRONTAB_FILE"
}

cf_ip_shared_lock_acquire() {
	mkdir -p "$CF_IP_RUNTIME_DIR" || return 1
	mkdir "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock" 2>/dev/null || return 1
	printf '%s\n' "$$" >"$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid"
}

cf_ip_shared_lock_release() {
	[ "$(cat "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid" 2>/dev/null)" = "$$" ] || return 0
	rm -f "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock/pid"
	rmdir "$CF_IP_RUNTIME_DIR/cf-ip-auto-v2.lock" 2>/dev/null || true
}

cf_ip_with_shared_lock() {
	[ "${CF_IP_LOCK_HELD:-0}" = 1 ] && { "$@"; return $?; }
	cf_ip_shared_lock_acquire || { logger -t cf_ip -p daemon.err "another state-changing operation is running"; return 1; }
	trap 'cf_ip_shared_lock_release' EXIT INT TERM
	"$@"; local rc=$?
	trap - EXIT INT TERM
	cf_ip_shared_lock_release
	return "$rc"
}
cf_ip_cron_ensure() {
	# Ensure cron is enabled and running
	/etc/init.d/cron enable 2>/dev/null || /etc/init.d/crond enable 2>/dev/null || true
	/etc/init.d/cron start 2>/dev/null || /etc/init.d/crond start 2>/dev/null || true
}

cf_ip_cron_add() {
	local expr="$1"
	cf_ip_cron_ensure
	cf_ip_cron_remove
	mkdir -p /etc/crontabs
	cron_ensure_newline
	printf '%s /usr/bin/cf-ip-auto --run >/dev/null 2>&1\n' \
		"$expr" >> "$CRONTAB_FILE"
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: scheduled with expression '${expr}'"
}

cf_ip_cron_remove() {
	sed -i '/cf-ip-auto --run/d' "$CRONTAB_FILE" 2>/dev/null || true
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: removed scheduled entries"
}

_start_service_unlocked() {
	local enabled cfst_persist cron_interval cron_custom startup_delay work_dir cfst_path sysupgrade_tmp first_run=0
	config_load cf_ip
	config_get_bool enabled main enabled 0

	if [ "$enabled" -eq 0 ]; then
		# Disabled must remove entries left by older package versions.
		cf_ip_cron_remove
		return 0
	fi

	if ! validate_cf_ip 2>/dev/null; then
		logger -t cf_ip -p daemon.err "Configuration validation failed, refusing to start"
		return 1
	fi
	if ! cf-ip-auto --validate-config >/dev/null 2>&1; then
		logger -t cf_ip -p daemon.err "Semantic configuration validation failed, refusing to schedule"
		return 1
	fi

	mkdir -p /etc/cf_ip /tmp/cf_ip

	# Handle CFST sysupgrade persistence
	config_get_bool cfst_persist main cfst_persist 1
	config_get work_dir main work_dir "/usr/bin"
	[ -n "$work_dir" ] || work_dir="/usr/bin"
	cfst_path="${work_dir%/}/cfst/cfst"
	if [ "$cfst_persist" -eq 1 ]; then
		mkdir -p "${cfst_path%/*}" 2>/dev/null || true
		grep -qxF "$cfst_path" /etc/sysupgrade.conf 2>/dev/null || echo "$cfst_path" >> /etc/sysupgrade.conf
	else
		if [ -f /etc/sysupgrade.conf ]; then
			sysupgrade_tmp="/etc/sysupgrade.conf.cfip.$$"
			grep -Fvx "$cfst_path" /etc/sysupgrade.conf >"$sysupgrade_tmp" 2>/dev/null && mv "$sysupgrade_tmp" /etc/sysupgrade.conf || rm -f "$sysupgrade_tmp"
		fi
	fi


	# Get schedule configuration
	config_get cron_interval main cron_interval "6h"
	config_get cron_custom main cron_custom ""
	config_get startup_delay main startup_delay ""

	# Resolve to cron expression via cf-ip-auto
	local cron_expr
	cron_expr="$(cf-ip-auto --to-cron "$cron_interval" "$cron_custom")" || {
		logger -t cf_ip -p daemon.err "crontab: failed to convert schedule to cron expression, falling back to daemon"
		# Fallback: start as traditional daemon — will be replaced on next config save
		return 1
	}

	# Schedule via crontab
	cf_ip_cron_add "$cron_expr"

	# Clean up any leftover plugin sync cron entries from older versions
	sed -i '/cf-ip-auto --sync/d' "$CRONTAB_FILE" 2>/dev/null || true
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true

	# Let cf-ip-auto apply its own startup delay so numeric and random modes stay consistent.
	case "$startup_delay" in
		""|0)
			;;
		*)
			first_run=1
			logger -t cf_ip -p daemon.info "startup: first run scheduled with delay '${startup_delay}'"
			;;
	esac

	# Write initial status for crontab-managed mode
	cf-ip-auto --write-status-held || return 1
	# These jobs acquire the same lock after the service lifecycle releases it.
	(sleep 1; /usr/bin/cf-ip-auto --download-cfst >/dev/null 2>&1) &
	[ "$first_run" -eq 1 ] && (sleep 1; /usr/bin/cf-ip-auto --run >/dev/null 2>&1) &
}

_stop_service_unlocked() {
	cf_ip_cron_remove
	/usr/bin/cf-ip-auto --mark-stopped-held
}

start_service() { cf_ip_with_shared_lock _start_service_unlocked; }
stop_service() { cf_ip_with_shared_lock _stop_service_unlocked; }
service_triggers() {
	procd_add_reload_trigger "cf_ip"
	procd_add_validation validate_cf_ip
}

reload_service() {
	restart
}

validate_cf_ip() {
	uci_validate_section cf_ip service main \
		'enabled:bool' 'mode:string' 'ip_count:uinteger' \
		'ip_type:string' 'speedtest_protocol:string' \
		'speedtest_cfcolo:string' 'speedtest_dn:uinteger' \
		'speedtest_dt:uinteger' 'speedtest_threads:uinteger' \
		'speedtest_ping_count:uinteger' \
		'speedtest_tll:uinteger' 'speedtest_tl:uinteger' 'stop_service:bool' \
		'startup_delay:string' 'auto_update:bool' \
		'self_update_url:string' 'download_retries:uinteger' \
		'download_retry_delay:uinteger' 'github_mirror:string' \
		'verbose:bool' 'work_dir:string' 'cron_interval:string' \
		'cron_custom:string' \
		'cfst_persist:bool' 'candidate_budget:uinteger' \
		'probe_top_count:uinteger' 'probe_concurrency:uinteger' \
		'probe_timeout:uinteger' 'measurement_timeout:uinteger' 'recovery_timeout:uinteger' \
		'reuse_enabled:bool' 'max_full_optimize_interval:uinteger' \
		'reuse_validation_timeout:uinteger' 'reuse_loss_limit:string' \
		'reuse_ttfb_limit:uinteger' 'reuse_total_limit:uinteger'

	uci_validate_section cf_ip passwall passwall \
		'target_domain:string' 'name_suffix:string'

	uci_validate_section cf_ip openclash openclash \
		'config:string' 'target_domain:string' \
		'name_suffix:string' 'transport_filter:string' \
		'backup_count:uinteger'

	uci_validate_section cf_ip rill rill \
		'enabled:bool' 'mode:string' 'runtime:string' \
		'state_file:string' 'timeout_ms:uinteger'

	uci_validate_section cf_ip lan lan \
		'enabled:bool' 'bind_address:string' 'port:port'
}
