#!/bin/sh /etc/rc.common
START=98
STOP=12
USE_PROCD=1

get_lan_ipv4() {
	local status
	status="$(ubus -t 1 call network.interface.lan status 2>/dev/null)" || return 1
	[ "$(printf '%s' "$status" | jsonfilter -e '@.up' 2>/dev/null)" = true ] || return 1
	printf '%s' "$status" | jsonfilter -e '@["ipv4-address"][*].address' 2>/dev/null
}

is_private_ipv4() {
	local ip="$1" old_ifs="$IFS" octet
	case "$ip" in ''|*[!0-9.]*|.*|*..*|*.) return 1 ;; esac
	IFS=.; set -- $ip; IFS="$old_ifs"
	[ "$#" -eq 4 ] || return 1
	for octet in "$@"; do
		case "$octet" in ''|0[0-9]*|????*) return 1 ;; esac
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
	case "$ip" in
		10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
		*) return 1 ;;
	esac
}

resolve_lan_bind() {
	local requested="$1" addresses address
	addresses="$(get_lan_ipv4)" || return 1
	for address in $addresses; do
		is_private_ipv4 "$address" || continue
		if [ -z "$requested" ] || [ "$requested" = "$address" ]; then
			printf '%s' "$address"
			return 0
		fi
	done
	return 1
}

_publisher_start_service() {
	local enabled bind port docroot
	config_load cf_ip
	config_get_bool enabled lan enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get bind lan bind_address ''
	config_get port lan port 12345
	bind="$(resolve_lan_bind "$bind")" || { logger -t cf_ip_publisher -p daemon.err 'refusing unavailable, invalid or non-LAN publisher bind'; return 1; }
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 1
	docroot=/tmp/cf_ip/publish
	mkdir -p "$docroot"
	[ -x /usr/sbin/uhttpd ] || { logger -t cf_ip_publisher -p daemon.err 'uhttpd missing'; return 1; }
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -p "$bind:$port" -h "$docroot" -D -S -R
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

# rc.common otherwise overwrites a rejected bind/port result when closing procd.
start_service() {
	if _publisher_start_service; then CF_IP_PUBLISHER_START_RC=0; else CF_IP_PUBLISHER_START_RC=$?; fi
	return "$CF_IP_PUBLISHER_START_RC"
}
service_started() { return "${CF_IP_PUBLISHER_START_RC:-1}"; }

service_triggers() {
	procd_add_reload_trigger cf_ip
	procd_add_interface_trigger "interface.*" lan "${initscript:-/etc/init.d/cf_ip_publisher}" reload
}
