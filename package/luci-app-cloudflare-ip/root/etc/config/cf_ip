config service 'main'
	option enabled '0'
	option mode 'passwall'
	option ip_count '4'
	option ip_type 'ipv4'
	option speedtest_protocol 'tcp'
	option speedtest_cfcolo ''
	option speedtest_dn '8'
	option speedtest_dt '6'
	option speedtest_threads '200'
	option speedtest_ping_count '3'
	option speedtest_tll '40'
	option speedtest_tl ''
	option stop_service '1'
	option startup_delay ''
	option auto_update '0'
	# Deprecated: legacy self-update is disabled; kept for migration compatibility.
	option self_update_url ''
	option download_retries '3'
	option download_retry_delay '5'
	option github_mirror ''
	option verbose '0'
	option work_dir ''
	option cron_interval '6h'
	option cron_custom ''
	option cfst_persist '1'
	option candidate_budget '128'
	option probe_top_count '8'
	option probe_concurrency '4'
	option probe_timeout '5'
	option measurement_timeout '60'
	option recovery_timeout '30'
	option probe_batch_size '4'
	option max_probe_count '8'
	option early_stop_enabled '1'
	option adaptive_measurement_enabled '1'
	option adaptive_measurement_mode 'shadow'
	option adaptive_target_ratio_percent '25'
	option adaptive_min_probe_count '8'
	option adaptive_exploration_ratio_percent '10'
	option adaptive_min_evidence '50'
	option adaptive_evidence_window '100'
	option adaptive_evaluation_max_age_seconds '604800'
	option adaptive_audit_interval '20'
	option adaptive_max_probe_count '60'
	option adaptive_expansion_batch_size '8'
	option source_policy 'balanced'
	option reuse_enabled '1'
	option max_full_optimize_interval '86400'
	option reuse_validation_timeout '5'
	option reuse_loss_limit '0.25'
	option reuse_ttfb_limit '3000'
	option reuse_total_limit '5000'
	list builtin_sources 'cloudflare-official-v4'
	list builtin_sources 'cloudflare-official-v6'

config rill 'rill'
	option enabled '0'
	option mode 'shadow'
	option runtime '/usr/bin/rill-runtime'
	option state_file '/etc/cf_ip/rill-state.json'
	option timeout_ms '2000'
	option safe_top_k '3'
	option min_feedback_samples '30'
	option delayed_feedback_minutes '10'
	option evaluation_max_age_seconds '86400'

config lan 'lan'
	option enabled '0'
	option bind_address ''
	option port '12345'

config passwall 'passwall'
	option target_domain ''
	option name_suffix ' [CF-{n}]'

config openclash 'openclash'
	option config '/etc/openclash/config/config.yaml'
	option target_domain ''
	option name_suffix ' [CF-{n}]'
	option transport_filter ''
	option backup_count '3'
